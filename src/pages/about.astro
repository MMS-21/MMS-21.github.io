---
import Base from '../layouts/Base.astro';
import { SITE, BIO_LONG } from '../data/site';
---

<Base title="About" description="About Moaaz Magdy, Data & Business Analyst in Cairo.">
  <div class="wrap">
    <div class="about-intro">
      <figure class="about-figure">
        <picture>
          <source srcset="/img/stamp.webp" type="image/webp" />
          <img
            src="/img/stamp.webp"
            width="300"
            height="407"
            alt="Vintage-style Egyptian postage stamp illustration bearing a profile portrait captioned Portrait D'MoaaZ, in cream, burgundy and sepia with arabesque ornament."
            decoding="async"
            loading="lazy"
          />
        </picture>
      </figure>

      <h1>About me</h1>
      {BIO_LONG.map((para) => <p>{para}</p>)}
    </div>

    <h2>What I work with</h2>
    <ul>
      <li><strong>Customer analytics</strong> — RFM segmentation, probabilistic CLV (BG/NBD, Gamma-Gamma), churn prediction, retention targeting</li>
      <li><strong>AI tooling</strong> — tool-calling agent loops, quality gates, model-agnostic architecture, prompt engineering from data</li>
      <li><strong>Business intelligence</strong> — Power BI, Tableau, stakeholder-facing dashboards</li>
      <li><strong>Application development</strong> — Electron, React, FastAPI, TypeScript</li>
      <li><strong>Data work</strong> — Python (pandas, scikit-learn), SQL</li>
    </ul>

    <h2>What I optimise for</h2>
    <p>
      Code that a stranger can verify. A test suite that runs without an API key.
      A prompt that reads the data instead of assuming it. Output that gets
      validated before anyone sees it, and a report that says what did not work.
    </p>

    <h2>Currently</h2>
    <p>
      Open to data analyst and AI tools engineering roles. Based in {SITE.location},
      working remotely. The best way to reach me is
      <a href={`mailto:${SITE.email}`}>email</a>.
    </p>
  </div>
</Base>

<style>
  /* Stamp on the left, prose on the right. No wrapper div around the text:
     grid areas place the figure in column 1 and every heading/paragraph in
     column 2, so the paragraphs stay direct children of .about-intro. */
  .about-intro {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    grid-template-areas:
      "figure title"
      "figure body";
    column-gap: 2.5rem;
    margin-bottom: 1rem;
  }

  .about-figure {
    grid-area: figure;
    margin: 0;
  }

  .about-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-intro > h1 {
    grid-area: title;
    margin: 0 0 0.75rem;
  }

  /* Consecutive paragraphs after the h1 form the body area. */
  .about-intro > p {
    grid-area: body;
    max-width: none;
  }

  /* A single <p> cannot share one grid area, so give each its own row. */
  .about-intro > p + p {
    grid-area: unset;
    grid-column: 2;
    margin-top: 0;
  }

  @media (max-width: 40rem) {
    .about-intro {
      grid-template-columns: 1fr;
      grid-template-areas:
        "figure"
        "title"
        "body";
      row-gap: 1.75rem;
    }

    .about-intro > p + p {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.9rem;
    }

    /* Centre the stamp once it sits above the text. */
    .about-figure {
      max-width: 220px;
      margin: 0 auto;
    }
  }
</style>
