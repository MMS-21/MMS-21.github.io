;max-height:none;margin:35px auto 0;overflow:auto}dialog[open]{animation:sheet-arrive .55s cubic-bezier(.16,1,.3,1)}.close-sheet{background:none;border:0;padding:8px 0;margin-bottom:25px;font-size:12px}.close-sheet small{margin-left:14px;color:#807568}.drawer-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.drawer-heading h2{font-size:clamp(36px,4vw,64px);max-width:700px;line-height:1.05;margin:0}.drawer-heading a{font-size:12px;white-space:nowrap}#drawer-chart{display:block;width:100%;height:auto;max-height:65svh;object-fit:contain;background:#fffcf8}.case-frame{width:100%;height:75svh;border:0;margin-top:30px;background:var(--paper)}#drawer-content{margin-top:20px;font-size:13px}#resume-sheet{width:min(640px,90vw);min-height:70svh}#resume-sheet h2{font-size:48px;margin:0 0 15px}#resume-sheet p{margin:20px 0;max-width:52ch}.sheet-open{overflow:hidden}@keyframes sheet-arrive{from{opacity:.4;transform:translateY(60px) rotate(1deg)}to{opacity:1;transform:none}}@media(max-width:650px){.fixed-menu{position:relative;top:0;left:0;width:100%;padding:20px;gap:15px;justify-content:space-between}.contact-links{display:none}nav{padding-top:20px}.identity{width:100px}main{padding-top:35px}.stack{height:420px}.project-image img{height:auto}.paper-copy h2{font-size:24px}.drawer-heading{display:block}.drawer-heading a{display:inline-block;margin-top:18px}#case-drawer{width:calc(100% - 16px);padding:25px 18px}.stack-controls{margin-top:15px}}@media(prefers-reduced-motion:reduce){dialog[open]{animation:none}nav a,.pet-paper{transition:none}}
</style>


