@media(max-width:650px){.introduction h1{font-size:clamp(44px,10vw,64px);line-height:1}.menu-label{display:none}.side-painting{right:-230px;width:400px;opacity:.17}}
</style>

<style is:global>
.fixed-menu nav{font-size:18px}.fixed-menu .identity>a,.fixed-menu .contact-links,.fixed-menu .contact-links a,.fixed-menu .contact-links button,.fixed-menu .menu-label{font-size:10px;line-height:14px}.fixed-menu .pet-paper{font-size:8px!important}
</style>

