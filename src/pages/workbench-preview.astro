</style>

<style is:global>
.project-paper{transition:box-shadow .25s;touch-action:pan-y}.project-paper::after{content:'';position:absolute;inset:0;background:#534533;opacity:var(--shade,0);pointer-events:none}.project-image{touch-action:pan-y;user-select:none;cursor:grab}.project-image img{pointer-events:none;-webkit-user-drag:none}.project-paper.dragging .project-image{cursor:grabbing}.stack:focus-visible{outline:1px dashed #817568;outline-offset:24px}.switch-paper{transition:translate .2s}.switch-paper:hover{translate:0 -2px}
#works-collection{position:fixed;inset:32px 0 0;width:calc(100% - 16px);max-width:none;height:calc(100svh - 32px);max-height:none;margin:0 auto;padding:0 4vw 60px;overflow-y:auto;overscroll-behavior:contain;animation:none;border-radius:4px 4px 0 0;scrollbar-color:#b5aa97 #f7f2e8;will-change:transform}.collection-handle{padding:10px 0 0;touch-action:none;cursor:grab}.collection-handle>span{display:block;width:42px;height:3px;background:#b9af9f;margin:0 auto 8px;border-radius:2px}.collection-handle .close-sheet{margin-bottom:20px}.collection-heading{padding:20px 0 55px}.collection-heading h2{font:400 clamp(64px,7vw,112px)/1 Cormorant,Georgia,serif;margin:0 0 22px}.collection-heading p{max-width:30ch;font-size:13px;color:var(--muted)}.collection-projects{display:grid;grid-template-columns:1fr 1fr;gap:60px 32px}.collection-project{padding:0;border:0;background:none;text-align:left;min-width:0}.collection-project:first-child{grid-column:1/-1}.collection-project img{display:block;width:100%;height:380px;object-fit:contain;background:#eeeae0;transition:filter .3s}.collection-project:first-child img{height:min(65vw,650px);background:#e4e9e4}.collection-project:hover img{filter:brightness(.96)}.collection-project>span{display:block;padding:22px 0}.collection-project strong{font:500 32px/1.1 Cormorant,Georgia,serif;display:block;max-width:28ch}.collection-project small{display:block;margin-top:12px;font-size:10px;color:var(--muted)}.collection-index{display:inline-block;margin-top:45px;font-size:12px}#case-drawer{overscroll-behavior:contain;scrollbar-color:#b5aa97 #f7f2e8}#drawer-chart{transform-origin:0 0}
@media(max-width:650px){.collection-projects{grid-template-columns:1fr;gap:28px}.collection-project img,.collection-project:first-child img{height:260px}.collection-project strong{font-size:28px}#works-collection{padding:0 24px 40px}.collection-heading{padding-bottom:25px}}
@media(prefers-reduced-motion:reduce){.collection-project img,.switch-paper{transition:none}}
</style>
