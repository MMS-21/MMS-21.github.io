<script>
const papers=Array.from(document.querySelectorAll<HTMLElement>('.project-paper'));
const counter=document.querySelector('.count')!;
let front=0,z=3,sound=true,audio:AudioContext|undefined,busy=false;
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
function rustle(){if(!sound)return;audio??=new AudioContext();void audio.resume();const buffer=audio.createBuffer(1,audio.sampleRate*.24,audio.sampleRate);const values=buffer.getChannelData(0);for(let i=0;i<values.length;i++)values[i]=(Math.random()*2-1)*Math.sin(Math.PI*i/values.length);const source=audio.createBufferSource();source.buffer=buffer;const filter=audio.createBiquadFilter();filter.type='bandpass';filter.frequency.value=1800;filter.Q.value=.65;const gain=audio.createGain();gain.gain.value=.035;source.connect(filter).connect(gain).connect(audio.destination);source.start();}
function select(i:number){front=(i+papers.length)%papers.length;papers.forEach((p,j)=>{p.dataset.front=String(j===front);p.style.setProperty('--angle',j===front?'-5deg':'6deg')});papers[front].style.zIndex=String(++z);counter.textContent=`${front+1} / ${papers.length}`;}
async function shuffle(i:number){if(busy)return;const next=(i+papers.length)%papers.length;if(next===front)return;busy=true;rustle();const old=papers[front],incoming=papers[next];if(reduced.matches){select(next);busy=false;return}const first=old.animate([{transform:'translateX(-50%) rotate(-5deg)'},{transform:'translateX(-104%) translateY(-22px) rotate(-13deg)'},{transform:'translateX(-50%) rotate(6deg)'}],{duration:720,easing:'cubic-bezier(.4,0,.2,1)'});incoming.animate([{transform:'translateX(-50%) rotate(6deg)'},{transform:'translateX(-28%) translateY(8px) rotate(9deg)'},{transform:'translateX(-50%) rotate(-5deg)'}],{duration:720,easing:'cubic-bezier(.4,0,.2,1)'});window.setTimeout(()=>select(next),340);await first.finished;busy=false;}
document.querySelectorAll('.switch-paper').forEach((button,i)=>button.addEventListener('click',()=>void shuffle(front+(i===0?-1:1))));
document.querySelector('#sound')!.addEventListener('click',event=>{sound=!sound;const button=event.currentTarget as HTMLButtonElement;button.textContent=sound?'Sound on':'Sound off';button.setAttribute('aria-pressed',String(sound));if(sound)rustle()});
papers.forEach((paper,i)=>paper.querySelector('.project-image')!.addEventListener('click',()=>void shuffle(i===front?front+1:i)));select(0);
const drawer=document.querySelector<HTMLDialogElement>('#case-drawer')!,resume=document.querySelector<HTMLDialogElement>('#resume-sheet')!;
let request=0;
document.querySelector('#expand-study')!.addEventListener('click',async()=>{const token=++request,paper=papers[front],link=paper.querySelector<HTMLAnchorElement>('h2 a')!,image=paper.querySelector<HTMLImageElement>('img')!;document.querySelector('#drawer-title')!.textContent=link.textContent;const full=document.querySelector<HTMLAnchorElement>('#drawer-link')!;full.href=link.href;const chart=document.querySelector<HTMLImageElement>('#drawer-chart')!;chart.src=image.src;chart.alt=image.alt;const content=document.querySelector<HTMLElement>('#drawer-content')!;content.textContent='Loading the case study…';drawer.showModal();document.body.classList.add('sheet-open');rustle();try{const response=await fetch(link.href);if(!response.ok)throw Error('Unavailable');const doc=new DOMParser().parseFromString(await response.text(),'text/html'),main=doc.querySelector('main');if(token!==request)return;content.replaceChildren();if(main){const article=main.querySelector('article')||main;article.querySelectorAll('script,header,.back').forEach(el=>el.remove());content.append(article)}else content.textContent='Use the full case study link to continue.'}catch{if(token===request)content.textContent='The preview could not load. Open the full case study above.'}});
const resumeTrigger=document.querySelector<HTMLButtonElement>('#resume-open')!;
resumeTrigger.setAttribute('aria-haspopup','dialog');resumeTrigger.setAttribute('aria-controls','resume-sheet');
resumeTrigger.addEventListener('click',()=>{resume.classList.remove('closing');resume.showModal();document.body.classList.add('sheet-open');resumeTrigger.setAttribute('aria-expanded','true');rustle()});
let closingResume=false;
function closeResume(){if(closingResume||!resume.open)return;closingResume=true;resume.classList.add('closing');rustle();setTimeout(()=>{resume.close();resume.classList.remove('closing');closingResume=false;resumeTrigger.setAttribute('aria-expanded','false');resumeTrigger.focus()},reduced.matches?0:480)}
resume.addEventListener('cancel',event=>{event.preventDefault();closeResume()});
for(const sheet of [drawer,resume]){sheet.querySelector('.close-sheet')!.addEventListener('click',()=>sheet===resume?closeResume():sheet.close());sheet.addEventListener('close',()=>document.body.classList.remove('sheet-open'));sheet.addEventListener('click',event=>{if(event.target===sheet){if(sheet===resume){closeResume();return}const r=sheet.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)sheet.close()}})}
</script>

