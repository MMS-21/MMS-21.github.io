</style>


<style is:global>
.fixed-menu{top:56px;left:clamp(25px,3.4vw,58px);gap:27px;align-items:start;flex-wrap:wrap;width:245px}.identity{width:110px;display:flex;flex-direction:column;align-items:center;gap:7px}.identity>a{font:12px Manrope,sans-serif;text-decoration:none;white-space:nowrap}.identity :is(astro-island){display:block;height:86px}.pet-paper{font-size:9px!important;padding:4px 9px!important;background:#f8f3e9 url('/img/paper-fibers.svg')!important;border:1px solid #b8ad9855!important;box-shadow:1px 3px 5px #51433312;transform:rotate(-3deg);transition:transform .3s}.pet-paper:hover{transform:rotate(2deg) translateY(-2px)}nav{padding-top:13px}nav a{transition:translate .3s,color .3s}nav a:hover{translate:4px 0}.contact-links{display:grid;grid-template-columns:110px 1fr;gap:27px;width:100%;margin-top:15px;font-size:10px}.contact-links>span{color:#81766a}.contact-links>div{display:grid;gap:9px}.contact-links a,.contact-links button{font:10px Manrope,sans-serif;text-decoration:none;text-align:left;padding:0;border:0;background:none}.contact-links a:hover,.contact-links button:hover{text-decoration:underline}.project-image{margin:0;width:100%;padding:0;border:0;background:#fffcf7;overflow:hidden;cursor:pointer}.project-image img{height:auto;aspect-ratio:1.4;object-fit:cover}.project-paper{padding:0;overflow:hidden}.paper-copy{padding:17px 22px 19px}.paper-copy h2{font-size:27px;margin:0 0 8px}.paper-copy h2 a:hover{text-decoration:underline}.paper-copy h2 span{font-size:17px;white-space:nowrap}.paper-copy small{font-size:9px;color:#817568}.stack{height:445px}.stack-controls>button{border:0;background:none;padding:8px 0;font-size:11px;text-decoration:underline;text-underline-offset:5px}.stack-controls{margin-top:15px}dialog{color:var(--ink);border:0;background:#faf6ed url('/img/paper-fibers.svg');padding:45px;box-shadow:0 25px 70px #30282040}dialog::backdrop{background:#2e2a245c;backdrop-filter:blur(5px)}#case-drawer{width:calc(100% - 56px);max-width:1400px;height:calc(100svh - 35px);max-height:none;margin:35px auto 0;overflow:auto}dialog[open]{animation:sheet-arrive .55s cubic-bezier(.16,1,.3,1)}.close-sheet{background:none;border:0;padding:8px 0;margin-bottom:25px;font-size:12px}.close-sheet small{margin-left:14px;color:#807568}.drawer-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.drawer-heading h2{font-size:clamp(36px,4vw,64px);max-width:700px;line-height:1.05;margin:0}.drawer-heading a{font-size:12px;white-space:nowrap}#drawer-chart{display:block;width:100%;height:auto;max-height:65svh;object-fit:contain;background:#fffcf8}.case-frame{width:100%;height:75svh;border:0;margin-top:30px;background:var(--paper)}#drawer-content{margin-top:20px;font-size:13px}#resume-sheet{width:min(640px,90vw);min-height:70svh}#resume-sheet h2{font-size:48px;margin:0 0 15px}#resume-sheet p{margin:20px 0;max-width:52ch}.sheet-open{overflow:hidden}@keyframes sheet-arrive{from{opacity:.4;transform:translateY(60px) rotate(1deg)}to{opacity:1;transform:none}}@media(max-width:650px){.fixed-menu{position:relative;top:0;left:0;width:100%;padding:20px;gap:15px;justify-content:space-between}.contact-links{display:none}nav{padding-top:20px}.identity{width:100px}main{padding-top:35px}.stack{height:420px}.project-image img{height:auto}.paper-copy h2{font-size:24px}.drawer-heading{display:block}.drawer-heading a{display:inline-block;margin-top:18px}#case-drawer{width:calc(100% - 16px);padding:25px 18px}.stack-controls{margin-top:15px}}@media(prefers-reduced-motion:reduce){dialog[open]{animation:none}nav a,.pet-paper{transition:none}}
</style>


<style is:global>
.project-image img{aspect-ratio:auto;height:auto;object-fit:contain}.stack{height:510px}#drawer-content article{max-width:1000px;margin:45px auto;font-size:14px;line-height:1.8}#drawer-content h2{font-size:36px;margin:45px 0 14px}#drawer-content h3{font:500 26px Cormorant,Georgia,serif;margin:25px 0 10px}#drawer-content p{max-width:72ch}#drawer-content img,#drawer-content svg{max-width:100%;height:auto}#drawer-content pre{overflow:auto;padding:20px;background:#eee8dc;font-size:12px}#drawer-content table{display:block;overflow:auto;border-collapse:collapse}#drawer-content td,#drawer-content th{padding:10px;border-bottom:1px solid #d3c9b8}#drawer-content figure{margin:30px 0}#drawer-content .case-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}@media(max-width:650px){.stack{height:calc(81vw + 120px)}#drawer-content .case-grid{grid-template-columns:1fr}}
</style>

<style is:global>
#resume-sheet{width:min(650px,94vw);padding:20px;max-height:94svh;overflow:auto}#resume-sheet .close-sheet{margin:0 0 15px 10px}.resume-page{display:block;width:100%;height:auto}.resume-download{display:block;width:fit-content;margin:18px auto 5px;padding:10px 20px;font-size:12px;color:#fcfaf7;background:#302c29;border-radius:30px;text-decoration:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
</style>

<style is:global>
#resume-sheet{position:fixed;inset:0;width:100vw;height:100svh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:transparent;box-shadow:none;overflow:hidden;min-height:0;perspective:1800px;animation:none}
#resume-sheet::backdrop{background:rgba(40,37,31,.57);backdrop-filter:blur(5px);animation:resume-scrim-in 500ms ease both}
#resume-sheet.closing::backdrop{animation:resume-scrim-out 480ms ease both}
.resume-paper{position:absolute;left:50%;top:50%;width:min(580px,calc((100svh - 60px)*.707),calc(100vw - 48px));aspect-ratio:595.28/841.89;transform:translate(-50%,-50%);transform-style:preserve-3d;filter:drop-shadow(0 18px 28px #17140e33);animation:resume-paper-in 750ms cubic-bezier(.16,1,.3,1) both}
.resume-panel{position:absolute;left:0;width:100%;height:33.334%;background-image:url('/img/resume-preview.png?v=b0ba518');background-size:100% 300%;background-repeat:no-repeat;backface-visibility:hidden;transform-style:preserve-3d;background-color:#fffcf5}
.resume-middle{top:33.333%;background-position:center center}.resume-top{top:0;background-position:center top;transform-origin:50% 100%;animation:resume-top-unfold 950ms cubic-bezier(.16,1,.3,1) both}.resume-bottom{top:66.666%;background-position:center bottom;transform-origin:50% 0;animation:resume-bottom-unfold 1000ms cubic-bezier(.16,1,.3,1) both}
.resume-top::after,.resume-bottom::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,#64583e20,transparent 18%);animation:resume-crease 1100ms ease both}.resume-bottom::after{background:linear-gradient(180deg,#64583e20,transparent 18%)}
#resume-sheet .close-sheet{position:absolute;top:24px;right:28px;margin:0;padding:8px 12px;color:#fffcf5;z-index:3;font-size:11px}#resume-sheet .close-sheet small{color:#eee5d5}
#resume-sheet .resume-download{position:absolute;right:32px;bottom:32px;margin:0;padding:15px 25px;border-radius:999px;background:#302c29;color:#fffcf5;font-size:11px;display:flex;gap:16px;align-items:center;box-shadow:0 5px 12px #1d180d20;animation:resume-download-in 650ms 350ms cubic-bezier(.16,1,.3,1) both;transition:background .2s,translate .2s}
#resume-sheet .resume-download:hover{background:#494236;translate:0 -3px}#resume-sheet .resume-download:focus-visible,#resume-sheet .close-sheet:focus-visible{outline-color:#fffcf5}
#resume-sheet.closing .resume-top{animation:resume-top-fold 480ms cubic-bezier(.7,0,.84,0) both}#resume-sheet.closing .resume-bottom{animation:resume-bottom-fold 480ms cubic-bezier(.7,0,.84,0) both}#resume-sheet.closing .resume-paper{animation:resume-paper-out 480ms ease both}#resume-sheet.closing .resume-download{animation:resume-download-out 250ms ease both}
@keyframes resume-top-unfold{0%{transform:rotateX(-175deg);filter:brightness(.8)}100%{transform:rotateX(0);filter:brightness(1)}}@keyframes resume-bottom-unfold{0%{transform:rotateX(175deg);filter:brightness(.8)}100%{transform:rotateX(0);filter:brightness(1)}}@keyframes resume-paper-in{from{opacity:0;transform:translate(-50%,calc(-50% + 35px)) scale(.9) rotate(-2deg)}to{opacity:1;transform:translate(-50%,-50%) scale(1) rotate(0)}}@keyframes resume-crease{from{opacity:1}to{opacity:.1}}@keyframes resume-scrim-in{from{background:rgba(40,37,31,0);backdrop-filter:blur(0)}to{background:rgba(40,37,31,.57);backdrop-filter:blur(5px)}}@keyframes resume-scrim-out{to{background:rgba(40,37,31,0);backdrop-filter:blur(0)}}@keyframes resume-download-in{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@keyframes resume-download-out{to{opacity:0;transform:translateY(12px)}}@keyframes resume-top-fold{to{transform:rotateX(-170deg)}}@keyframes resume-bottom-fold{to{transform:rotateX(170deg)}}@keyframes resume-paper-out{to{opacity:0;transform:translate(-50%,calc(-50% + 20px)) scale(.88)}}
@media(max-width:650px){.resume-paper{width:min(calc((100svh - 140px)*.707),calc(100vw - 32px));top:46%}#resume-sheet .resume-download{right:50%;translate:50% 0;bottom:20px;white-space:nowrap}#resume-sheet .resume-download:hover{translate:50% -2px}#resume-sheet .close-sheet{top:10px;right:10px}}
@media(prefers-reduced-motion:reduce){#resume-sheet::backdrop,#resume-sheet.closing::backdrop,#resume-sheet .resume-paper,#resume-sheet .resume-panel,#resume-sheet .resume-panel::after,#resume-sheet .resume-download{animation:none!important;transition:none!important}}
</style>

<style is:global>
.identity>a{font:11px/1.5 ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;letter-spacing:.06em;text-transform:uppercase}
.tool-papers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;padding:8px 4px}
.tool-paper{display:block;color:var(--ink);text-decoration:none;background:#f8f3e9 url('/img/paper-fibers.svg');border:1px solid #77685318;box-shadow:3px 8px 15px #51433314;transform:rotate(-2deg);transition:transform .4s cubic-bezier(.16,1,.3,1),box-shadow .4s}
.tool-paper:nth-child(2){transform:rotate(2deg)}.tool-paper:hover,.tool-paper:focus-visible{transform:translateY(-7px) rotate(0);box-shadow:5px 15px 23px #51433322}
.tool-art{position:relative;aspect-ratio:1.6;overflow:hidden;color:#557b87;background:#e7eeee80}.document-art{color:#8b7355;background:#ece6db90}.tool-art svg{display:block;width:100%;height:100%}.tool-art>span{position:absolute;bottom:12px;left:18px;font:8px ui-monospace,monospace;letter-spacing:.09em;opacity:.7}.tool-copy{padding:20px 20px 22px}.tool-copy h3{font:500 28px/1.1 Cormorant,Georgia,serif;letter-spacing:-.02em;margin:0 0 9px;display:flex;justify-content:space-between;align-items:center}.tool-copy h3 span{font:16px Manrope,sans-serif;transition:translate .3s}.tool-paper:hover h3 span{translate:2px -2px}.tool-copy p{font-size:11px;margin:0 0 13px;color:var(--muted)}.tool-copy small{font-size:9px;color:#817568}.report-bars,.document-lens{transform-origin:center;transition:transform .4s}.tool-paper:hover .report-bars{transform:translateY(-4px)}.tool-paper:hover .document-lens{transform:translate(3px,-3px)}
@media(max-width:650px){.tool-papers{grid-template-columns:1fr;gap:26px}.tool-art{aspect-ratio:1.8}.identity>a{font-size:10px}}
@media(prefers-reduced-motion:reduce){.tool-paper,.tool-copy h3 span,.report-bars,.document-lens{transition:none}.tool-paper:hover,.tool-paper:focus-visible{transform:none}}
</style>

<style is:global>
@font-face{font-family:"Departure Mono";src:url('/fonts/departure-mono.woff2') format('woff2');font-style:normal;font-weight:400;font-display:swap}
.identity>a,.contact-links,.contact-links a,.contact-links button,.menu-label{font:400 11px/15px "Departure Mono",ui-monospace,SFMono-Regular,Menlo,monospace;color:lab(45.3389% 3.09339 7.00407);text-transform:uppercase;letter-spacing:0}
