---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const readingTime = (body: string = '') => {
  const text = body.replace(/```[\s\S]*?```/g, '').replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#*_`>]/g, '');
  return Math.max(1, Math.ceil(text.trim().split(/\s+/).filter(Boolean).length / 200));
};
---

<Base title="Writing" description="What I learned building analytics and AI tools: practical write-ups on implementation, failures, and verification." ogImage="/og-writing.png">
  <div class="wrap">
    <section class="writing-intro">
      <h1>What I learned building analytics and AI tools.</h1>
      <p class="intro-copy">Notes from the work itself: decisions I made, things that broke, and what I would do differently next time.</p>
      <a class="feed-link" href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a>
    </section>

    <section class="post-list" aria-label="Published articles">
      {posts.map((post, index) => (
        <article class:list={['post', { featured: index === 0 }]}>
          {post.id === 'analytics-agent-build' && (
            <figure class="agent-sketch">
              <svg viewBox="0 0 640 200" role="img" aria-labelledby="agent-sketch-title">
                <title id="agent-sketch-title">A tool-calling loop produces a draft report, then checks its quality and revises it.</title>
                <g fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <path fill="var(--accent-soft)" d="M42 39 159 34 168 133 49 140Z" />
                  <path d="m57 53 88-4 5 69-88 6Z M76 72l-8 9 9 8 m46-20 8 9-7 9 m-22-18-8 24 M74 107l55-3" />
                  <path class="ink-route" pathLength="1" d="M177 83h74 m-9-9 10 9-10 9" />
                  <path d="M270 40h80l21 22v79H270Z M350 40v22h21 M287 83h66 M287 95h45 M287 109h58 M287 123h37" />
                  <path class="ink-route" pathLength="1" d="M382 83h64 m-9-9 10 9-10 9" />
                  <path fill="var(--accent-soft)" d="m466 46 99-6 8 90-101 8Z" />
                  <circle cx="517" cy="87" r="24" />
                  <path class="ink-check" pathLength="1" d="m506 87 8 8 17-19" />
                  <path class="ink-return" pathLength="1" d="M516 145v23H105v-17 m-8 8 8-9 8 9" />
                  <path d="m578 52 9-8 m-5 21 13-2 M32 57l-10-5 M31 72l-11 2" />
                </g>
                <g fill="currentColor" font-family="inherit" font-size="15" text-anchor="middle">
                  <text x="105" y="27">Tool-calling loop</text>
                  <text x="320" y="27">Draft report</text>
                  <text x="520" y="27">Quality check</text>
                  <text x="312" y="191">Revise when needed</text>
                </g>
              </svg>
            </figure>
          )}
          <div class="article-meta">
            <span>{post.data.tags.includes('agentic-ai') ? 'Agentic AI' : post.data.tags[0] || 'Build notes'}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>
            <span aria-hidden="true">·</span>
            <span>About {readingTime(post.body)} min read</span>
          </div>
          <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
          <p class="article-description">{post.data.description}</p>
          <a class="read-link" href={`/writing/${post.id}/`}>Read the article <span aria-hidden="true">→</span></a>
        </article>
      ))}
      {posts.length === 0 && <p>No articles published yet. In the meantime, <a href="/projects/">explore the projects</a>.</p>}
    </section>
    <aside class="project-note">
      <p>Want to see the work behind the writing?</p>
      <a href="/projects/">Explore the projects <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</Base>

<style>
  .writing-intro { padding: .5rem 0 2.75rem; }
  .writing-intro h1 { max-width: 18ch; font-size: clamp(2.2rem, 6vw, 3.15rem); line-height: 1.14; letter-spacing: -.035em; text-wrap: balance; margin-bottom: 1rem; }
  .intro-copy { max-width: 34rem; color: var(--muted); margin: 0 0 1.1rem; }
  .feed-link { font-size: .875rem; }
  .post { border-top: 1px solid var(--border); padding: 2rem 0 2.5rem; }
  .agent-sketch { margin: 0 0 1.5rem; max-width: 38rem; color: var(--fg); }
  .agent-sketch svg { width: 100%; height: auto; display: block; overflow: visible; }
  .article-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .55rem; font-size: .8125rem; color: var(--muted); margin-bottom: 1rem; }
  .article-meta > span:first-child { color: var(--accent); font-weight: 650; }
  .post h2 { margin: 0 0 1rem; max-width: 31ch; font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.3; text-wrap: pretty; }
  .post h2 a { color: var(--fg); text-decoration: none; }
  .post h2 a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; }
  .article-description { margin: 0 0 1.35rem; color: var(--muted); }
  .read-link { display: inline-flex; gap: .6rem; align-items: center; font-weight: 650; text-decoration: none; padding: .3rem 0; }
  .read-link:hover { text-decoration: underline; }
  .project-note { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: .9375rem; }
  .project-note p { margin: 0; color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .ink-route, .ink-check, .ink-return { stroke-dasharray: 1; animation: draw-ink 650ms cubic-bezier(.16,1,.3,1) both; }
    .ink-check { animation-delay: 150ms; }
    .ink-return { animation-delay: 250ms; }
    .read-link span { transition: transform 160ms ease-out; }
    .read-link:hover span, .read-link:focus-visible span { transform: translateX(4px); }
    @keyframes draw-ink { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  }
  @media (max-width: 480px) {
    .writing-intro { padding-top: 0; padding-bottom: 2rem; }
    .agent-sketch { margin-bottom: 1.25rem; }
    .article-meta { gap: .3rem .4rem; }
  }
</style>

