---
import Base from '../../layouts/Base.astro';
import WritingSketch from '../../components/WritingSketch.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const [featured,...rest]=posts;
const minutes=(body='')=>Math.max(1,Math.ceil(body.trim().split(/\s+/).length/200));
const date=(d:Date)=>d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const category=(tags:string[])=>tags.includes('people-analytics')?'People analytics':tags.includes('learning-resources')?'Learning guide':'Build notes';
---
<Base title="Writing" description="Practical notes on building AI applications, working with data, and learning by making things." ogImage="/og-writing.png" hideFooter>
 <div class="writing-page">
  <header class="notebook-opening"><div><h1>The working notebook.</h1><p>Ideas worth exploring. Things worth building.<br />Notes on AI, analysis, and what happens along the way.</p></div><a class="feed-link" href="/rss.xml">Follow via RSS ↗</a></header>
  {featured&&<section class="featured-story" aria-label="Latest article">
   <div class="story-copy"><h2><a href={`/writing/${featured.id}/`}>{featured.data.title}</a></h2><p class="story-meta">{category(featured.data.tags)} <span>·</span> {minutes(featured.body)} min read</p><p class="story-description">{featured.data.description}</p><a class="read-link" href={`/writing/${featured.id}/`}>Open the notebook <span aria-hidden="true">→</span></a><time datetime={featured.data.pubDate.toISOString()}>{date(featured.data.pubDate)}</time></div>
   <figure><WritingSketch /><figcaption>A few useful ideas, connected.</figcaption></figure>
  </section>}
  {rest.length>0&&<section class="more-writing" aria-labelledby="more-title"><h2 id="more-title">More from the notebook</h2>{rest.map(post=><article class="article-row"><div class="row-date"><time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time><span>{category(post.data.tags)} · {minutes(post.body)} min</span></div><div><h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="read-link" href={`/writing/${post.id}/`}>Read the article <span aria-hidden="true">→</span></a></div></article>)}</section>}
  <aside class="project-note"><p>The work behind the words.</p><a href="/projects/">Explore the projects →</a></aside>
 </div>
</Base>
<style>
 .writing-page{max-width:1120px;margin:auto;padding:12px 40px 24px;color:#302d28}
 .notebook-opening{display:flex;justify-content:space-between;align-items:end;gap:24px;padding-bottom:40px}
 h1,h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;letter-spacing:-.02em}
 h1{font-size:clamp(3rem,5.3vw,4.6rem);line-height:1.02;margin:0 0 20px;text-wrap:balance}
 .notebook-opening p{color:#6a6053;line-height:1.8;margin:0;font-size:1.05rem}
 .feed-link{white-space:nowrap;font-size:.82rem;color:#725c3f;margin-bottom:5px}
 .featured-story{display:grid;grid-template-columns:1.25fr .8fr;gap:28px;align-items:center;padding:42px 40px;background:#fffdf8;border:1px solid #ded2bd;box-shadow:3px 12px 30px #6c593b0c;position:relative}
 .featured-story:before{content:'';position:absolute;inset:7px -6px -7px 6px;border:1px solid #e5daca;z-index:-1;transform:rotate(-.7deg)}
 .story-copy h2{font-size:clamp(2.1rem,3.2vw,3rem);line-height:1.12;margin:0 0 18px;text-wrap:pretty}
 h2 a,h3 a{color:inherit;text-decoration:none}h2 a:hover,h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
 .story-meta{display:flex;flex-wrap:wrap;gap:8px;font-size:.78rem;color:#6f604c;margin:0 0 20px}
 .story-description{font-size:.97rem;color:#655d51;line-height:1.8;margin:0 0 24px}
 .read-link{display:inline-flex;gap:14px;align-items:center;color:#315d72;text-decoration:none;font-size:.9rem;border-bottom:1px solid #879ba3;padding:5px 0}
 .read-link span{transition:transform 220ms}.read-link:hover span{transform:translateX(5px)}
 .story-copy time{display:block;margin-top:24px;color:#716450;font-size:.75rem}
 figure{margin:0;transform:rotate(2deg)}figcaption{text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:1.25rem;color:#796648;margin-top:8px}
 .more-writing{margin-top:58px}.more-writing>h2{font-size:2.2rem;margin:0 0 26px}
 .article-row{display:grid;grid-template-columns:160px 1fr;gap:28px;border-top:1px solid #dacdb9;padding:28px 0 32px}
 .row-date{font-size:.76rem;color:#75644e;padding-top:5px}.row-date span{display:block;margin-top:7px}
 .article-row h3{font-size:2rem;line-height:1.18;margin:0 0 14px;max-width:40ch}.article-row p{font-size:.93rem;color:#655d51;line-height:1.8;margin:0 0 14px}
 .project-note{margin-top:36px;padding-top:24px;border-top:1px solid #dacdb9;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.9rem}.project-note p{margin:0;color:#6a6053}
 @media(max-width:1000px){.featured-story{padding:32px 28px;grid-template-columns:1fr .65fr;gap:15px}.writing-page{padding-inline:28px}.article-row{grid-template-columns:125px 1fr}}
 @media(max-width:800px){.featured-story{grid-template-columns:1fr}.featured-story figure{max-width:300px;justify-self:center}.notebook-opening{align-items:start;flex-direction:column}.article-row{grid-template-columns:1fr;gap:14px}.row-date span{display:inline;margin-left:12px}}
 @media(max-width:500px){.writing-page{padding:4px 24px 20px}.featured-story{padding:28px 22px}.featured-story figure{max-width:260px}.story-copy h2{font-size:2.15rem}.article-row h3{font-size:1.8rem}}
 @media(prefers-reduced-motion:reduce){.read-link span{transition:none}}
</style>

