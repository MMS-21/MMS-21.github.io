---
import Base from '../layouts/Base.astro';
const places = [
 {id:'house',name:'Moaaz’s house',label:'Meet Moaaz',x:465,y:155,color:'#7698a6',type:'house',title:'Come in. Make yourself at home.',copy:'I’m Moaaz, a Data & Business Analyst in Cairo. I turn everyday business questions into clearer reports, useful tools, and practical next steps.',href:'/about/',action:'Meet Moaaz'},
 {id:'workshop',name:'The workshop',label:'Projects & tools',x:205,y:300,color:'#a8b487',type:'workshop',title:'There’s always something on the workbench.',copy:'Customer analytics, dashboards, reporting automation, and tools I’m building. Step inside to see the questions, the process, and the work.',href:'/projects/',action:'Explore the projects'},
 {id:'cinema',name:'The little cinema',label:'Experience',x:740,y:300,color:'#b98c78',type:'cinema',title:'A few chapters from the journey.',copy:'Business studies, banking internships, operational analysis, and learning by building. Follow the story from the beginning to what I’m doing now.',href:'/#about',action:'Follow my journey'},
 {id:'newspaper',name:'The newspaper stand',label:'Writing & notes',x:205,y:550,color:'#7698a6',type:'newspaper',title:'Fresh thoughts. A little ink.',copy:'Notes from building, experimenting, and making sense of things. Pick up a story from my working notebook.',href:'/writing/',action:'Read the notebook'},
 {id:'post',name:'The post office',label:'Say hello',x:740,y:550,color:'#a8b487',type:'post',title:'A note is always welcome.',copy:'A role, a project, a question, or just a little hello. This is where a conversation starts.',href:'/contact/',action:'Write to Moaaz'},
 {id:'backyard',name:'The backyard',label:'Take a little break',x:470,y:575,color:'#7698a6',type:'backyard',title:'No meetings in the backyard.',copy:'Just me, a few chickens, and cows with absolutely no deadlines. Leave a little feed and stay a while.',href:'',action:'Feed the chickens'},
];
const trees=[[80,180,1.1],[130,140,.8],[825,170,1],[875,220,.8],[80,440,.9],[865,450,1.1],[100,650,.9],[830,685,.9],[340,110,.7],[650,105,.9],[350,710,.75],[625,715,.85]];
---
<Base title="Moaaz’s little village" description="A little village on paper. Explore Moaaz Magdy’s projects, writing, experience, and a very peaceful backyard." hideHeader hideFooter flushTop>
 <div class="village-page">
  <header class="village-header"><a class="return" href="/">← Classic portfolio</a><span class="edition">A little corner of Cairo</span><button class="motion" type="button" aria-pressed="false">Pause motion</button></header>
  <div class="village-layout">
   <div class="village-world">
    <div class="map-heading"><h1>Moaaz’s little village</h1><p>A few things I’m building. A few stories to tell. A place to say hello.</p></div>
    <svg class="village-map" viewBox="0 0 960 790" aria-labelledby="map-title map-desc">
     <title id="map-title">Moaaz’s village on a piece of paper</title><desc id="map-desc">Six places connected by winding paths. Select a building to explore, or visit the backyard to feed the chickens.</desc>
     <defs>
      <pattern id="grass" width="27" height="23" patternUnits="userSpaceOnUse"><path d="m6 15 2-5 2 5m10-6 2-4" stroke="#9da584" stroke-width="1" fill="none" opacity=".55"/></pattern>
      <pattern id="roof" width="18" height="13" patternUnits="userSpaceOnUse"><path d="M0 12h18M9 0v12" stroke="#405e69" stroke-width="1" opacity=".3"/></pattern>
      <symbol id="tree" viewBox="0 0 80 100"><ellipse cx="40" cy="90" rx="25" ry="7" fill="#777850" opacity=".12"/><path d="M36 63v28h9V57" fill="#9f8665" stroke="#79664b" stroke-width="2"/><path d="M20 67C-1 63 7 40 16 34 7 13 37-1 48 12c26-6 35 19 23 31 15 22-9 39-23 29-9 8-20 2-28-5Z" fill="#a6b28c" stroke="#788667" stroke-width="2"/><path d="M19 45q12-12 22-6m1-16q12-4 20 8M27 63q12 7 22-3" fill="none" stroke="#c1cba9" stroke-width="3"/></symbol>
      <symbol id="flower" viewBox="0 0 24 36"><path d="M12 31V12m0 13-7-5m7 1 6-6" stroke="#82916f" stroke-width="1.5" fill="none"/><path d="M12 6c-9-8-13 7-5 9-3 8 10 9 10 1 10 0 7-13-1-11Z" fill="#b5cfdb"/><circle cx="12" cy="12" r="3" fill="#eee1b8"/></symbol>
      <symbol id="chicken" viewBox="0 0 36 38"><ellipse cx="18" cy="33" rx="12" ry="3" fill="#7d6c4d" opacity=".15"/><path d="m12 28-1 6m10-5 1 5" stroke="#b68a4e" stroke-width="2"/><path d="m7 17-5-7 10 4" fill="#f7f0dc" stroke="#9f8f76"/><ellipse cx="17" cy="21" rx="12" ry="10" fill="#fff9e7" stroke="#a8967c"/><path d="M20 16q-3-13 5-13 8 0 7 13" fill="#fff9e7" stroke="#a8967c"/><path d="m24 3 1-3 3 3 3-2 1 5" fill="#b96d5a"/><path d="m31 10 5 3-5 2" fill="#c49b4f"/><circle cx="28" cy="9" r="1.3" fill="#3b3c32"/><path d="M10 20q4 8 10 3" fill="none" stroke="#cbbb9b"/></symbol>
      <symbol id="cow" viewBox="0 0 86 65"><ellipse cx="40" cy="57" rx="34" ry="6" fill="#7d6c4d" opacity=".13"/><path d="M17 39v17h8V42m29-2v16h8V38" fill="#f4ead3" stroke="#827969" stroke-width="2"/><path d="M12 23q0-13 24-14h23q15 0 15 18v14H19q-12-2-7-18Z" fill="#fbf6e6" stroke="#827969" stroke-width="2"/><path d="M26 10q-6 12 4 19 15 3 14-18m11 15q-9 8-4 15h13q5-9-1-15" fill="#63706a"/><path d="m65 17-8-9m20 9 6-9" stroke="#a39371" stroke-width="3"/><path d="M61 20q10-13 18 0l2 20H59Z" fill="#fcf5e1" stroke="#827969" stroke-width="2"/><ellipse cx="70" cy="38" rx="13" ry="7" fill="#d6ada0" stroke="#a68b78"/><path d="M11 20Q0 17 4 39" fill="none" stroke="#827969" stroke-width="2"/><circle cx="65" cy="24" r="2"/><circle cx="75" cy="24" r="2"/></symbol>
     </defs>
     <path class="paper-land" d="m77 116 66-42 127 18 78-38 144 16 105-15 100 39 137 4 58 76-19 108 27 92-32 99 10 105-68 110-121 33-112-14-99 24-108-25-103 6-109-55-48-87 17-97-30-104 27-94Z"/>
     <path d="m77 116 66-42 127 18 78-38 144 16 105-15 100 39 137 4 58 76-19 108 27 92-32 99 10 105-68 110-121 33-112-14-99 24-108-25-103 6-109-55-48-87 17-97-30-104 27-94Z" fill="url(#grass)" opacity=".65"/>
     <path class="stream" d="M825 120q-120 80-35 150t-15 150q-45 55 28 115t-48 150"/>
     <path class="stream-light" d="M825 120q-120 80-35 150t-15 150q-45 55 28 115t-48 150"/>
     <g class="paths"><path d="M470 240v125q0 35-65 35H270m200 0h230M470 400v140m-30-70q-160-25-210 110m280-110q150-25 200 110"/></g>
     <g fill="#c5b899" opacity=".6">{Array.from({length:14},(_,i)=><ellipse cx={430+(i%3)*32} cy={310+Math.floor(i/3)*35} rx="3" ry="1.5" />)}</g>
     <g aria-hidden="true">{trees.map(([x,y,s])=><use href="#tree" x={x} y={y} width={65*s} height={85*s}/>)}{Array.from({length:38},(_,i)=><use href="#flower" x={100+(i*137)%745} y={110+(i*83)%600} width={12+i%4} height={20+i%5}/>)}</g>
     <g class="square" aria-hidden="true"><ellipse cx="475" cy="403" rx="49" ry="23" fill="#d0c3a1"/><ellipse cx="475" cy="398" rx="38" ry="18" fill="#e6dfc5" stroke="#aa9b78"/><ellipse cx="475" cy="393" rx="27" ry="13" fill="#a7c9d0" stroke="#7f9da2"/><path d="M475 390v-26" stroke="#8c9b8a" stroke-width="7"/><ellipse cx="475" cy="365" rx="15" ry="5" fill="#d9dfca" stroke="#8c9b8a"/><path class="fountain" d="M475 363q-13-26-17 4m17-4q12-25 17 4" stroke="#87b3c1" stroke-width="2" fill="none"/></g>
     {places.filter(p=>p.type!=='backyard').map(p=><g class="place" role="button" tabindex="0" aria-label={`${p.name}: ${p.label}`} data-place={p.id} transform={`translate(${p.x},${p.y})`}>
      <ellipse class="building-shadow" cx="0" cy="79" rx="83" ry="16" fill="#6f7051" opacity=".13"/>
      <g class="building">
       <path d="M-69 4H69v67l-9 10H-69Z" fill="#e7d4ae" stroke="#8c7d61" stroke-width="2"/>
       <path d="M69 4 87-8v70L69 81Z" fill="#c2b28c" stroke="#8c7d61" stroke-width="2"/>
       <path d="m-82 7 22-64H62L78 7Z" fill={p.color} stroke="#6d7564" stroke-width="2"/>
       <path d="m-82 7 22-64H62L78 7Z" fill="url(#roof)"/>
       <path d="m62-57 25 50-9 14Z" fill="#667d7a" stroke="#6d7564" stroke-width="2"/>
       {p.type==='house'&&<><path d="M-35-39v-40h17v40" fill="#c4b292" stroke="#8c7d61" stroke-width="2"/><path class="smoke" d="M-27-88q-14-12 0-24t-2-21" fill="none" stroke="#bcb6a1" stroke-width="6" stroke-linecap="round"/><path d="m-36-4 36-32L36-4" fill="#f4e8cc" stroke="#8c7d61" stroke-width="2"/><circle cx="0" cy="-11" r="8" fill="#bad6d8" stroke="#8c7d61"/></>}
       <path d="M-13 81V30q13-15 26 0v51" fill="#9c8562" stroke="#766548" stroke-width="2"/><circle cx="7" cy="57" r="2" fill="#ede1bd"/>
       <g fill="#bed7d5" stroke="#8c7d61" stroke-width="2"><path d="M-56 25h27v26h-27Zm84 0h27v26H28Z"/><path d="M-42 25v26m-14-13h27m41-13v26M28 38h27"/></g>
       <path d="M-60 60h37m45 0h38" stroke="#9e8964" stroke-width="6"/><g fill="#8fa27b"><circle cx="-51" cy="57" r="5"/><circle cx="-38" cy="57" r="6"/><circle cx="33" cy="57" r="5"/><circle cx="48" cy="57" r="6"/></g>
       {p.type==='workshop'&&<><rect x="-35" y="-38" width="68" height="24" fill="#f4ead3" stroke="#6d7564"/><path d="m-22-20 9-11 5 5-9 11m21-14 14 12m-10-16 10 3-4 8" stroke="#776a4c" stroke-width="3" fill="none"/></>}
       {p.type==='cinema'&&<><rect x="-55" y="-33" width="110" height="26" fill="#f7e8c1" stroke="#8d6c58" stroke-width="2"/><text x="0" y="-15" text-anchor="middle" class="marquee">CINEMA</text><g fill="#edcf84">{[-47,-23,0,23,47].map(x=><circle class="bulb" cx={x} cy="-3" r="2.4"/>)}</g></>}
       {p.type==='newspaper'&&<><path d="M-80 0H78v16H-80Z" fill="#f0e4c8" stroke="#8c7d61"/><path d="M-80 0h20v16h-20m40-16h20v16h-20m40-16h20v16H0m40-16h20v16H40" fill="#7d9ca9"/><rect x="-50" y="26" width="99" height="44" fill="#faf4df" stroke="#9a8a6b"/><text x="0" y="39" text-anchor="middle" class="news">THE DAILY MOAAZ</text><path d="M-40 46h80m-80 7h34m12 0h34m-80 6h34m12 0h34" stroke="#a09a85"/></>}
       {p.type==='post'&&<><rect x="-24" y="-36" width="48" height="29" fill="#f5e8c9" stroke="#716e57"/><path d="m-24-36 24 17 24-17m-48 29 17-18m31 18L7-25" fill="none" stroke="#8b795a"/><rect x="80" y="42" width="21" height="22" rx="3" fill="#b5816c" stroke="#886c54"/><path d="M90 64v20m-5-34h11" stroke="#886c54" stroke-width="3"/></>}
      </g>
      <g class="place-sign"><path d="M-85 90H85v44H-85Z" fill="#fcf6e7" stroke="#bcad8f"/><text x="0" y="108" text-anchor="middle" class="place-name">{p.name}</text><text x="0" y="124" text-anchor="middle" class="place-label">{p.label}</text></g>
     </g>)}
     <g class="yard" transform="translate(470 575)">
      <path d="M-110-28h220v120h-220Z" fill="#c5d0a5" opacity=".6"/>
      <g fill="none" stroke="#ae9975" stroke-width="3"><path d="M-110-24v112m220-112v112M-110-12h220M-110 78h75m70 0h75"/>{[-110,-80,-50,-20,10,40,70,100].map(x=><path d={`M${x}-25v27`}/>)}</g>
      <use href="#cow" class="cow cow-one" x="-90" y="-3" width="75" height="58"/>
      <use href="#cow" class="cow cow-two" x="35" y="5" width="62" height="48"/>
      <g class="chickens"><use href="#chicken" class="chicken chicken-one" x="-65" y="63" width="29" height="31"/><use href="#chicken" class="chicken chicken-two" x="20" y="70" width="25" height="28"/><use href="#chicken" class="chicken chicken-three" x="-8" y="45" width="26" height="29"/></g>
      <g class="feed" opacity="0" fill="#b8974d">{Array.from({length:18},(_,i)=><circle cx={-35+(i*17)%80} cy={42+(i*11)%35} r="2"/>)}</g>
      <g class="chilling" aria-hidden="true"><path d="m-4 9 27 10-13 31-27-10Zm-7 31-6 16m27-6 9 9" fill="#799baa" stroke="#6c7866" stroke-width="3"/><path d="m1 18 15 8-10 14-10-7" fill="#d4b58c"/><image href="/img/avatar-256.png" x="-15" y="-15" width="34" height="34"/></g>
      <g class="place" role="button" tabindex="0" aria-label="The backyard: take a little break" data-place="backyard"><rect x="-85" y="105" width="170" height="44" fill="#fcf6e7" stroke="#bcad8f"/><text x="0" y="123" text-anchor="middle" class="place-name">The backyard</text><text x="0" y="139" text-anchor="middle" class="place-label">Take a little break</text></g>
     </g>
     <g class="walker" transform="translate(475 470)" aria-hidden="true"><ellipse cy="13" rx="11" ry="4" fill="#68725a" opacity=".2"/><path d="m-5 3-3 11m12-11 3 11" stroke="#635a47" stroke-width="4"/><path d="M-7-12H7L9 4H-9Z" fill="#759bab" stroke="#516875"/><image href="/img/avatar-256.png" x="-16" y="-38" width="32" height="32"/></g>
     <g class="map-compass" transform="translate(870 75)" aria-hidden="true"><path d="M0-19V19m-19-19h38m-38 0 19-7 19 7-19 7Z" fill="none" stroke="#9b8c6e"/><text y="-26" text-anchor="middle">N</text></g>
     <text x="480" y="770" text-anchor="middle" class="map-caption">Drawn on paper. Built with a little curiosity.</text>
    </svg>
   </div>
   <aside class="village-notes" aria-labelledby="note-title">
    <div class="note-top"><span class="live-dot"></span><span id="place-caption">You’re in the village square</span></div>
    <h2 id="note-title">Welcome to my<br/>little corner.</h2><p id="note-copy">Take the winding path. Visit a building. There’s work to explore, a story to follow, and a very peaceful backyard.</p>
    <a id="place-link" href="/about/">Start at Moaaz’s house <span>↗</span></a><button id="feed-button" hidden type="button">Feed the chickens <span>♡</span></button>
    <p class="visit-status" role="status" aria-live="polite">Choose a place on the map to look inside.</p>
    <nav aria-label="Village places"><p class="directory-title">Around the village</p>{places.map((p,i)=><button type="button" data-visit={p.id}><span class="directory-number">{String(i+1).padStart(2,'0')}</span><span>{p.name}</span><span class="directory-arrow">↗</span></button>)}</nav>
    <div class="margin-note"><svg viewBox="0 0 60 38" fill="none" aria-hidden="true"><path d="M4 5q4 28 43 20m-10-8 11 8-12 7" stroke="currentColor" stroke-width="1.3"/></svg><span>I’m probably out back.</span></div>
   </aside>
  </div>
  <footer class="village-footer"><span>Made for wandering, at your own pace.</span><span>Click a building · Tab to explore · Enter to visit</span><a href="/">Back to the portfolio ↗</a></footer>
 </div>
 <script define:vars={{places}}>
  const page=document.querySelector('.village-page'),map=document.querySelector('.village-map'),walker=document.querySelector('.walker'),status=document.querySelector('.visit-status'),link=document.querySelector('#place-link'),feed=document.querySelector('#feed-button');
  let active='',timer;
  function visit(id){const p=places.find(p=>p.id===id);if(!p)return;active=id;clearTimeout(timer);document.querySelectorAll('[data-place],[data-visit]').forEach(el=>{const selected=(el.dataset.place||el.dataset.visit)===id;el.classList.toggle('selected',selected);el.setAttribute('aria-pressed',String(selected));});document.querySelector('#place-caption').textContent=p.name;document.querySelector('#note-title').textContent=p.title;document.querySelector('#note-copy').textContent=p.copy;link.hidden=!p.href;feed.hidden=!!p.href;if(p.href){link.href=p.href;link.replaceChildren(document.createTextNode(p.action+' ↗'));}walker.setAttribute('transform',`translate(${p.x} ${p.y+(id==='backyard'?85:153)})`);status.textContent=id==='backyard'?'You found the best spot in the village.':'You’re visiting '+p.name+'.';}
  document.querySelectorAll('[data-place]').forEach(el=>{el.addEventListener('click',()=>visit(el.dataset.place));el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();visit(el.dataset.place);}});});
  document.querySelectorAll('[data-visit]').forEach(el=>el.addEventListener('click',()=>visit(el.dataset.visit)));
  feed.addEventListener('click',()=>{clearTimeout(timer);page.classList.remove('feeding');void page.offsetWidth;page.classList.add('feeding');status.textContent='A little snack. Three very happy chickens.';feed.textContent='Happy chickens! ♡';timer=setTimeout(()=>{page.classList.remove('feeding');feed.textContent='Feed the chickens ♡';},4000);});
  document.querySelector('.motion').addEventListener('click',e=>{const paused=page.classList.toggle('paused');e.currentTarget.setAttribute('aria-pressed',String(paused));e.currentTarget.textContent=paused?'Resume motion':'Pause motion';});
 </script>
</Base>
<style>
 @font-face{font-family:'Village Serif';src:url('/fonts/cormorant-garamond-medium.ttf') format('truetype');font-display:swap}
 .village-page{min-height:100svh;background:#f3eddf url('/img/paper-fibers.svg');color:#514e3f;padding:0 3.5vw;overflow:hidden}.village-header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #bfb49c80;font-size:12px}.village-header a,.village-footer a{color:#535f5c;text-decoration:none}.edition{font-family:'Village Serif',Georgia,serif;font-size:20px;font-style:italic}.motion{border:0;background:none;color:#625d4f;font:inherit;cursor:pointer;padding:10px}.motion:hover{color:#315d6e}.village-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:28px;max-width:1600px;margin:auto;align-items:center}.village-world{position:relative;min-width:0}.map-heading{text-align:center;padding-top:22px;position:relative;z-index:1}.map-heading h1{font:500 clamp(30px,3.4vw,53px)/1.1 'Village Serif',Georgia,serif;letter-spacing:-.025em;margin:0 0 8px}.map-heading p{font-size:11px;margin:0;color:#736d5c}.village-map{width:100%;display:block;margin-top:-10px;max-height:calc(100svh - 185px);min-height:500px;overflow:visible}.paper-land{fill:#e4e4cd;stroke:#c6c7ae;stroke-width:2;filter:drop-shadow(4px 9px 5px #7161431a)}.stream{fill:none;stroke:#aecbd0;stroke-width:30;stroke-linecap:round}.stream-light{fill:none;stroke:#e5eeea;stroke-width:2;stroke-dasharray:12 35;opacity:.8}.paths{fill:none;stroke:#d4c6a5;stroke-width:30;stroke-linecap:round;stroke-linejoin:round}.paths path{paint-order:stroke;filter:drop-shadow(0 2px 0 #c3b694)}.place{cursor:pointer;outline:none}.place .building{transition:translate .22s ease}.place:hover .building,.place:focus-visible .building,.place.selected .building{translate:0 -7px}.place:hover .place-sign path,.place:focus-visible .place-sign path,.place.selected .place-sign path{fill:#fffcf2;stroke:#557a85;stroke-width:2}.place:focus-visible>rect,.place.selected>rect{stroke:#557a85;stroke-width:2}.place-name{font:500 17px 'Village Serif',Georgia,serif;fill:#454c42}.place-label{font:9px 'Manrope',sans-serif;fill:#6d6c58}.marquee{font:11px 'Manrope',sans-serif;letter-spacing:2px;fill:#805c47}.news{font:bold 7px Georgia,serif;fill:#5f6557}.map-caption{font:italic 15px 'Village Serif',Georgia,serif;fill:#8a816d}.map-compass text{font:12px 'Village Serif',Georgia,serif;fill:#8a816d}.walker{transition:transform 1.7s cubic-bezier(.3,0,.2,1);pointer-events:none}.smoke{animation:smoke 4s ease-in-out infinite;transform-origin:-27px -80px}.chicken{animation:peck 3s ease-in-out infinite;transform-box:fill-box;transform-origin:center bottom}.chicken-two{animation-delay:-1.5s}.chicken-three{animation-delay:-.7s}.cow{animation:sway 6s ease-in-out infinite;transform-box:fill-box;transform-origin:center bottom}.cow-two{animation-delay:-3s}.bulb{animation:twinkle 3s ease-in-out infinite}.fountain{animation:twinkle 2s ease-in-out infinite}.feed{transition:opacity .5s}.feeding .feed{opacity:1}.feeding .chicken{animation-duration:.65s}.paused *{animation-play-state:paused!important}.paused .walker{transition:none}.village-notes{align-self:center;padding:30px 0 22px 25px;border-left:1px solid #bfb49c80}.note-top{display:flex;align-items:center;gap:7px;font-size:10px;color:#75705e}.live-dot{width:6px;height:6px;background:#81936e;border-radius:50%;flex:none}.village-notes h2{font:500 38px/1.04 'Village Serif',Georgia,serif;margin:22px 0 17px;letter-spacing:-.025em}.village-notes>p:not(.visit-status){font-size:12px;line-height:1.9;color:#706b5b;margin-bottom:23px}#place-link,#feed-button{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#426e7e;border:0;border-bottom:1px solid #94a6a3;padding:9px 0;font:12px 'Manrope',sans-serif;text-decoration:none;background:none;cursor:pointer;width:100%}[hidden]{display:none!important}.visit-status{font-size:10px;line-height:1.7;color:#77715f;min-height:34px;margin-top:15px}.directory-title{font:italic 20px 'Village Serif',Georgia,serif;margin:28px 0 12px}.village-notes nav button{display:flex;align-items:center;gap:11px;