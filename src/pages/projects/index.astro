---
import Base from '../../layouts/Base.astro';
import { PROJECTS } from '../../data/site';
const featured=PROJECTS.find(p=>p.slug==='ecommerce-clv-churn')!;
const descriptions:Record<string,{title:string;kind:string;body:string;output:string}>={
 'hr-attrition-analysis':{title:'Where should HR focus its retention efforts?',kind:'HR analytics · Case study',body:'Exploring employee attrition across roles, overtime, and experience, and turning the findings into a practical retention briefing.',output:'Power BI · DAX · SQL · Python'},
 'analytics-agent':{title:'From a dataset to a report you can inspect',kind:'AI tooling',body:'An analytics assistant that works through tools and checks its report before writing it.',output:'Python tool loop · Charts · Report validation'},
 'ai-tell':{title:'A closer look at document authorship',kind:'Desktop application',body:'A desktop tool that brings document metadata and writing signals together for closer inspection.',output:'Document analysis · Authorship signals · Desktop interface'},
 'ab-test':{title:'Is the difference worth trusting?',kind:'Statistical analysis',body:'An A/B testing project that makes hypotheses, confidence intervals, and statistical comparisons explicit.',output:'Hypothesis testing · Confidence intervals'},
 'analytics-projects':{title:'Making the numbers easier to explore',kind:'Dashboard collection',body:'Power BI and Tableau work across retail, manufacturing, and housing datasets.',output:'Interactive dashboards · Visual analysis'},
 'sql-for-business-analytics':{title:'Finding answers in imperfect data',kind:'SQL analysis',body:'Querying, exploring, and cleaning data across the Chinook, COVID-19, and Nashville housing datasets.',output:'Data cleaning · Joins · Window functions'},
  'co2-emissions':{title:'How do emissions compare across countries?',kind:'Data visualization',body:'Per capita and total CO2 emissions for 20 countries in 2020, with year-by-year trends from 2000 to 2020.',output:'Python · Our World in Data · Radial charts'},
 };
---
<Base title="Projects" description="Moaaz Magdy’s projects in data analysis, dashboards, and practical tools." hideFooter>
 <div class="stamp-entrance" aria-label="Opening project collection">
  <div class="stamp-frame"><img src="/img/project-stamp.webp" width="780" height="1010" alt="Vintage French tapestry stamp showing a lady and a unicorn" fetchpriority="high" /></div>
  <button type="button" class="skip-entrance">Skip intro</button>
 </div>
 <div class="project-collection">
  <header class="collection-intro">
   <p class="eyebrow">A working archive</p>
   <h1>Projects that turn messy questions into useful next steps.</h1>
   <p class="intro-copy">A considered collection of analysis, dashboards, and tools built to make decisions easier to inspect.</p>
   <a class="intro-cta" href="/contact/">Talk through a project <span aria-hidden="true">↗</span></a>
   <img class="sheet-stamp" src="/img/project-stamp.webp" width="780" height="1010" alt="" aria-hidden="true" />
  </header>
  <section class="project-index" aria-label="Project collection">
  {[featured,...PROJECTS.filter(p=>p.slug!==featured.slug)].map((p,index)=>{const copy=p.slug===featured.slug?{title:'Which customers should we focus on?',kind:'Customer analytics',body:'Customer value and churn risk, turned into retention priorities.',output:'Python · Customer analytics'}:descriptions[p.slug];return <article class="project-entry">
    <div class="entry-type"><span class="entry-number">{String(index+1).padStart(2,'0')}</span><p>{copy.kind}</p><span>{copy.output}</span></div>
    <div class="entry-copy"><h2><a href={`/projects/${p.slug}/`}>{copy.title}</a></h2><p>{copy.body}</p><div class="entry-links"><a href={`/projects/${p.slug}/`}>Explore project ↗</a><a href={p.repo} target="_blank" rel="noopener noreferrer">Code ↗</a></div></div>
   </article>})}
  </section>
  <footer class="collection-close"><div><p class="eyebrow">Have a question about the work?</p><h2>Let’s find the useful question.</h2></div><a class="close-cta" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></footer>
 </div>
</Base>
<script>
 const entrance=document.querySelector<HTMLElement>('.stamp-entrance')!;
 const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let finished=false;
 function finish(){if(finished)return;finished=true;entrance.classList.add('finished');document.querySelector('.project-collection')?.classList.add('arrived');setTimeout(()=>entrance.remove(),550)}
 entrance.querySelector('button')?.addEventListener('click',finish);
 if(reduce)finish();else{entrance.classList.add('playing');setTimeout(finish,1450)}
</script>
<style>
 :global(body:has(.project-collection)){background:#faf8f3 url('/img/paper-fibers.svg');color:#302f29}
 .project-collection{position:relative;max-width:900px;margin:44px auto 80px;padding:66px 60px 55px;background:#f5f1e7 url('/img/paper-fibers.svg');box-shadow:0 20px 70px #40352509;font-family:'Zodiak',Georgia,serif;isolation:isolate}
 .project-collection::before,.project-collection::after{content:'';position:absolute;inset:12px 5px -8px;background:#eee9de url('/img/paper-fibers.svg');z-index:-1;transform:rotate(-1.3deg);transform-origin:50% 100%}
 .project-collection::after{inset:0;background:#f5f1e7 url('/img/paper-fibers.svg');transform:none}
 .collection-intro{position:relative;min-height:390px;padding:18px 130px 0 0}
 .eyebrow{font:600 11px/1.5 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.13em;color:#756650;margin:0 0 22px}
 h1{font:400 clamp(3rem,6vw,5.5rem)/1.02 'Zodiak',Georgia,serif;letter-spacing:-.045em;margin:0 0 28px;max-width:680px;text-wrap:balance}
 .intro-copy{max-width:380px;font-size:15px;line-height:1.75;margin:0;color:#5c554a;text-wrap:pretty}
 .intro-cta{display:inline-flex;align-items:center;gap:12px;margin-top:30px;padding:10px 0;border-bottom:1px solid #756650;font:600 13px/1.5 system-ui,sans-serif;text-decoration:none;transition:gap .6s cubic-bezier(.32,.72,0,1),color .6s cubic-bezier(.32,.72,0,1)}
 .intro-cta:hover{gap:18px;color:#426b7d}
 .sheet-stamp{position:absolute;right:0;top:6px;width:78px;height:auto;transform:rotate(8deg);filter:drop-shadow(3px 6px 4px #35281725);transition:transform .65s cubic-bezier(.16,1,.3,1)}
 .sheet-stamp:hover{transform:rotate(-4deg) translateY(-5px)}
 .project-index{padding-left:55px}
 .project-entry{display:grid;grid-template-columns:190px 1fr;gap:36px;padding:42px 0 45px;border-bottom:1px solid #a79c8235;transition:transform .6s cubic-bezier(.32,.72,0,1),background-color .6s cubic-bezier(.32,.72,0,1)}
 .project-entry:hover{transform:translateX(6px)}
 .entry-type p{font-size:11px;line-height:1.7;margin:14px 0 10px;color:#665c4d;text-transform:uppercase;letter-spacing:.05em}
 .entry-number{display:block;font:400 12px/1 'Zodiak',Georgia,serif;color:#426b7d}
 .entry-type span{display:block;font:400 10px/1.7 system-ui,sans-serif;color:#756c5e;max-width:170px}
 h2{font:400 28px/1.2 'Zodiak',Georgia,serif;margin:0 0 12px;text-wrap:balance;letter-spacing:-.02em}
 a{color:inherit;text-underline-offset:5px}h2 a{text-decoration:none}
 .entry-copy>p{font:400 13px/1.8 'Zodiak',Georgia,serif;margin:0;color:#5c554a}
 .entry-links{display:flex;gap:24px;margin-top:22px;font:600 11px/1.6 system-ui,sans-serif}
 .entry-links a:first-child{text-decoration:underline;text-underline-offset:5px}
 a:focus-visible,button:focus-visible{outline:2px solid #426b7d;outline-offset:6px}
 .collection-close{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:70px 0 0}
 .collection-close .eyebrow{margin-bottom:10px}.collection-close h2{font-size:32px;margin:0;max-width:320px}
 .close-cta{display:inline-flex;align-items:center;gap:12px;background:#426b7d;color:#f8f4ea;padding:12px 16px;border-radius:4px;font:600 12px/1.5 system-ui,sans-serif;text-decoration:none;transition:transform .6s cubic-bezier(.32,.72,0,1),background-color .6s cubic-bezier(.32,.72,0,1)}
 .close-cta:hover{background:#31596d;transform:translateY(-3px)}
 .stamp-entrance{position:fixed;inset:0;z-index:1000;display:none;place-items:center;background:#faf8f3 url('/img/paper-fibers.svg');transition:opacity .5s,visibility .5s;pointer-events:none}
 .stamp-entrance.playing{display:grid;pointer-events:auto}
 .stamp-frame{width:clamp(140px,18vw,220px);filter:drop-shadow(5px 16px 12px #38281c30);animation:stamp-arrive 1.4s cubic-bezier(.16,1,.3,1) both}
 .stamp-frame img{display:block;width:100%;height:auto}
 .skip-entrance{position:absolute;bottom:38px;right:40px;background:none;border:0;font:400 12px/1.5 'Zodiak',Georgia,serif;color:#544b3f;cursor:pointer;text-decoration:underline;text-underline-offset:5px}
 .stamp-entrance.finished{opacity:0;visibility:hidden;pointer-events:none}
 .project-collection.arrived{animation:paper-enter .9s cubic-bezier(.16,1,.3,1) both}
 @keyframes stamp-arrive{0%{opacity:0;transform:translateY(-35px) rotate(-15deg) scale(1.15)}35%,75%{opacity:1;transform:translateY(0) rotate(5deg) scale(1)}100%{opacity:0;transform:translateY(15px) rotate(8deg) scale(.9)}}
 @keyframes paper-enter{from{clip-path:inset(0 0 12%);transform:translateY(28px);opacity:.4}to{clip-path:inset(0 0 0);transform:none;opacity:1}}
 @media(max-width:1000px){.project-collection{margin:30px 24px 60px;padding:50px 40px}.project-index{padding-left:0}.project-entry{grid-template-columns:150px 1fr;gap:25px}}
 @media(max-width:600px){.project-collection{margin:12px 12px 40px;padding:35px 24px}.collection-intro{min-height:330px;padding-right:70px}.eyebrow{font-size:10px;margin-bottom:16px}h1{font-size:44px}.sheet-stamp{width:51px}.intro-copy{font-size:14px}.intro-cta{margin-top:22px}.project-entry{grid-template-columns:1fr;gap:15px;padding:30px 0}.entry-type span{max-width:none}.entry-type p{margin:10px 0 4px}h2{font-size:24px}.entry-links{margin-top:18px}.collection-close{display:block;padding-top:50px}.collection-close h2{font-size:28px}.close-cta{margin-top:24px}}
 @media(prefers-reduced-motion:reduce){.stamp-entrance{display:none!important}.project-collection.arrived,.stamp-frame{animation:none}.project-entry,.sheet-stamp{transition:none}.project-entry:hover{transform:none}}
</style>
