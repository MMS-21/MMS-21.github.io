---
import { DASHBOARDS, dashboardPageUrl } from '../../../data/dashboards';
export function getStaticPaths() {
  return DASHBOARDS.map((dashboard) => ({
    params: { dashboard: dashboard.slug === 'co2-emissions' ? 'co2-per-capita-2020' : dashboard.slug },
    props: { destination: dashboardPageUrl(dashboard) },
  }));
}
const { destination } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>Project moved</title>
  </head>
  <body>
    <p>Dashboard moved. <a href={destination}>View the independent project page</a>.</p>
  </body>
</html>
