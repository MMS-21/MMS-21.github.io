---
import Base from '../../layouts/Base.astro';
import { PROJECTS } from '../../data/site';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Base title={project.name} description={project.tagline}>
  <div class="wrap">
    <article class="prose">
      <p class="eyebrow"><a href="/projects/">Projects</a></p>
      <h1>{project.name}</h1>
      <p class="lede">{project.tagline}</p>

      <ul class="tag-row" style="margin: 1.25rem 0 2rem;">
        {project.stack.map((s) => <li class="tag">{s}</li>)}
      </ul>

      <h2>The problem</h2>
      <p>{project.problem}</p>

      <h2>Approach</h2>
      <ul>
        {project.approach.map((a) => <li>{a}</li>)}
      </ul>

      <h2>Result</h2>
      <p>{project.result}</p>

      <h2>Source</h2>
      <p>
        <a href={project.repo} rel="noopener">{project.repo.replace('https://github.com/', 'github.com/')}</a>
      </p>

      <p class="cta-row">
        <a class="btn" href="/projects/">← All projects</a>
      </p>
    </article>
  </div>
</Base>
