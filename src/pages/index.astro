---
import Base from '../layouts/Base.astro';
import { SITE, BIO_LEAD, BIO_DETAIL, FEATURED } from '../data/site';

const NAV = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<Base hideHeader>
  <div class="wrap">
    <section class="hero">
      <nav class="hero-nav" aria-label="Main">
        {
          NAV.map((item) => (
            <a class="hero-nav-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hero-art">
        <svg class="ink-sketch" viewBox="0 0 640 180" fill="none" aria-hidden="true" focusable="false">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- A loose notebook: observations become a direction. -->
            <path fill="var(--accent-soft)" d="M39 40 164 29 179 141 54 152Z" />
            <path d="m51 47 101-9 12 91-101 10Z M57 30l11 121 M80 51l54-5 M82 60l32-3" />
            <path d="m83 115-3-32 m3 32 62-6 M96 111l-1-15 m17 13-2-29 m20 27-3-41" />
            <path class="draw-line" pathLength="1" d="m85 96 19-16 14 5 23-23" />
            <path d="m135 62 7-1-1 8 M30 126l-7 10 m10-6-9-3 M176 45l8-8 m-4 15 12-2" />
            <path class="draw-line connection" pathLength="1" d="M188 100c27 23 46 22 68 4 m-10-2 11 1-4 10" />
            <!-- A hand-held lens: inspect the output before trusting it. -->
            <path fill="var(--accent-soft)" d="m471 32 103 8-7 104-103-9Z" />
            <path d="m487 49 66 5 m-67 8 40 3 m-43 48 23 2 m-24 10 31 2" />
            <circle cx="544" cy="91" r="27" fill="var(--bg)" />
            <circle cx="544" cy="91" r="21" />
            <path class="draw-line check-mark" pathLength="1" d="m533 91 8 8 15-17" />
            <path d="m563 112 24 28c5 6 14-2 9-8l-26-28 M587 150c-10 12-23 16-39 12 m-83-12-11 5 m8-14-10-2 M583 54l7-10 m1 19 12-2" />
            <path class="draw-line connection" pathLength="1" d="M384 107c22-17 40-15 65 1 m-6-9 7 10-12 2" />
          </g>
        </svg>
      <picture>
        <img
          class="avatar"
          src="/img/avatar.png"
          srcset="/img/avatar.png 1x, /img/avatar-256.png 2x, /img/avatar-384.png 3x"
          width="128"
          height="128"
          alt=""
          decoding="async"
        />
      </picture>
      </div>

      <h1 class="hero-name">{SITE.name}</h1>
      <p class="hero-role">{SITE.role} <span aria-hidden="true">·</span> {SITE.location}</p>
      <div class="bio-intro">
        <div class="margin-note" aria-hidden="true">
          <span>Start with the question.</span>
          <svg viewBox="0 0 64 44" fill="none" focusable="false"><path d="M5 5c29-8 46 4 39 27m-8-7 7 9 12-5" /></svg>
        </div>
        <p class="bio-lead">{BIO_LEAD}</p>
        <svg class="pencil-mark" viewBox="0 0 300 12" aria-hidden="true" focusable="false"><path d="M3 8c65-7 165-7 293-3M35 11c57-4 117-4 194-3" /></svg>
        <p class="hero-lede">{BIO_DETAIL}</p>
      </div>
      <div class="hero-actions">
        <a href="/projects/">Explore my work <span aria-hidden="true">→</span></a>
        <a href="/about/">About me</a>
      </div>
    </section>

    <section>
      <h2>Featured work</h2>
      <p>
        Three projects that show the same thing from different angles: customer
        analytics that ends in an action, and AI tooling built to be verified.
      </p>
      <div class="project-grid">
        {
          FEATURED.map((p) => (
            <article class="card">
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.name}</a>
              </h3>
              <p>{p.tagline}</p>
              <ul class="tag-row">
                {p.stack.slice(0, 4).map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 1rem;">
        <a href="/projects/">All projects →</a>
      </p>
    </section>

    <section>
      <h2>How I work</h2>
      <p>
        The parts I care about are the parts nobody screenshots: tests that pass
        without an API key, prompts derived from the data instead of hardcoded,
        output validated before it is written, and honest reporting when a method
        does not work.
      </p>
      <p>
        I write about what I build, including what broke.
        <a href="/writing/">Read the write-ups →</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .bio-intro { max-width: 29rem; margin: 1.5rem auto 0; }
  .margin-note { display: flex; align-items: center; justify-content: flex-end; gap: .4rem; color: var(--accent); margin-bottom: .1rem; }
  .margin-note span { font-family: "Segoe Print", "Bradley Hand", cursive; font-size: .9375rem; transform: rotate(-4deg); }
  .margin-note svg { width: 48px; height: 33px; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .bio-lead { font-size: clamp(1.35rem, 3.5vw, 1.65rem); font-weight: 600; line-height: 1.4; letter-spacing: -.02em; text-wrap: balance; margin: 0; }
  .pencil-mark { display: block; width: 65%; height: 12px; margin: .25rem auto 1rem; fill: none; stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.35rem; font-size: .9375rem; }
  .hero-actions a:first-child { font-weight: 650; }
  .hero-art {
    position: relative;
    max-width: 40rem;
    height: 180px;
    margin: 0 auto 1.5rem;
    display: grid;
    place-items: center;
  }

  .ink-sketch {
    position: absolute;
    width: 100%;
    height: 100%;
    color: var(--fg);
    pointer-events: none;
  }

  .hero-art picture { position: relative; }
  .hero-art .avatar { margin: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .draw-line {
      stroke-dasharray: 1;
      animation: ink-arrives 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .connection { animation-delay: 140ms; }
    .check-mark { animation-delay: 280ms; }
    .hero-nav-link { transition: color 160ms ease, border-color 160ms ease; }
    @keyframes ink-arrives {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }
  }

  @media (max-width: 480px) {
    .hero-art { height: 130px; margin-bottom: 1.25rem; }
    .hero-art .avatar { width: 96px; height: 96px; }
    .hero-nav { gap: 0.4rem 1.2rem; }
  }

  .hero {
    text-align: center;
    padding: 1.75rem 0 2rem;
    margin-bottom: 0;
    border-bottom: 1px solid var(--border);
  }

  /* Borderless nav links sit above the portrait. */
  .hero-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin-bottom: 2.5rem;
  }

  .hero-nav-link {
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.35rem 0.15rem;
    border-bottom: 1px solid transparent;
  }

  .hero-nav-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .avatar {
    display: block;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    /* The source avatar has a white background; matching it to the page keeps
       the circular crop from showing a white disc on warm off-white. */
    background: var(--bg);
    object-fit: cover;
  }

  .hero-name {
    margin: 0 0 0.35rem;
    font-size: clamp(1.65rem, 5vw, 2rem);
    letter-spacing: -0.02em;
  }

  .hero-role {
    margin: 0 auto 0.35rem;
    max-width: none;
    font-size: .9375rem;
    color: var(--muted);
    font-weight: 400;
  }

  .hero-location {
    margin: 0 auto 1.5rem;
    max-width: none;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .hero-lede {
    margin: 0 auto;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
</style>
