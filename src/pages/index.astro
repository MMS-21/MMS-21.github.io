---
import Base from '../layouts/Base.astro';
import { SITE, BIO_SHORT, FEATURED } from '../data/site';

const NAV = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<Base hideHeader>
  <div class="wrap">
    <section class="hero">
      <nav class="hero-nav" aria-label="Main">
        {
          NAV.map((item) => (
            <a class="hero-nav-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <picture>
        <img
          class="avatar"
          src="/img/avatar.png"
          srcset="/img/avatar-192.png 2x"
          width="128"
          height="128"
          alt=""
          decoding="async"
        />
      </picture>

      <h1 class="hero-name">{SITE.name}</h1>
      <p class="hero-role">{SITE.role}</p>
      <p class="hero-location">{SITE.location}</p>
      <p class="hero-lede">{BIO_SHORT}</p>
    </section>

    <section>
      <h2>Featured work</h2>
      <p>
        Three projects that show the same thing from different angles: customer
        analytics that ends in an action, and AI tooling built to be verified.
      </p>
      <div class="project-grid">
        {
          FEATURED.map((p) => (
            <article class="card">
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.name}</a>
              </h3>
              <p>{p.tagline}</p>
              <ul class="tag-row">
                {p.stack.slice(0, 4).map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 1rem;">
        <a href="/projects/">All projects →</a>
      </p>
    </section>

    <section>
      <h2>How I work</h2>
      <p>
        The parts I care about are the parts nobody screenshots: tests that pass
        without an API key, prompts derived from the data instead of hardcoded,
        output validated before it is written, and honest reporting when a method
        does not work.
      </p>
      <p>
        I write about what I build, including what broke.
        <a href="/writing/">Read the write-ups →</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 2.5rem 0 3rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* Borderless nav links sit above the portrait. */
  .hero-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin-bottom: 2.5rem;
  }

  .hero-nav-link {
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.35rem 0.15rem;
    border-bottom: 1px solid transparent;
  }

  .hero-nav-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .avatar {
    display: block;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    /* The source avatar has a white background; matching it to the page keeps
       the circular crop from showing a white disc on warm off-white. */
    background: var(--bg);
    object-fit: cover;
  }

  .hero-name {
    margin: 0 0 0.35rem;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    letter-spacing: -0.02em;
  }

  .hero-role {
    margin: 0 0 0.35rem;
    font-size: 1.125rem;
    color: var(--fg);
    font-weight: 500;
  }

  .hero-location {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .hero-lede {
    margin: 0 auto;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
</style>
