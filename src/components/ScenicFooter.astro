---
const video = 'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260901_122529_931c22c8-8d2d-47c0-ad51-b97f56a91e42.mp4';
const poster = 'https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/4f690bd1-881a-4192-82f2-d714d34c8fb9.png';
---

<div class="contact-landscape footer-media" aria-hidden="true" style={`--landscape-poster:url('${poster}')`}>
  <video class="footer-bg" autoplay muted loop playsinline preload="auto" poster={poster} width="1920" height="1080" tabindex="-1" disablepictureinpicture>
    <source src={video} type="video/mp4" media="(prefers-reduced-motion: no-preference)" />
  </video>
</div>

<style>
.contact-landscape {
  position:relative;
  width:100%;
  aspect-ratio:16/9;
  flex-shrink:0;
  margin-top:clamp(-440px,-28vw,-120px);
  pointer-events:none;
  /* Whiten the source paper, then let the site's actual paper show through it.
     The ink and every animated frame remain visible. */
  filter:brightness(1.14);
  mix-blend-mode:multiply;
}
.footer-bg { display:block; width:100%; height:100%; object-fit:contain; object-position:center bottom; }
@media(max-width:700px) { .contact-landscape { margin-top:-32px; } }
@media(prefers-reduced-motion:reduce) {
 .footer-bg { display:none; }
 .contact-landscape { background:var(--landscape-poster) center bottom/contain no-repeat; }
}
</style>
