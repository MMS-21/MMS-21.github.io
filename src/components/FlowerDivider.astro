---
interface Props { variant?: number }
const {variant=0}=Astro.props;
---
<div class="flower-divider" aria-hidden="true" data-variant={variant}>
 <span class="divider-rule"></span><canvas></canvas>
</div>
<script>
 import { startGardens } from '../scripts/divider-garden.js';
 startGardens();
</script>
<style>
 .flower-divider{position:absolute;top:-80px;left:0;right:0;height:240px;pointer-events:none}
 .divider-rule{position:absolute;top:80px;left:0;right:0;height:1px;background:#d5c9b4}
 canvas{position:absolute;inset:0;width:100%;height:240px}
</style>
