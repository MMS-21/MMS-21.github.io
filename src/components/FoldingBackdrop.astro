<div class="folding-backdrop" aria-hidden="true">{Array.from({length:24},(_,i)=><div class="fold-piece" style={`--paper-tone:${i%3===0?'.09':'.025'}`}><div class="fold-panel fold-root"><span></span><div class="fold-panel fold-middle"><span></span><div class="fold-panel fold-end"><span></span></div></div></div></div>)}</div>
<script>
 const backdrop=document.querySelector<HTMLElement>('.folding-backdrop')!;
 const pieces=[...backdrop.querySelectorAll<HTMLElement>('.fold-piece')];
 const sections=['hero-story','featured-work','about','connect'].map(id=>document.getElementById(id)!);
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');let raf=0,lastSection=-1,started=0,from=0,assembly=0;
 const clamp=(n:number)=>Math.max(0,Math.min(1,n));const ease=(n:number)=>{n=clamp(n);return n*n*(3-2*n)};
 function draw(now=performance.now()){raf=0;const h=innerHeight,w=innerWidth;const section=scrollY<h*.45?-1:sections.reduce((best,el,i)=>Math.abs(el.getBoundingClientRect().top)<Math.abs(sections[best].getBoundingClientRect().top)?i:best,0);if(section!==lastSection){lastSection=section;started=now;from=assembly;}const elapsed=now-started;const collapse=1100,unfold=3000;
 assembly=reduced.matches?1:elapsed<collapse?from*(1-ease(elapsed/collapse)):ease((elapsed-collapse)/unfold);
 const visibility=section<0?0:1;backdrop.style.opacity=String(visibility*.78);backdrop.hidden=visibility===0;
 pieces.forEach((piece,i)=>{const seed=(i*37%31)/31;const p=reduced.matches?1:ease((assembly-seed*.09)/.91);const open=reduced.matches?1:ease((p-.15)/.85);const col=i%4,row=Math.floor(i/4),pw=w*.29,ph=h*.215;const x=(col-1.5)*w*.255-pw/2,y=(row-2.5)*h*.175-ph/2;const angle=i*2.39996;const sx=Math.cos(angle)*w*.75-pw/2,sy=Math.sin(angle)*h*.8-ph/2;piece.style.width=`${pw}px`;piece.style.height=`${ph}px`;piece.style.transform=`translate3d(${sx+(x-sx)*p}px,${sy+(y-sy)*p}px,${(1-p)*150}px) rotateZ(${((i*53%70)-35)*(1-p)+(i%2?1:-1)*1.2*p}deg)`;const panels=piece.querySelectorAll<HTMLElement>('.fold-panel');panels[0].style.transform=`rotateX(${(1-open)*-25}deg)`;panels[1].style.transform=`rotateX(${(1-open)*148}deg)`;panels[2].style.transform=`rotateX(${(1-open)*-152}deg)`; });if(!reduced.matches&&section>=0&&elapsed<collapse+unfold+50)raf=requestAnimationFrame(draw);}
 const schedule=()=>{if(!raf)raf=requestAnimationFrame(draw)};addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);reduced.addEventListener('change',schedule);draw();
</script>
<style is:global>
.folding-backdrop{position:fixed;inset:0;z-index:-2;pointer-events:none;perspective:1400px;overflow:clip}.folding-backdrop[hidden]{display:none}.fold-piece{position:absolute;left:50%;top:50%;transform-style:preserve-3d;filter:drop-shadow(2px 6px 5px #69553614);will-change:transform}.fold-panel{position:absolute;left:0;top:100%;width:100%;height:100%;transform-origin:50% 0;transform-style:preserve-3d}.fold-root{top:0;height:33.34%}.fold-panel>span{display:block;position:absolute;inset:0;background:linear-gradient(rgba(142,119,74,var(--paper-tone)),rgba(142,119,74,var(--paper-tone))),url('/img/folding-paper-texture.webp') center/420px auto;clip-path:polygon(1% 3%,8% 0,19% 2%,31% 0,46% 2%,62% 0,77% 2%,98% 0,100% 15%,98% 46%,100% 75%,99% 98%,85% 100%,68% 98%,48% 100%,29% 98%,10% 100%,0 96%,2% 70%,0 45%,2% 18%);box-shadow:inset 0 2px 3px #74634417,0 2px 0 #cfc4ae;backface-visibility:visible}.fold-middle>span{background-position:center,center 33%}.fold-end>span{background-position:center,center 66%}
</style>
