---
import { SITE } from '../data/site';
---
<div class="hero-introduction" aria-labelledby="hero-introduction-title">
 <h1 id="hero-introduction-title">{SITE.name}</h1>
 <p class="introduction-role">Data &amp; Business Analyst / Cairo</p>
 <div class="introduction-note">
  <p class="introduction-copy">I work in business analytics and operations, from understanding customers to improving everyday processes. I create dashboards, automate reporting, and build and use AI tools to support that work.</p>
 </div>
 <div class="introduction-actions"><a href="/projects/">Explore my work</a><a href="/contact/">Get in touch</a></div>
</div>
<style>
.hero-introduction{width:100%;max-width:1000px;margin:auto;display:flex;flex-direction:column;align-items:center;text-align:center;color:#302f29}
h1{margin:0;font:400 clamp(70px,11vw,156px)/1.1 Astoria,system-ui,sans-serif;letter-spacing:-.025em;text-wrap:balance}
.introduction-role{margin:22px 0 34px;font:400 16px/1.5 'Segoe UI',Arial,sans-serif;color:#45423c}
.introduction-note{--stamp-enter:1;position:relative;max-width:680px;padding:32px 40px;background:#f7f5ed url('/img/soft-paper.svg');box-shadow:5px 14px 28px #443b2420;transform:translate3d(calc((1 - var(--stamp-enter))*100px + var(--note-x,0px)),calc((1 - var(--stamp-enter))*65px + var(--note-y,0px)),0) rotate(calc(9deg - var(--stamp-enter)*11deg));opacity:var(--stamp-enter);transition:transform 200ms ease-out;will-change:transform}
.introduction-copy{margin:0;font:400 16px/1.8 'Segoe UI',Arial,sans-serif;color:#45423c;text-wrap:pretty}
.introduction-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 36px;margin-top:38px}
.introduction-actions a{display:flex;align-items:center;min-height:44px;font:400 16px/1.4 'Segoe UI',Arial,sans-serif;color:#514c45;border-bottom:1px solid #79613e;text-decoration:none}
.introduction-actions a:hover{color:#705832}.introduction-actions a:focus-visible{outline:2px solid #79613e;outline-offset:5px}
@media(max-width:700px){h1{font-size:clamp(56px,14vw,92px)}.introduction-role{font-size:14px}.introduction-note{padding:26px 24px}.introduction-copy{font-size:15px}.introduction-actions{gap:16px 24px}}
@media(prefers-reduced-motion:reduce){.introduction-note{transform:none;opacity:1;visibility:visible!important;transition:none;will-change:auto}}
</style>