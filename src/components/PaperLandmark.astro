---
<div class="paper-landmark" set:html={drawings[index%drawings.length]} aria-hidden="true"></div>
<style>.paper-landmark{position:absolute;inset:14%;display:flex;align-items:center;justify-content:center;color:#8b7049;opacity:.26;pointer-events:none}.paper-landmark :global(svg){width:100%;height:100%;max-height:260px}.paper-landmark :global(text){font-family:'Cormorant Garamond',Georgia,serif;font-size:24px;font-style:italic;fill:currentColor}</style>
