---
import FloralAccent from './FloralAccent.astro';
---
<section class="contact-section" id="connect" tabindex="-1" aria-labelledby="contact-heading">
<a class="desk-invitation" href="/contact/">
<svg viewBox="0 0 120 90" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 28 92-8 5 57-92 8z M13 29l49 30 42-38 M18 82l30-34 M108 75 77 45 M39 17l-3-9 M64 12l2-10 M87 13l7-8"/></g></svg>
<div class="invitation-garden"><h2 id="contact-heading">Leave a note on my desk.</h2><FloralAccent /></div>
<p>A role, a project, or just a little hello.</p>
<span class="invitation-link">Write to Moaaz <span aria-hidden="true">↗</span></span>
</a>
</section>
<style>
.contact-section{position:relative;min-height:65svh;padding:90px 70px 100px 185px;display:flex;align-items:center;justify-content:center;background:#faf6ecf2;border-top:1px solid #d7cab1}.desk-invitation{display:block;text-align:center;color:#342f26;text-decoration:none;padding:20px}.desk-invitation>svg{width:100px;height:80px;color:#79613e;transform:rotate(-6deg);transition:transform 600ms cubic-bezier(.2,.8,.2,1)}h2{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:500;line-height:1.1;margin:25px 0 18px}p{color:#685b47;font-size:.95rem;line-height:1.8;margin:0 0 28px}.invitation-link{display:inline-block;font-size:.9rem;border-bottom:1px solid #79613e;padding:8px 0}.invitation-link span{display:inline-block;margin-left:10px;transition:transform 400ms}.desk-invitation:hover>svg{transform:rotate(3deg) translateY(-8px)}.desk-invitation:hover .invitation-link span{transform:translate(3px,-3px)}.desk-invitation:focus-visible{outline:2px solid #79613e;outline-offset:8px}@media(max-width:700px){.contact-section{padding:75px 35px;min-height:55svh}}@media(prefers-reduced-motion:reduce){.desk-invitation>svg,.invitation-link span{transition:none}}
.invitation-garden{position:relative;margin:65px 0 55px}.invitation-garden h2{position:relative;z-index:1;margin:0}.invitation-garden :global(.floral-accent){top:calc(50% - 100px)}
</style>
