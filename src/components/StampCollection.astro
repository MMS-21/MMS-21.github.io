---
import TopicStamp from './TopicStamp.astro';
import CairoPostage from './CairoPostage.astro';
const stamps=[
 {src:'/img/home-stamp.webp',label:'Back to the beginning',place:'Iran ? Avicenna'},
 {src:'/img/project-stamp.webp',label:'The project collection',place:'France · Lady and unicorn'},
 {src:'/img/about-stamp.webp',label:'A little about me',place:'Egypt · Airmail'},
 {src:'/img/writing-stamp.webp',label:'The working notebook',place:'Canada · Blue whale'},
 {src:'/img/contact-stamp.webp',label:'A letter from your corner',place:'Tanganyika · Giraffe'},
];
---
<dialog id="stamp-album" aria-labelledby="stamp-album-title">
 <button class="album-close" type="button">Close <small>Esc</small></button>
 <h2 id="stamp-album-title">A little stamp collection.</h2>
 <p class="album-intro">Small journeys, collected along the way.</p>
 <div class="album-pages">
 {stamps.map((stamp,i)=><figure style={`--stamp-angle:${i%2?3:-4}deg`}><div class="stamp-mount"><img src={stamp.src} alt={stamp.place} width="220" height="220" loading="lazy" /></div><figcaption>{stamp.label}<small>{stamp.place}</small></figcaption></figure>)}
 <figure class="cairo-pair"><div class="stamp-mount"><CairoPostage /></div><figcaption>From Cairo<small>Giza pyramids and Cairo Tower</small></figcaption></figure>
 {['role','project','hello'].map(kind=><figure><div class="stamp-mount"><TopicStamp kind={kind} /></div><figcaption>{kind==='role'?'A role':kind==='project'?'A project':'Just a hello'}<small>A finishing touch for a letter</small></figcaption></figure>)}
 </div>
</dialog>
<script>
 const album=document.querySelector<HTMLDialogElement>('#stamp-album')!;
 let previousOverflow='';
 document.querySelectorAll<HTMLButtonElement>('[data-stamps-open]').forEach(button=>button.addEventListener('click',()=>{previousOverflow=document.body.style.overflow;album.showModal();document.body.style.overflow='hidden';}));
 album.querySelector('.album-close')?.addEventListener('click',()=>album.close());
 album.addEventListener('click',event=>{if(event.target===album)album.close();});
 album.addEventListener('close',()=>{document.body.style.overflow=previousOverflow;});
</script>
<style is:global>
@font-face{font-family:"Lulu Handwriting";src:url('/fonts/caveat-regular.ttf') format('truetype');font-display:swap}
.profile-controls .stamps-toggle{font:18px/22px "Lulu Handwriting",cursive;letter-spacing:0;background:none;border:0;padding:3px 0;color:#514c45}
.stamps-toggle:hover{text-decoration:underline;text-underline-offset:4px}
#stamp-album{width:min(760px,calc(100vw - 32px));max-height:calc(100svh - 48px);padding:32px 38px;border:0;background:#f5f1e7 url('/img/paper-fibers.svg');color:#302f29;box-shadow:4px 16px 40px #30282030;overscroll-behavior:contain}
#stamp-album::backdrop{background:#30282066}
#stamp-album h2{font:500 38px/1.1 'Cormorant Garamond',Georgia,serif;margin:16px 0 8px}
.album-intro{font:14px/1.7 Georgia,serif;color:#685c4b;margin:0 0 24px}
.album-close{display:block;margin-left:auto;background:none;border:0;padding:8px;color:#514c45;cursor:pointer;font:14px Georgia,serif}.album-close small{margin-left:12px;color:#685c4b}
.album-pages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 20px}
.album-pages figure{margin:0;min-width:0;text-align:center}
.stamp-mount{height:150px;display:flex;align-items:center;justify-content:center}
.stamp-mount img{width:auto;height:auto;max-width:100%;max-height:125px;object-fit:contain;transform:rotate(var(--stamp-angle,2deg));filter:drop-shadow(2px 4px 3px #30282025)}
.album-pages figcaption{font:17px/1.3 'Cormorant Garamond',Georgia,serif}.album-pages figcaption small{display:block;margin-top:5px;font:11px/1.5 Georgia,serif;color:#685c4b}
#stamp-album :focus-visible{outline:2px solid #426b7d;outline-offset:4px}
@media(max-width:600px){#stamp-album{padding:22px 20px}.album-pages{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 15px}#stamp-album h2{font-size:30px}.cairo-pair{grid-column:1 / -1}.profile-controls .stamps-toggle{font-size:17px}}
</style>
