---
import { projectPapers as papers } from '../data/project-papers';
---
  <section class="workbench" aria-label="Project papers">
   <div class="stack">
    {papers.map((paper,i)=><article class:list={['project-paper','poster-paper','overlay-paper',{'customer-retention-paper':paper.url==='/projects/ecommerce-clv-churn/'}]} data-paper={i} style={`--angle:${i===0?-7:5}deg;z-index:${i===0?2:1}`}>
     <button class="project-image" aria-label={`Enlarge ${paper.title}`}><img src={paper.image} alt={paper.alt} width="900" height="580" loading="lazy" decoding="async"/></button>
     <div class="paper-copy"><h2><a href={paper.url}>{paper.title} <span aria-hidden="true">↗</span></a></h2></div>
    </article>)}
   </div>
   <div class="stack-controls"><button id="expand-study">Take a closer look ↗</button><div><button class="switch-paper" aria-label="Show previous project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13"/></svg></button><span class="count" aria-live="polite">1 / {papers.length}</span><button class="switch-paper" aria-label="Show next project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6M16 12H3"/></svg></button></div></div>
  </section>
 <nav class="project-view-pill" aria-label="Project view mode"><button type="button" data-project-view="slide" aria-pressed="true">Slide</button><button type="button" data-project-view="index" aria-pressed="false">Index</button></nav>
 <div class="project-column-pill" role="group" aria-label="Project columns">{[1,2,3].map(n=><button type="button" data-project-columns={n} aria-label={`${n} column${n>1?'s':''}`} aria-pressed={n===2?'true':'false'}>{n}</button>)}</div>
 <dialog id="works-collection" aria-labelledby="collection-title">
  <div class="collection-handle"><span aria-hidden="true"></span><button class="close-sheet">← Back to the workbench <small>Esc</small></button></div>
  <header class="collection-heading"><div class="collection-meta"><span>Selected projects</span><span>Collection / {String(papers.length).padStart(2,'0')}</span></div><h2 id="collection-title">Works.</h2><p>A collection of questions explored through data, and tools built to make everyday work easier.</p></header>
  <div class="collection-projects">{papers.map((paper,i)=><article class="collection-project">
   <button class="collection-preview" style={`--project-background:url('/img/project-backgrounds/${i+1}.webp')`} data-collection-paper={i} aria-label={`Preview ${paper.title}`}><img src={paper.image} alt={paper.alt} width="900" height="580" loading="lazy" decoding="async"/><span class="collection-preview-label">Enlarge preview ↗</span></button>
   <div class="collection-caption"><div class="collection-project-meta"><span>Project {String(i+1).padStart(2,'0')}</span><div class="collection-tags">{paper.tools.split(' · ').map(tool=><span>{tool}</span>)}</div></div><div class="collection-description"><h3><a href={paper.url}>{paper.title}</a></h3><div><p>{paper.summary}</p><a class="collection-read" href={paper.url}>Explore the project <span aria-hidden="true">↗</span></a></div></div></div>
  </article>)}</div>
  <a class="collection-index" href="/projects/">Open the full project index ↗</a>
 </dialog>
 <dialog id="case-drawer" aria-labelledby="drawer-title"><button class="close-sheet" aria-label="Close case study">← Go back <small>Esc</small></button><div class="drawer-heading"><h2 id="drawer-title"><a id="drawer-link"></a></h2></div><img id="drawer-chart" alt=""/><div id="drawer-content" aria-live="polite"></div></dialog>

<script>import '../scripts/workbench-interactions';</script>

<style is:global>

.workbench{max-width:660px;margin:38px auto 0;padding:0 38px}.stack{position:relative;height:490px;max-width:540px;margin:0 auto}.project-paper{position:absolute;top:0;left:50%;width:min(100%,460px);padding:0;overflow:hidden;background:#fcf9f1 url('/img/paper-fibers.svg');border:1px solid #77685318;box-shadow:3px 8px 12px #51433310,9px 23px 36px #51433320;transform:translateX(-50%) rotate(var(--angle));transform-origin:50% 30%;will-change:transform;touch-action:pan-y;transition:box-shadow .25s}.project-paper::after{content:'';position:absolute;inset:0;background:#534533;opacity:var(--shade,0);pointer-events:none}.project-paper[data-front=true]{box-shadow:3px 8px 12px #51433312,9px 23px 36px #51433326}.project-image{display:block;width:100%;margin:0;padding:0;border:0;background:#fffcf7;overflow:hidden;cursor:grab;touch-action:pan-y;user-select:none}.project-image img{display:block;width:100%;height:330px;object-fit:contain;pointer-events:none;-webkit-user-drag:none}.project-paper.dragging .project-image{cursor:grabbing}.paper-copy{padding:17px 22px 19px;min-height:106px}.paper-copy h2{font:500 27px/1.1 'Cormorant Garamond',Georgia,serif;letter-spacing:-.025em;margin:0 0 8px;text-align:left}.paper-copy h2 a{text-decoration:none;color:#302c29}.paper-copy h2 a:hover{text-decoration:underline;text-underline-offset:5px}.paper-copy h2 span{font-size:17px}.paper-copy small{font:400 10px/1.4 "Söhne",system-ui,sans-serif;color:#72675c}.stack-controls{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:0 auto;max-width:460px}.stack-controls button{cursor:pointer;color:#514b43;background:none;border:0;padding:8px 0;font:400 12px/20px "Söhne",system-ui,sans-serif}.stack-controls>button{text-decoration:underline;text-underline-offset:5px}.stack-controls>div{display:flex;align-items:center;gap:16px}.stack-controls .switch-paper{padding:8px}.switch-paper svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1}.count{font:11px system-ui,sans-serif;font-variant-numeric:tabular-nums}.stack:focus-visible,.workbench button:focus-visible,.workbench a:focus-visible{outline:2px solid #426b7d;outline-offset:6px}.sheet-open{overflow:hidden}
#case-drawer,#works-collection{position:fixed;color:#302c29;border:0;background:#faf6ed url('/img/paper-fibers.svg');box-shadow:0 25px 70px #30282040;max-height:none;max-width:1400px;width:calc(100% - 56px);height:calc(100svh - 35px);inset:35px 0 0;margin:0 auto;padding:45px;overflow:auto;overscroll-behavior:contain;scrollbar-width:none}#case-drawer::backdrop,#works-collection::backdrop{background:#2e2a245c;backdrop-filter:blur(5px)}#case-drawer[open]{animation:case-arrive .45s cubic-bezier(.16,1,.3,1)}@keyframes case-arrive{from{opacity:.4;translate:0 50px}to{opacity:1;translate:0 0}}#case-drawer .close-sheet,#works-collection .close-sheet{color:inherit;background:none;border:0;padding:8px 0;margin-bottom:25px;font:12px system-ui,sans-serif;cursor:pointer}.close-sheet small{margin-left:14px;color:#807568}.drawer-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.drawer-heading h2{font:500 clamp(36px,4vw,64px)/1.05 'Cormorant Garamond',Georgia,serif;max-width:700px;margin:0}.drawer-heading a{font-size:12px;color:inherit;white-space:nowrap}#drawer-chart{display:block;width:100%;height:auto;max-height:65svh;object-fit:contain;background:#fffcf8;transform-origin:0 0}#drawer-content{margin-top:20px;font-size:14px}#drawer-content article{max-width:1000px;margin:45px auto;line-height:1.8}#drawer-content h2{font:500 36px 'Cormorant Garamond',Georgia,serif;margin:45px 0 14px}#drawer-content h3{font:500 26px 'Cormorant Garamond',Georgia,serif;margin:25px 0 10px}#drawer-content p{max-width:72ch}#drawer-content img,#drawer-content svg{max-width:100%;height:auto}#drawer-content pre{overflow:auto;padding:20px;background:#eee8dc;font-size:12px}#drawer-content table{display:block;overflow:auto;border-collapse:collapse}#drawer-content td,#drawer-content th{padding:10px;border-bottom:1px solid #d3c9b8}#drawer-content figure{margin:30px 0}
#works-collection{inset:32px 0 0;width:calc(100% - 16px);max-width:none;height:calc(100svh - 32px);padding:0 4vw 60px;border-radius:4px 4px 0 0;will-change:transform}.collection-handle{padding:10px 0 0;touch-action:none;cursor:grab}.collection-handle>span{display:block;width:42px;height:3px;background:#b9af9f;margin:0 auto 8px;border-radius:2px}.collection-heading{padding:20px 0 55px}.collection-heading h2{font:400 clamp(64px,7vw,112px)/1 'Cormorant Garamond',Georgia,serif;margin:0 0 22px}.collection-heading p{max-width:30ch;font-size:13px;color:#72675c}.collection-projects{display:grid;grid-template-columns:1fr 1fr;gap:60px 32px}.collection-project{padding:0;border:0;background:none;text-align:left;min-width:0;cursor:pointer;color:inherit}.collection-project:first-child{grid-column:1/-1}.collection-project img{display:block;width:100%;height:380px;object-fit:contain;background:#eeeae0}.collection-project:first-child img{height:min(65vw,650px);background:#e4e9e4}.collection-project>span{display:block;padding:22px 0}.collection-project strong{font:500 32px/1.1 'Cormorant Garamond',Georgia,serif;display:block;max-width:28ch}.collection-project small{display:block;margin-top:12px;font-size:10px;color:#72675c}.collection-index{display:inline-block;margin-top:45px;font-size:12px;color:inherit}
@media(max-width:700px){.workbench{padding:0 12px}.stack{height:calc(min(460px,100vw - 94px)*.72 + 160px)}.project-image img{height:calc(min(460px,100vw - 94px)*.72)}.paper-copy h2{font-size:24px}.paper-copy{min-height:116px}.collection-projects{grid-template-columns:1fr;gap:28px}.collection-project img,.collection-project:first-child img{height:260px}.collection-project strong{font-size:28px}#works-collection{padding:0 24px 40px}.collection-heading{padding-bottom:25px}#case-drawer{width:calc(100% - 16px);padding:25px 18px}.drawer-heading{display:block}.drawer-heading a{display:inline-block;margin-top:18px}}
@media(prefers-reduced-motion:reduce){#case-drawer[open]{animation:none}.project-paper{transition:none}}

</style>
<style is:global>
.project-view-pill{position:sticky;bottom:24px;z-index:19;display:flex;width:fit-content;margin:30px auto 0;padding:7px 12px;border-radius:40px;background:#2d2b27;box-shadow:0 5px 14px #30282026;pointer-events:auto}.project-view-pill button,.project-column-pill button{border:0;background:none;color:#a9a59c;font:10px/1.2 'Departure Mono',monospace;text-transform:uppercase;cursor:pointer;min-height:32px;padding:8px 14px}.project-view-pill button[aria-pressed=true],.project-column-pill button[aria-pressed=true]{color:#fffdf7}.project-view-pill button:hover,.project-column-pill button:hover{color:#fffdf7}.project-column-pill{position:absolute;right:12px;top:310px;z-index:19;display:flex;flex-direction:column;padding:5px 2px;background:#2d2b27;border-radius:28px;box-shadow:0 5px 14px #30282026;pointer-events:auto}.project-column-pill button{padding:8px;min-width:30px}.project-view-pill :focus-visible,.project-column-pill :focus-visible{outline:1px solid #fffaf0;outline-offset:0;border-radius:18px}
.workbench[data-view=index]{max-width:none!important;padding:0!important}.workbench[data-view=index] .stack{display:grid;grid-template-columns:repeat(var(--project-columns,2),minmax(0,1fr));gap:28px;width:100%;max-width:none;height:auto!important}.workbench[data-view=index] .project-paper{position:relative;left:auto;top:auto;width:100%!important;transform:none!important;opacity:1;box-shadow:2px 8px 18px #443b2414}.workbench[data-view=index] .project-paper::after{display:none}.workbench[data-view=index] .paper-copy{position:static!important;width:auto!important;padding:18px!important}.workbench[data-view=index] .paper-copy h2{font-size:24px}.workbench[data-view=index] .project-image img{padding:0!important}.workbench[data-view=index] .stack-controls{display:none}
@media(max-width:700px){.workbench[data-view=index] .stack{gap:14px}.workbench[data-view=index] .paper-copy h2{font-size:16px}.workbench[data-view=index] .paper-copy{padding:10px!important}.project-column-pill{right:0;top:240px}.project-view-pill{bottom:16px}.workbench[data-view=index] .project-image{aspect-ratio:4/3}}
</style>

<style is:global>
#case-drawer,#works-collection{pointer-events:auto;overflow-y:auto;touch-action:pan-y}
.poster-paper .project-image{aspect-ratio:4/3;background:#fff}.poster-paper .project-image img{height:100%;object-fit:contain}.poster-paper .paper-copy{position:relative;min-height:106px;padding:17px 22px 19px}.poster-paper .paper-copy h2{margin:0}
#case-drawer{height:calc(100svh - 48px);inset:24px 0 0;max-width:1100px;padding:30px 40px 48px}
#case-drawer .drawer-heading{align-items:center;margin-bottom:22px}
.project-paper.overlay-paper .paper-copy{position:absolute;left:0;bottom:0;width:28%;min-height:0;padding:14px;pointer-events:none}.overlay-paper .paper-copy h2{font-size:clamp(14px,2vw,24px);line-height:1.22}.overlay-paper .paper-copy a{pointer-events:auto}
.overlay-paper .paper-copy h2 span{font-size:inherit}.overlay-paper:not(.customer-retention-paper) .project-image img{padding-left:28%;background:#fff}@media(max-width:700px){.project-paper.overlay-paper .paper-copy{padding:9px;width:29%}}
.workbench:has(.poster-paper){max-width:900px;padding-inline:38px}.stack:has(.poster-paper){max-width:760px;height:590px}.project-paper.poster-paper{width:min(100%,680px)}
#case-drawer.poster-preview{display:flex;flex-direction:column;padding:24px 0 0;max-width:1400px}
#case-drawer.poster-preview:not([open]){display:none}
#case-drawer.poster-preview>.close-sheet{align-self:flex-start;margin:0 24px 16px}
#case-drawer.poster-preview .drawer-heading{order:0;padding:0 24px;margin-bottom:12px}
#case-drawer.poster-preview #drawer-content{order:1;padding:0 24px;max-width:none;margin:0 0 20px}
#case-drawer.poster-preview #drawer-content p{margin:0;max-width:80ch}
#case-drawer.poster-preview #drawer-chart{order:2;flex:none;width:100%;height:auto;max-height:none;background:transparent}
@media(max-width:700px){.workbench:has(.poster-paper){padding-inline:0}.stack:has(.poster-paper){height:calc((100vw - 60px)*.75 + 85px)}.project-paper.poster-paper{width:100%}}
#case-drawer .drawer-heading h2{font-size:clamp(30px,3.4vw,48px);max-width:24ch}
#case-drawer .drawer-heading #drawer-link{font:inherit;white-space:normal;margin:0;text-decoration:none}#case-drawer .drawer-heading #drawer-link:hover{text-decoration:none}
#case-drawer #drawer-chart{max-height:52svh}
#case-drawer #drawer-content{margin-top:22px;max-width:65ch;font-size:14px;line-height:1.75}
@media(max-width:650px){#case-drawer{padding:24px;width:calc(100% - 24px)}#case-drawer .drawer-heading{display:block}#case-drawer .drawer-heading a{display:inline-block;margin-top:16px}}
</style>

<style is:global>
#works-collection{inset:54px 0 0;width:calc(100% - 20px);height:calc(100svh - 54px);padding:0 24px 64px;background-color:#f4f3ee}
#works-collection .collection-handle{position:relative;padding-top:10px}
#works-collection .collection-handle .close-sheet{position:absolute;right:0;top:8px;margin:0;font-size:11px}
#works-collection .collection-heading{padding:46px 0 64px}
.collection-meta{display:flex;gap:64px;color:#827d73;font:10px/1.5 'Departure Mono',monospace;text-transform:uppercase;letter-spacing:.06em;margin-bottom:18px}
#works-collection .collection-heading h2{font-size:clamp(76px,9vw,132px);letter-spacing:-.045em;margin:0 0 24px}
#works-collection .collection-heading p{max-width:35ch;font:14px/1.55 'Söhne',system-ui,sans-serif;margin:0;color:#716c63}
#works-collection .collection-projects{display:grid;grid-template-columns:1fr;gap:76px}
#works-collection .collection-project{cursor:auto;grid-column:auto}
.collection-preview{display:block;position:relative;width:100%;padding:0;border:1px solid #fff9;background:#e7e8df;cursor:zoom-in;overflow:hidden;color:inherit}
#works-collection .collection-preview img{width:100%;height:clamp(280px,40vw,620px);object-fit:contain;background:#e7e8df;transition:transform .65s cubic-bezier(.2,.7,.2,1)}
#works-collection .collection-project:nth-child(2n) .collection-preview img{background:#e8e3da}
.collection-preview-label{position:absolute;bottom:16px;right:16px;padding:10px 14px;background:#faf8f0e8;font:11px/1.4 system-ui,sans-serif;opacity:0;transform:translateY(5px);transition:opacity .2s,transform .2s}
.collection-preview:hover img{transform:scale(1.015)}
.collection-preview:hover .collection-preview-label,.collection-preview:focus-visible .collection-preview-label{opacity:1;transform:none}
.collection-caption{padding-top:18px}
.collection-project-meta{display:flex;justify-content:space-between;align-items:center;gap:16px;color:#817a6f;font:10px/1.4 'Departure Mono',monospace;text-transform:uppercase}
.collection-tags{display:flex;flex-wrap:wrap;gap:7px;justify-content:flex-end}
.collection-tags span{border:1px solid #a9a397;padding:4px 7px}
.collection-description{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;margin-top:14px}
.collection-description h3{font:400 clamp(32px,4vw,54px)/1.05 'Cormorant Garamond',Georgia,serif;letter-spacing:-.02em;margin:0;max-width:23ch}
.collection-description h3 a{color:inherit;text-decoration:none}
.collection-description p{font:14px/1.7 'Söhne',system-ui,sans-serif;color:#716b61;margin:0;max-width:58ch}
.collection-read{display:inline-flex;align-items:center;gap:30px;font:12px/1.5 system-ui,sans-serif;color:inherit;margin-top:20px;text-underline-offset:5px}
#works-collection :focus-visible{outline:2px solid #426b7d;outline-offset:4px}
@media(max-width:650px){#works-collection{inset:24px 0 0;height:calc(100svh - 24px);width:calc(100% - 12px);padding:0 18px 40px}#works-collection .collection-heading{padding:54px 0 36px}.collection-meta{gap:24px;font-size:9px}.collection-description{grid-template-columns:1fr;gap:18px}.collection-project-meta{align-items:flex-start}.collection-tags{max-width:72%;font-size:8px}#works-collection .collection-preview img{height:280px}#works-collection .collection-projects{gap:48px}.collection-preview-label{opacity:1;transform:none;font-size:10px;bottom:10px;right:10px}}
@media(prefers-reduced-motion:reduce){#works-collection .collection-preview img,.collection-preview-label{transition:none}}
</style>
<style is:global>
#works-collection .collection-project{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,1fr);gap:36px;align-items:center;border-bottom:1px solid #80756730;padding-bottom:52px}
#works-collection .collection-preview{background-image:var(--project-background);background-size:cover;background-position:center;padding:36px;isolation:isolate}
#works-collection .collection-preview::before{content:'';position:absolute;inset:0;background:#f7f2e52b;z-index:-1}
#works-collection .collection-preview img,#works-collection .collection-project:nth-child(2n) .collection-preview img{height:clamp(320px,34vw,540px);background:transparent;filter:drop-shadow(0 12px 14px #25201735)}
#works-collection .collection-caption{padding-top:0}
#works-collection .collection-project-meta{display:block}
#works-collection .collection-tags{justify-content:flex-start;margin-top:16px}
#works-collection .collection-description{display:block;margin-top:22px}
#works-collection .collection-description h3{font-size:clamp(30px,3.4vw,48px);margin-bottom:22px}
#works-collection .collection-description p{font-size:14px;line-height:1.75}
@media(max-width:700px){#works-collection .collection-project{grid-template-columns:1fr;gap:24px}#works-collection .collection-preview{padding:22px}}
</style>
