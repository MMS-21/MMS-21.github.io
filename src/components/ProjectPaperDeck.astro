---
import { projectPapers as papers } from '../data/project-papers';
---
  <section class="workbench" aria-label="Project papers">
   <div class="stack">
    {papers.map((paper,i)=><article class:list={['project-paper','poster-paper',{'customer-retention-paper':paper.url==='/projects/ecommerce-clv-churn/'}]} data-paper={i} style={`--angle:${i===0?-7:5}deg;z-index:${i===0?2:1}`}>
     <button class="project-image" aria-label={`Enlarge ${paper.title}`}><img src={paper.image} alt={paper.alt} width="900" height="580"/></button>
     <div class="paper-copy"><h2><a href={paper.url}>{paper.title} <span aria-hidden="true">↗</span></a></h2></div>
    </article>)}
   </div>
   <div class="stack-controls"><button id="expand-study">Take a closer look ↗</button><div><button class="switch-paper" aria-label="Show previous project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13"/></svg></button><span class="count" aria-live="polite">1 / {papers.length}</span><button class="switch-paper" aria-label="Show next project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6M16 12H3"/></svg></button></div></div>
  </section>
 <dialog id="works-collection" aria-labelledby="collection-title">
  <div class="collection-handle"><span aria-hidden="true"></span><button class="close-sheet">← Back to the workbench <small>Esc</small></button></div>
  <header class="collection-heading"><h2 id="collection-title">Works.</h2><p>Customer analytics, useful tools, and a little curiosity.</p></header>
  <div class="collection-projects">{papers.map((paper,i)=><button class="collection-project" data-collection-paper={i}><img src={paper.image} alt={paper.title} width="900" height="580" loading="lazy"/><span><strong>{paper.title}</strong><small>{paper.tools}</small></span></button>)}</div>
  <a class="collection-index" href="/projects/">Open the full project index ↗</a>
 </dialog>
 <dialog id="case-drawer" aria-labelledby="drawer-title"><button class="close-sheet" aria-label="Close case study">← Go back <small>Esc</small></button><div class="drawer-heading"><h2 id="drawer-title"><a id="drawer-link"></a></h2></div><img id="drawer-chart" alt=""/><div id="drawer-content" aria-live="polite"></div></dialog>

<script>import '../scripts/workbench-interactions';</script>
<style is:global>

.workbench{max-width:660px;margin:38px auto 0;padding:0 38px}.stack{position:relative;height:490px;max-width:540px;margin:0 auto}.project-paper{position:absolute;top:0;left:50%;width:min(100%,460px);padding:0;overflow:hidden;background:#fcf9f1 url('/img/paper-fibers.svg');border:1px solid #77685318;box-shadow:3px 8px 12px #51433310,9px 23px 36px #51433320;transform:translateX(-50%) rotate(var(--angle));transform-origin:50% 30%;will-change:transform;touch-action:pan-y;transition:box-shadow .25s}.project-paper::after{content:'';position:absolute;inset:0;background:#534533;opacity:var(--shade,0);pointer-events:none}.project-paper[data-front=true]{box-shadow:3px 8px 12px #51433312,9px 23px 36px #51433326}.project-image{display:block;width:100%;margin:0;padding:0;border:0;background:#fffcf7;overflow:hidden;cursor:grab;touch-action:pan-y;user-select:none}.project-image img{display:block;width:100%;height:330px;object-fit:contain;pointer-events:none;-webkit-user-drag:none}.project-paper.dragging .project-image{cursor:grabbing}.paper-copy{padding:17px 22px 19px;min-height:106px}.paper-copy h2{font:500 27px/1.1 'Cormorant Garamond',Georgia,serif;letter-spacing:-.025em;margin:0 0 8px;text-align:left}.paper-copy h2 a{text-decoration:none;color:#302c29}.paper-copy h2 a:hover{text-decoration:underline;text-underline-offset:5px}.paper-copy h2 span{font-size:17px}.paper-copy small{font:400 10px/1.4 "Söhne",system-ui,sans-serif;color:#72675c}.stack-controls{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:0 auto;max-width:460px}.stack-controls button{cursor:pointer;color:#514b43;background:none;border:0;padding:8px 0;font:400 12px/20px "Söhne",system-ui,sans-serif}.stack-controls>button{text-decoration:underline;text-underline-offset:5px}.stack-controls>div{display:flex;align-items:center;gap:16px}.stack-controls .switch-paper{padding:8px}.switch-paper svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1}.count{font:11px system-ui,sans-serif;font-variant-numeric:tabular-nums}.stack:focus-visible,.workbench button:focus-visible,.workbench a:focus-visible{outline:2px solid #426b7d;outline-offset:6px}.sheet-open{overflow:hidden}
#case-drawer,#works-collection{position:fixed;color:#302c29;border:0;background:#faf6ed url('/img/paper-fibers.svg');box-shadow:0 25px 70px #30282040;max-height:none;max-width:1400px;width:calc(100% - 56px);height:calc(100svh - 35px);inset:35px 0 0;margin:0 auto;padding:45px;overflow:auto;overscroll-behavior:contain;scrollbar-width:none}#case-drawer::backdrop,#works-collection::backdrop{background:#2e2a245c;backdrop-filter:blur(5px)}#case-drawer[open]{animation:case-arrive .45s cubic-bezier(.16,1,.3,1)}@keyframes case-arrive{from{opacity:.4;translate:0 50px}to{opacity:1;translate:0 0}}#case-drawer .close-sheet,#works-collection .close-sheet{color:inherit;background:none;border:0;padding:8px 0;margin-bottom:25px;font:12px system-ui,sans-serif;cursor:pointer}.close-sheet small{margin-left:14px;color:#807568}.drawer-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.drawer-heading h2{font:500 clamp(36px,4vw,64px)/1.05 'Cormorant Garamond',Georgia,serif;max-width:700px;margin:0}.drawer-heading a{font-size:12px;color:inherit;white-space:nowrap}#drawer-chart{display:block;width:100%;height:auto;max-height:65svh;object-fit:contain;background:#fffcf8;transform-origin:0 0}#drawer-content{margin-top:20px;font-size:14px}#drawer-content article{max-width:1000px;margin:45px auto;line-height:1.8}#drawer-content h2{font:500 36px 'Cormorant Garamond',Georgia,serif;margin:45px 0 14px}#drawer-content h3{font:500 26px 'Cormorant Garamond',Georgia,serif;margin:25px 0 10px}#drawer-content p{max-width:72ch}#drawer-content img,#drawer-content svg{max-width:100%;height:auto}#drawer-content pre{overflow:auto;padding:20px;background:#eee8dc;font-size:12px}#drawer-content table{display:block;overflow:auto;border-collapse:collapse}#drawer-content td,#drawer-content th{padding:10px;border-bottom:1px solid #d3c9b8}#drawer-content figure{margin:30px 0}
#works-collection{inset:32px 0 0;width:calc(100% - 16px);max-width:none;height:calc(100svh - 32px);padding:0 4vw 60px;border-radius:4px 4px 0 0;will-change:transform}.collection-handle{padding:10px 0 0;touch-action:none;cursor:grab}.collection-handle>span{display:block;width:42px;height:3px;background:#b9af9f;margin:0 auto 8px;border-radius:2px}.collection-heading{padding:20px 0 55px}.collection-heading h2{font:400 clamp(64px,7vw,112px)/1 'Cormorant Garamond',Georgia,serif;margin:0 0 22px}.collection-heading p{max-width:30ch;font-size:13px;color:#72675c}.collection-projects{display:grid;grid-template-columns:1fr 1fr;gap:60px 32px}.collection-project{padding:0;border:0;background:none;text-align:left;min-width:0;cursor:pointer;color:inherit}.collection-project:first-child{grid-column:1/-1}.collection-project img{display:block;width:100%;height:380px;object-fit:contain;background:#eeeae0}.collection-project:first-child img{height:min(65vw,650px);background:#e4e9e4}.collection-project>span{display:block;padding:22px 0}.collection-project strong{font:500 32px/1.1 'Cormorant Garamond',Georgia,serif;display:block;max-width:28ch}.collection-project small{display:block;margin-top:12px;font-size:10px;color:#72675c}.collection-index{display:inline-block;margin-top:45px;font-size:12px;color:inherit}
@media(max-width:700px){.workbench{padding:0 12px}.stack{height:calc(min(460px,100vw - 94px)*.72 + 160px)}.project-image img{height:calc(min(460px,100vw - 94px)*.72)}.paper-copy h2{font-size:24px}.paper-copy{min-height:116px}.collection-projects{grid-template-columns:1fr;gap:28px}.collection-project img,.collection-project:first-child img{height:260px}.collection-project strong{font-size:28px}#works-collection{padding:0 24px 40px}.collection-heading{padding-bottom:25px}#case-drawer{width:calc(100% - 16px);padding:25px 18px}.drawer-heading{display:block}.drawer-heading a{display:inline-block;margin-top:18px}}
@media(prefers-reduced-motion:reduce){#case-drawer[open]{animation:none}.project-paper{transition:none}}

</style>

<style is:global>
#case-drawer,#works-collection{pointer-events:auto;overflow-y:auto;touch-action:pan-y}
.poster-paper .project-image{aspect-ratio:4/3;background:#fff}.poster-paper .project-image img{height:100%;object-fit:contain}.poster-paper .paper-copy{position:relative;min-height:106px;padding:17px 22px 19px}.poster-paper .paper-copy h2{margin:0}
#case-drawer{height:calc(100svh - 48px);inset:24px 0 0;max-width:1100px;padding:30px 40px 48px}
#case-drawer .drawer-heading{align-items:center;margin-bottom:22px}
.project-paper.customer-retention-paper .paper-copy{position:absolute;left:0;bottom:0;width:28%;min-height:0;padding:14px;pointer-events:none}.customer-retention-paper .paper-copy h2{font-size:clamp(14px,2vw,24px);line-height:1.22}.customer-retention-paper .paper-copy a{pointer-events:auto}
.customer-retention-paper .paper-copy h2 span{font-size:inherit}@media(max-width:700px){.project-paper.customer-retention-paper .paper-copy{padding:9px;width:29%}}
.workbench:has(.poster-paper){max-width:900px;padding-inline:38px}.stack:has(.poster-paper){max-width:760px;height:690px}.project-paper.poster-paper{width:min(100%,680px)}
#case-drawer.poster-preview{display:flex;flex-direction:column;padding:24px 0 0;max-width:1400px}
#case-drawer.poster-preview:not([open]){display:none}
#case-drawer.poster-preview>.close-sheet{align-self:flex-start;margin:0 24px 16px}
#case-drawer.poster-preview .drawer-heading{order:0;padding:0 24px;margin-bottom:12px}
#case-drawer.poster-preview #drawer-content{order:1;padding:0 24px;max-width:none;margin:0 0 20px}
#case-drawer.poster-preview #drawer-content p{margin:0;max-width:80ch}
#case-drawer.poster-preview #drawer-chart{order:2;flex:none;width:100%;height:auto;max-height:none;background:transparent}
@media(max-width:700px){.workbench:has(.poster-paper){padding-inline:0}.stack:has(.poster-paper){height:calc((100vw - 60px)*.75 + 185px)}.project-paper.poster-paper{width:100%}.poster-paper .paper-copy{min-height:116px}}
#case-drawer .drawer-heading h2{font-size:clamp(30px,3.4vw,48px);max-width:24ch}
#case-drawer .drawer-heading #drawer-link{font:inherit;white-space:normal;margin:0;text-decoration:none}#case-drawer .drawer-heading #drawer-link:hover{text-decoration:underline;text-underline-offset:6px}
#case-drawer #drawer-chart{max-height:52svh}
#case-drawer #drawer-content{margin-top:22px;max-width:65ch;font-size:14px;line-height:1.75}
@media(max-width:650px){#case-drawer{padding:24px;width:calc(100% - 24px)}#case-drawer .drawer-heading{display:block}#case-drawer .drawer-heading a{display:inline-block;margin-top:16px}}
</style>
