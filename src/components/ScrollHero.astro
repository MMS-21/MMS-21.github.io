---
import { Mascot } from 'page-mascot';
import { SITE, BIO_DETAIL } from '../data/site';
const NAV = [{href:'/projects/',label:'Projects'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
// Shared irregular edges make soft torn strips, rather than polygonal cracks.
const edges = Array.from({length:8}, (_,edge) => Array.from({length:51}, (_,step) => {
  const x = edge === 0 ? 0 : edge === 7 ? 100 : edge * 100 / 7 + Math.sin(step * 2.7 + edge) * .28 + Math.sin(step * 6.1) * .12;
  return `${x.toFixed(3)}% ${step * 2}%`;
}));
const fragments = Array.from({length:7}, (_,i) => ({
  clip:`polygon(${[...edges[i],...edges[i+1].toReversed()].join(',')})`,
  x:(i-3)*100, y:i%2 ? -430 : 430, r:(i-3)*5,
}));

---
<a class="skip-intro" href="#featured-work">Skip introduction</a>
<section class="scroll-hero" aria-label="Introduction">
  <div class="hero-stage">
    <div class="paper-background" aria-hidden="true">
      <div class="paper-underlay"></div>
      {fragments.map((piece,i)=><div class="paper-fragment" style={`clip-path:${piece.clip};--scatter-x:${piece.x}px;--scatter-y:${piece.y}px;--scatter-r:${piece.r}deg;--piece:${i}`}><div class="paper-surface"></div></div>)}
    </div>
    <div class="hero-identity">
      <div class="hero-art">
        <svg class="ink-sketch" viewBox="0 0 640 180" fill="none" aria-hidden="true" focusable="false">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <g class="doodle notebook">
            <path fill="#f6eddb" d="M39 40 164 29 179 141 54 152Z" />
            <path d="m51 47 101-9 12 91-101 10Z M57 30l11 121 M80 51l54-5 M82 60l32-3" />
            <path d="m83 115-3-32 m3 32 62-6 M96 111l-1-15 m17 13-2-29 m20 27-3-41" />
            <path class="draw-line" pathLength="1" d="m85 96 19-16 14 5 23-23" />
            <path d="m135 62 7-1-1 8 M30 126l-7 10 m10-6-9-3 M176 45l8-8 m-4 15 12-2" />
            </g>
            <g class="doodle arrow-one"><path pathLength="1" d="M188 100c27 23 46 22 68 4 m-10-2 11 1-4 10" />
            </g>
            <g class="doodle lens">
            <path fill="#f6eddb" d="m471 32 103 8-7 104-103-9Z" />
            <path d="m487 49 66 5 m-67 8 40 3 m-43 48 23 2 m-24 10 31 2" />
            <circle cx="544" cy="91" r="27" fill="var(--bg)" />
            <circle cx="544" cy="91" r="21" />
            <path class="draw-line check-mark" pathLength="1" d="m533 91 8 8 15-17" />
            <path d="m563 112 24 28c5 6 14-2 9-8l-26-28 M587 150c-10 12-23 16-39 12 m-83-12-11 5 m8-14-10-2 M583 54l7-10 m1 19 12-2" />
            </g>
            <g class="doodle arrow-two"><path pathLength="1" d="M384 107c22-17 40-15 65 1 m-6-9 7 10-12 2" /></g>
          </g>
        </svg>

        <div class="mascot-portrait"><Mascot client:load directions="/mascots/moaaz-directions.webp" reactions="/mascots/moaaz-reactions.webp" size={220} label="Moaaz avatar" /></div>
      </div>
      <h1>{SITE.name}</h1>
    </div>
    <div class="hero-details">
      <p class="hero-role">Business Analyst</p>
      <p class="hero-location">{SITE.location}</p>
      <div class="bio-intro">
        <div class="question-cue">
          <p class="margin-note">Start with the question.</p>
          <svg class="question-arrow" viewBox="0 0 100 55" fill="none" aria-hidden="true"><path d="M8 7C72-5 90 17 68 43m-5-13 4 15 15-6" /></svg>
        </div>
        <div class="question-paper">
          <span class="binding-holes" aria-hidden="true"></span>
          <p>Which valuable customers are likely to leave—and who should we contact first?</p>
        </div>
        <p class="hero-lede">{BIO_DETAIL}</p>
      </div>
    </div>
    <nav class="hero-nav" aria-label="Main">{NAV.map(item=><a href={item.href}>{item.label}</a>)}</nav>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.scroll-hero');
  if (hero) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const details = hero.querySelector<HTMLElement>('.hero-details')!;
    const nav = hero.querySelector<HTMLElement>('.hero-nav')!;
    const pieces = hero.querySelectorAll<HTMLElement>('.paper-fragment');
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => 1 - Math.pow(1 - clamp(n), 3);
    let frame = 0;
    const render = () => {
      frame = 0;
      const animated = !reduced.matches;
      hero.dataset.animated = String(animated);
      const distance = hero.offsetHeight - window.innerHeight;
      const progress = animated ? clamp(-hero.getBoundingClientRect().top / Math.max(1, distance)) : 1;
      hero.style.setProperty('--assembly', String(ease((progress - .015) / .36)));
      pieces.forEach((piece, index) => {
        piece.style.setProperty('--assembly', String(ease((progress - .015 - index * .012) / .3)));
      });
      hero.style.setProperty('--identity', String(ease((progress - .28) / .24)));
      hero.style.setProperty('--details', String(ease((progress - .75) / .22)));
      for (const [name,start] of [['notebook',.38],['arrow-one',.49],['arrow-two',.60],['lens',.71]] as const) {
        hero.style.setProperty(`--${name}`, String(ease((progress - start) / .16)));
      }
      hero.style.setProperty('--nav', String(ease((progress - .30) / .2)));
      details.inert = animated && progress < .78;
      nav.inert = animated && progress < .34;
      details.style.visibility = progress < .75 ? 'hidden' : 'visible';
      nav.style.visibility = progress < .30 ? 'hidden' : 'visible';
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', schedule, {passive:true});
    reduced.addEventListener('change', render);
    render();
  }
</script>
<style>
  .scroll-hero { --assembly:1; --identity:1; --details:1; --notebook:1; --arrow-one:1; --arrow-two:1; --lens:1; --nav:1; position:relative; margin:0; }
  .hero-stage { position:relative; min-height:840px; height:100svh; isolation:isolate; overflow:hidden; text-align:center; }
  .scroll-hero[data-animated="true"] { height:235svh; }
  [data-animated="true"] .hero-stage { position:sticky; top:0; min-height:0; }
  .paper-background { position:absolute; inset:3% max(2%, calc((100% - 1100px)/2)); z-index:-1; pointer-events:none; mask-image:linear-gradient(transparent,#000 3%,#000 97%,transparent); }
  .paper-underlay { position:absolute; inset:0; background:#f7f2e8 url('/img/paper-fibers.svg'); opacity:var(--assembly); }
  .paper-fragment { position:absolute; inset:0; opacity:var(--assembly); transform:translate(calc(var(--scatter-x) * (1 - var(--assembly))),calc(var(--scatter-y) * (1 - var(--assembly)))) rotate(calc(var(--scatter-r) * (1 - var(--assembly)))); }
  .paper-surface { position:absolute; inset:0; background-color:#eae0cd; background-image:url('/img/paper-fibers.svg'),radial-gradient(ellipse at 25% 25%,#f8efdca3,transparent 65%),radial-gradient(ellipse at 80% 80%,#d8c7a536,transparent 60%); background-size:256px 256px,100% 100%,100% 100%; }
  .hero-identity { position:absolute; top:calc(50% - 160px); left:0; right:0; transform:translateY(calc(-125px * var(--identity))); }
  .hero-art { position:relative; width:min(640px,95vw); height:200px; display:grid; place-items:center; margin:auto; }
  .mascot-portrait { position:relative; width:220px; height:220px; }
  .mascot-portrait :global(button:focus-visible) { outline:2px solid var(--accent); outline-offset:2px; border-radius:50%; }
  h1 { margin:0; font-size:clamp(2rem,5vw,2.8rem); letter-spacing:-.035em; }
  .ink-sketch { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .doodle { transform-box:fill-box; transform-origin:center; opacity:var(--reveal); transform:translateY(calc(12px * (1 - var(--reveal)))) scale(calc(.82 + .18 * var(--reveal))); }
  .notebook { --reveal:var(--notebook); clip-path:inset(calc(100% * (1 - var(--reveal))) 0 0 0); }
  .arrow-one { --reveal:var(--arrow-one); }
  .arrow-two { --reveal:var(--arrow-two); }
  .lens { --reveal:var(--lens); clip-path:inset(calc(100% * (1 - var(--reveal))) 0 0 0); }
  .arrow-one path, .arrow-two path { stroke-dasharray:1; stroke-dashoffset:calc(1 - var(--reveal)); }
  .hero-details { position:absolute; top:calc(50% - 12px); left:24px; right:24px; opacity:var(--details); transform:translateY(calc(28px * (1 - var(--details)))); }
  .hero-role { color:var(--fg); font-size:1rem; font-weight:550; margin:0 auto; }
  .hero-location { font-family:Georgia,'Times New Roman',serif; font-style:italic; color:#6b5d49; font-size:1rem; margin:2px auto 15px; }
  .bio-intro { max-width:31rem; margin:auto; }
  .question-cue { display:flex; align-items:center; justify-content:flex-start; margin:0 auto -7px; max-width:350px; transform:translateX(-24px); }
  .margin-note { font-family:"Segoe Print","Bradley Hand",cursive; color:#57472f; font-size:1rem; margin:0; transform:rotate(-3deg); }
  .question-arrow { width:76px; height:46px; stroke:#57472f; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .question-paper { position:relative; max-width:350px; margin:0 auto 20px; padding:25px 26px 18px 38px; background:#fffaf0 url('/img/paper-fibers.svg'); text-align:left; transform:translateX(-24px) rotate(-2deg); filter:drop-shadow(2px 5px 5px #57402018); clip-path:polygon(0 0,100% 0,99.4% 15%,100% 29%,99.2% 43%,100% 58%,99.5% 76%,100% 100%,97% 98%,94% 100%,91% 98.5%,88% 100%,84% 98.6%,81% 100%,77% 98%,73% 100%,69% 98.5%,65% 100%,61% 98%,56% 100%,52% 98.5%,47% 100%,43% 98%,38% 100%,34% 98.6%,29% 100%,25% 98%,20% 100%,16% 98.5%,11% 100%,7% 98%,3% 100%,0 99%); }
  .question-paper p { font-family:Georgia,'Times New Roman',serif; font-size:1.25rem; line-height:1.45; color:#30291f; margin:0; }
  .binding-holes { position:absolute; top:0; bottom:0; left:9px; width:10px; background:radial-gradient(circle,#d2c3a8 3px,transparent 3.5px) center 10px / 10px 22px repeat-y; }
  .hero-lede { color:#645743; font-size:.9375rem; margin:0; line-height:1.65; }
  .hero-nav { position:absolute; top:clamp(25px,6vh,65px); left:16px; right:16px; display:flex; justify-content:center; flex-wrap:wrap; gap:28px; opacity:var(--nav); transform:translateY(calc(12px * (1 - var(--nav)))); }
  .hero-nav a { color:var(--fg); text-decoration:none; font-size:.9375rem; padding:8px 2px; }
  .hero-nav a:hover { color:var(--accent); text-decoration:underline; text-underline-offset:5px; }
  .skip-intro { position:absolute; top:12px; left:12px; z-index:5; padding:10px 16px; background:var(--bg); transform:translateY(-200%); }
  .skip-intro:focus { transform:none; }
  @media (max-width:600px) {
    .hero-identity { top:calc(50% - 150px); transform:translateY(calc(-135px * var(--identity))); }
    .hero-art { height:170px; }
    .mascot-portrait { transform:scale(.85); }
    .ink-sketch { width:110%; left:-5%; }
    .hero-details { top:calc(50% - 65px); left:24px; right:24px; }
    .hero-role { font-size:.9375rem; }
    .hero-location { margin-bottom:12px; }
    .question-cue { transform:translateX(-6px); }
    .question-paper { transform:translateX(-6px) rotate(-2deg); padding:22px 20px 18px 32px; margin-bottom:16px; }
    .question-paper p { font-size:1.15rem; }
    .hero-lede { font-size:.875rem; }
    .hero-nav { gap:20px; top:28px; }
  }
  @media (max-height:700px) and (prefers-reduced-motion:no-preference) {
    .hero-identity { top:calc(50% - 140px); transform:translateY(calc(-100px * var(--identity))); }
    .hero-art { height:130px; }
    .mascot-portrait { transform:scale(.65); }
    h1 { font-size:1.8rem; }
    .hero-details { top:calc(50% - 55px); }
    .question-paper { padding-top:18px; margin-bottom:10px; }
    .question-paper p { font-size:1.05rem; }
    .hero-location { margin-bottom:5px; }
    .hero-lede { font-size:.8rem; }
    .hero-nav { top:12px; }
  }
  @media (prefers-reduced-motion:reduce) { .hero-stage { height:auto; min-height:840px; } }
</style>
