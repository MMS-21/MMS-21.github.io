---
import { Mascot } from 'page-mascot';
import { SITE } from '../data/site';
const NAV = [{href:'/projects/',label:'Projects'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
// Small scraps overlap; each exposes a white torn-paper edge beneath its sandy face.
const torn = Array.from({length:30}, (_,i) => `${(100 + Math.sin(i*4.2)*1.7).toFixed(2)}% ${(i*100/29).toFixed(2)}%`);
const bottom = Array.from({length:30}, (_,i) => `${(100-i*100/29).toFixed(2)}% ${(100 + Math.sin(i*3.8)*1.4).toFixed(2)}%`);
const left = Array.from({length:30}, (_,i) => `${(Math.sin(i*5.3)*1.5).toFixed(2)}% ${(100-i*100/29).toFixed(2)}%`);
const top = Array.from({length:30}, (_,i) => `${(i*100/29).toFixed(2)}% ${(Math.sin(i*4.9)*1.4).toFixed(2)}%`);
const tornEdge = `polygon(${[...top,...torn,...bottom,...left].join(',')})`;
const fragments = Array.from({length:24}, (_,i) => ({
  left:(i%6)*20-7+Math.sin(i*2.3)*1.5,
  top:Math.floor(i/6)*29-9+Math.cos(i*3.7)*1.5,
  x:Math.sin(i*2.7)*25, y:Math.cos(i*3.1)*24,
  r:Math.sin(i*7.1)*7, scatter:Math.cos(i*5.3)*48,
}));

---
<a class="skip-intro" href="#featured-work">Skip introduction</a>
<div class="paper-background" aria-hidden="true">
      <div class="paper-underlay"></div>
      {fragments.map((piece,i)=><div class="paper-fragment" style={`left:${piece.left}%;top:${piece.top}%;--torn-edge:${tornEdge};--scatter-x:${piece.x}vw;--scatter-y:${piece.y}vh;--scatter-r:${piece.scatter}deg;--rest-r:${piece.r}deg;--piece:${i}`}><div class="paper-edge"></div><div class="paper-surface"></div></div>)}
    </div>
<section class="scroll-hero" aria-label="Introduction">
  <div class="hero-stage">
    <div class="hero-illustrations">
      <div class="hero-art">
        <svg class="ink-sketch" viewBox="0 0 640 180" fill="none" aria-hidden="true" focusable="false">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <g class="doodle notebook">
            <path fill="#f6eddb" d="M39 40 164 29 179 141 54 152Z" />
            <path d="m51 47 101-9 12 91-101 10Z M57 30l11 121 M80 51l54-5 M82 60l32-3" />
            <path d="m83 115-3-32 m3 32 62-6 M96 111l-1-15 m17 13-2-29 m20 27-3-41" />
            <path class="draw-line" pathLength="1" d="m85 96 19-16 14 5 23-23" />
            <path d="m135 62 7-1-1 8 M30 126l-7 10 m10-6-9-3 M176 45l8-8 m-4 15 12-2" />
            </g>
            <g class="doodle arrow-one"><path pathLength="1" d="M184 100c18 17 30 20 46 12 m-10-3 11 2-5 9" />
            </g>
            <g class="doodle lens">
            <path fill="#f6eddb" d="m471 32 103 8-7 104-103-9Z" />
            <path d="m487 49 66 5 m-67 8 40 3 m-43 48 23 2 m-24 10 31 2" />
            <circle cx="544" cy="91" r="27" fill="var(--bg)" />
            <circle cx="544" cy="91" r="21" />
            <path class="draw-line check-mark" pathLength="1" d="m533 91 8 8 15-17" />
            <path d="m563 112 24 28c5 6 14-2 9-8l-26-28 M587 150c-10 12-23 16-39 12 m-83-12-11 5 m8-14-10-2 M583 54l7-10 m1 19 12-2" />
            </g>
            <g class="doodle arrow-two"><path pathLength="1" d="M410 107c12-11 23-10 39 1 m-6-9 7 10-12 2" /></g>
          </g>
        </svg>


      </div>

    </div>
    <div class="hero-details">
      <p class="hero-role">Business Analyst</p>
      <p class="hero-location">{SITE.location}</p>
      <div class="bio-intro">
        <div class="question-cue">
          <p class="margin-note">Start with the question.</p>
          <svg class="question-arrow" viewBox="0 0 100 55" fill="none" aria-hidden="true"><path d="M8 7C72-5 90 17 68 43m-5-13 4 15 15-6" /></svg>
        </div>
        <div class="question-paper">
          <span class="binding-holes" aria-hidden="true"></span>
          <p>Which valuable customers are likely to leave—and who should we contact first?</p>
        </div>
      </div>
    </div>

  </div>
  <div class="hero-identity">
    <div class="identity-art"><div class="mascot-portrait"><Mascot client:load directions="/mascots/moaaz-directions.webp" reactions="/mascots/moaaz-reactions.webp" size={220} label="Moaaz avatar" /></div></div>
    <h1>{SITE.name}</h1>
  </div>
  <div class="navigation-shell">
    <button class="pyramid-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="portfolio-navigation">
      <svg viewBox="0 0 110 46" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path fill="#ddc9a5" d="M3 40 26 5 49 40Z"/><path d="m26 5 7 35H3"/><path fill="#e8d8bb" d="m43 40 19-28 19 28Z"/><path d="m62 12 5 28H43"/><path fill="#f0e4cd" d="m78 40 13-19 13 19Z"/><path d="m91 21 3 19H78"/></g></svg>
      <span>Menu</span>
    </button>
    <nav class="hero-nav" id="portfolio-navigation" aria-label="Main">{NAV.map(item=><a href={item.href}><span>{item.label}</span><svg viewBox="0 0 100 9" fill="none" aria-hidden="true"><path pathLength="1" d="M2 6Q43 0 98 4M14 8Q53 3 86 6" /></svg></a>)}</nav>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.scroll-hero');
  if (hero) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const identity = hero.querySelector<HTMLElement>('.hero-identity')!;
    const nav = hero.querySelector<HTMLElement>('.hero-nav')!;
    const shell = hero.querySelector<HTMLElement>('.navigation-shell')!;
    const toggle = hero.querySelector<HTMLButtonElement>('.pyramid-toggle')!;
    let menuOpen=false;
    const closeMenu=(focus=false)=>{menuOpen=false; shell.dataset.open='false'; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open navigation menu'); if(focus)toggle.focus(); schedule();};
    toggle.addEventListener('click',()=>{menuOpen=!menuOpen; shell.dataset.open=String(menuOpen); toggle.setAttribute('aria-expanded',String(menuOpen)); toggle.setAttribute('aria-label',menuOpen?'Close navigation menu':'Open navigation menu'); schedule();});
    addEventListener('keydown',e=>{if(e.key==='Escape'&&menuOpen)closeMenu(true);});
    document.addEventListener('click',e=>{if(menuOpen&&!shell.contains(e.target as Node))closeMenu();});
    nav.addEventListener('click',e=>{if((e.target as HTMLElement).closest('a'))closeMenu();});
    const background = document.querySelector<HTMLElement>('.paper-background')!;
    const papers = [...document.querySelectorAll<HTMLElement>('.work-paper')];
    const scraps = [...background.querySelectorAll<HTMLElement>('.paper-fragment')];
    const moments = [['notebook',.18,.05],['arrow-one',.25,.045],['arrow-two',.31,.045],['lens',.37,.05],['role',.44,.04],['location',.50,.04],['question-line',.56,.045],['question-curve',.62,.045],['question-note',.68,.06]] as const;
    const clamp = (n:number) => Math.max(0,Math.min(1,n));
    const ease = (n:number) => { const t=clamp(n); return t*t*(3-2*t); };
    let frame=0, h=0, w=0, end=1, total=1, identityHeight=254, shellWidth=640;
    let targets:{x:number,y:number,width:number,height:number}[]=[];
    const values = new WeakMap<HTMLElement,Map<string,string>>();
    const set = (el:HTMLElement,key:string,value:number) => {
      const v=value.toFixed(4); let cache=values.get(el);
      if (!cache) { cache=new Map(); values.set(el,cache); }
      if (cache.get(key)!==v) { el.style.setProperty(key,v); cache.set(key,v); }
    };
    const measure = () => {
      hero.dataset.animated=String(!reduced.matches);
      h=innerHeight; w=document.documentElement.clientWidth;
      identityHeight=identity.offsetHeight; shellWidth=shell.offsetWidth;
      end=Math.max(1,hero.offsetHeight-h); total=Math.max(end+1,document.documentElement.scrollHeight-h);
      // Offsets are layout geometry: transformed paper rectangles would feed back into the animation.
      targets=papers.map(el=>({x:(el.offsetParent as HTMLElement).offsetLeft+el.offsetLeft+el.offsetWidth/2,y:(el.offsetParent as HTMLElement).offsetTop+el.offsetTop,width:el.offsetWidth,height:el.offsetHeight}));
      schedule();
    };
    const render = () => {
      frame=0;
      const y=scrollY, animated=!reduced.matches;
      const p=animated?clamp(y/end):1;
      // Keep the same physical scraps on screen: no opacity swap or replacement image.
      scraps.forEach((scrap,i)=>set(scrap,'--assembly',animated?ease((p-(i%6)*.006)/.15):1));
      const lift=ease((p-.12)/.08);
      set(hero,'--identity',lift);
      for (const [name,start,duration] of moments) set(hero,`--${name}`,ease((p-start)/duration));
      const depart=animated?ease((p-.77)/.08):0;
      set(hero,'--depart',depart);
      const handoff=animated?ease((p-.85)/.15):1;
      set(hero,'--handoff',animated?ease((p-.85)/.06):1);
      set(hero,'--nav',ease((p-.12)/.05));

      const travel=animated?clamp((y-end*.79)/(total-end*.79)):1;
      // Get the portrait clear of the growing papers early, then finish shrinking at the page bottom.
      const move=animated?ease((p-.79)/.19):1, shrink=ease(travel);
      const scale=1-.52*move-.10*shrink;
      const mobile=w<=600;
      const baseY=h<=700?h/2-140-100*lift:h/2-(mobile?150:160)-(mobile?135:125)*lift;
      const x=w/2+(18+340*scale/2-w/2)*move;
      const top=baseY+(10-baseY)*move;
      const identityTransform=animated?`translate3d(${x-170}px,${top}px,0) scale(${scale})`:'none';
      if(identity.style.transform!==identityTransform) identity.style.transform=identityTransform;
      identity.dataset.docked=String(travel>.85);
      const collapse=animated?ease((p-.79)/.20):0;
      set(shell,'--collapse',collapse);
      set(shell,'--nav',ease((p-.12)/.05));
      const navTop=w<=600?24:Math.min(65,Math.max(25,h*.06));
      const shellX=(w-shellWidth)/2+(x-shellWidth/2-(w-shellWidth)/2)*collapse;
      const shellY=navTop+(top+identityHeight*scale+14-navTop)*collapse;
      shell.style.transform=`translate3d(${shellX}px,${shellY}px,0)`;
      shell.dataset.collapsed=String(collapse>.98);
      if(collapse<.8&&menuOpen)closeMenu();
      toggle.inert=collapse<.98;
      nav.inert=(animated&&p<.14)||(collapse>.65&&!menuOpen);
      shell.style.visibility=p<.12?'hidden':'visible';

      papers.forEach((paper,i)=>{
        const target=targets[i]; if (!target) return;
        const sourceX=w/2+(i===0?-220:220)*Math.min(1,w/640);
        const sourceY=(h<=700?h/2-240:h/2-285)+100;
        const t=handoff, size=.23+.77*t;
        const dx=(sourceX-target.x)*(1-t);
        const dy=(y+sourceY-target.y-target.height*.12)*(1-t);
        const paperTransform=animated?`translate3d(${dx}px,${dy}px,0) scale(${size}) rotate(${(i===0?-4:3)*t}deg)`:`rotate(${i===0?-3:2}deg)`;
        if(paper.style.transform!==paperTransform) paper.style.transform=paperTransform;
        set(paper,'--paper-copy',ease((t-.25)/.65));
        paper.style.opacity=String(animated?ease((p-.85)/.06):1);
        paper.style.visibility=animated&&p<.85?'hidden':'visible';
        paper.inert=animated&&t<.9;
      });
    };
    const schedule=()=>{if(!frame)frame=requestAnimationFrame(render);};
    addEventListener('scroll',schedule,{passive:true});
    addEventListener('resize',measure,{passive:true});
    reduced.addEventListener('change',measure);
    new ResizeObserver(measure).observe(document.body);
    document.fonts.ready.then(measure);
    measure();
  }
</script>
<style>
  .scroll-hero { --assembly:1; --identity:1; --role:1; --location:1; --question-line:1; --question-curve:1; --question-note:1; --notebook:1; --arrow-one:1; --arrow-two:1; --lens:1; --nav:1; position:relative; margin:0; }
  .hero-stage { position:relative; min-height:840px; height:100svh; isolation:isolate; overflow:hidden; text-align:center; }
  .scroll-hero[data-animated="true"] { height:540svh; }
  [data-animated="true"] .hero-stage { position:sticky; top:0; min-height:0; }
  @font-face { font-family:'Cormorant Garamond'; src:url('/fonts/cormorant-garamond-medium.ttf') format('truetype'); font-weight:500; font-display:swap; }
  .paper-background { --assembly:1; position:fixed; inset:0; z-index:-1; pointer-events:none; contain:strict; }
  :global(html:has(.scroll-hero)) { overflow-x:clip; }
  :global(body:has(.scroll-hero)) { isolation:isolate; overflow-x:clip; }
  :global(main.flush-top:has(.scroll-hero)) { padding-top:0; }
  .paper-background::after { content:""; position:absolute; inset:0; background:url('/img/paper-fibers.svg'); opacity:.5; }
  .paper-underlay { position:absolute; inset:0; background:#fcfaf7; }
  .paper-fragment { --assembly:1; position:absolute; width:29%; height:40%; transform:translate3d(calc(var(--scatter-x) * (1 - var(--assembly))),calc(var(--scatter-y) * (1 - var(--assembly))),0) rotate(calc(var(--rest-r) + var(--scatter-r) * (1 - var(--assembly)))) scale(calc(.58 + .42 * var(--assembly))); }
  .paper-edge { position:absolute; inset:0; background:#fffdf7; clip-path:var(--torn-edge); }
  .paper-surface { position:absolute; inset:5px 8px 11px 4px; clip-path:var(--torn-edge); background:#ede3cf; }
  .paper-fragment:nth-child(3n) .paper-surface { background-color:#f0e7d6; }
  .paper-fragment:nth-child(4n) .paper-surface { inset:10px 4px 5px 9px; background-color:#e8ddc8; }
  .hero-illustrations { position:absolute; top:calc(50% - 160px); left:0; right:0; transform:translateY(calc(-125px * var(--identity))); }
  .hero-identity { position:fixed; top:0; left:0; width:340px; text-align:center; transform:translate3d(calc(50vw - 170px),calc(50vh - 160px),0); transform-origin:top center; z-index:20; pointer-events:none; }
  .hero-identity[data-docked="true"] { border-radius:12px; background:#faf8f2e8; }
  .identity-art { height:200px; display:grid; place-items:center; }
  .mascot-portrait :global(button) { pointer-events:auto; }
  .hero-art { position:relative; width:min(640px,95vw); height:200px; display:grid; place-items:center; margin:auto; }
  .mascot-portrait { position:relative; width:220px; height:220px; }
  .mascot-portrait :global(button:focus-visible) { outline:2px solid var(--accent); outline-offset:2px; border-radius:50%; }
  h1 { width:100%; text-align:center; margin:0; font-size:clamp(2rem,5vw,2.8rem); letter-spacing:-.035em; }
  .ink-sketch { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .doodle { visibility:visible; transform-box:fill-box; transform-origin:center; opacity:calc(var(--reveal) * (1 - var(--handoff,0))); transform:translateY(calc(12px * (1 - var(--reveal)))) scale(calc(.82 + .18 * var(--reveal))); }
  .notebook { --reveal:var(--notebook); clip-path:inset(calc(100% * (1 - var(--reveal))) 0 0 0); }
  .arrow-one { --reveal:var(--arrow-one); }
  .arrow-two { --reveal:var(--arrow-two); }
  .lens { --reveal:var(--lens); clip-path:inset(calc(100% * (1 - var(--reveal))) 0 0 0); }
  .arrow-one path, .arrow-two path { stroke-dasharray:1; stroke-dashoffset:calc(1 - var(--reveal)); }
  .hero-details { opacity:calc(1 - var(--depart,0)); transform:translateY(calc(-30px * var(--depart,0))); position:absolute; top:calc(50% - 12px); left:24px; right:24px;  }
  .hero-role { opacity:var(--role); transform:translateY(calc(14px * (1 - var(--role)))); color:var(--fg); font-size:1rem; font-weight:550; margin:0 auto; }
  .hero-location { opacity:var(--location); transform:translateY(calc(12px * (1 - var(--location)))); font-family:Georgia,'Times New Roman',serif; font-style:italic; color:#6b5d49; font-size:1rem; margin:2px auto 15px; }
  .bio-intro { max-width:31rem; margin:auto; }
  .question-cue { display:flex; align-items:center; justify-content:flex-start; margin:0 auto -7px; max-width:350px; transform:translateX(-24px); }
  .margin-note { font-family:"Segoe Print","Bradley Hand",cursive; color:#57472f; font-size:1rem; margin:0; opacity:var(--question-line); transform:rotate(-3deg) translateY(calc(12px * (1 - var(--question-line)))); }
  .question-arrow { opacity:var(--question-curve); width:76px; height:46px; stroke:#57472f; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .question-paper { opacity:var(--question-note); position:relative; max-width:350px; margin:0 auto 20px; padding:25px 26px 18px 38px; background:#fffaf0 url('/img/paper-fibers.svg'); text-align:left; transform:translate(-24px,calc(25px * (1 - var(--question-note)))) rotate(calc(-2deg - 6deg * (1 - var(--question-note)))); filter:drop-shadow(2px 5px 5px #57402018); clip-path:polygon(0 0,100% 0,99.4% 15%,100% 29%,99.2% 43%,100% 58%,99.5% 76%,100% 100%,97% 98%,94% 100%,91% 98.5%,88% 100%,84% 98.6%,81% 100%,77% 98%,73% 100%,69% 98.5%,65% 100%,61% 98%,56% 100%,52% 98.5%,47% 100%,43% 98%,38% 100%,34% 98.6%,29% 100%,25% 98%,20% 100%,16% 98.5%,11% 100%,7% 98%,3% 100%,0 99%); }
  .question-paper p { font-family:Georgia,'Times New Roman',serif; font-size:1.25rem; line-height:1.45; color:#30291f; margin:0; }
  .binding-holes { position:absolute; top:0; bottom:0; left:9px; width:10px; background:radial-gradient(circle,#d2c3a8 3px,transparent 3.5px) center 10px / 10px 22px repeat-y; }
  .hero-nav { position:absolute; top:0; left:20px; right:20px; display:flex; justify-content:center; flex-wrap:wrap; gap:clamp(32px,5vw,85px); opacity:calc(var(--nav) * (1 - var(--collapse,0))); transform:translateY(calc(12px * (1 - var(--nav)))) scale(calc(1 - .6 * var(--collapse,0))); }
  .hero-nav a { position:relative; color:#342b20; text-decoration:none; font-family:'Cormorant Garamond',Georgia,serif; font-weight:500; font-size:1.65rem; line-height:1.2; padding:10px 8px 16px; }
  .hero-nav a span { display:inline-block; transition:transform 220ms cubic-bezier(.16,1,.3,1),color 220ms; }
  .hero-nav a svg { position:absolute; left:5%; bottom:5px; width:90%; height:9px; stroke:#79613e; stroke-width:1.5; stroke-linecap:round; }
  .hero-nav a path { stroke-dasharray:1; stroke-dashoffset:1; transition:stroke-dashoffset 350ms cubic-bezier(.16,1,.3,1); }
  .hero-nav a:hover span, .hero-nav a:focus-visible span { transform:translateY(-3px) rotate(-3deg); color:#705832; }
  .hero-nav a:hover path, .hero-nav a:focus-visible path { stroke-dashoffset:0; }
  .hero-nav a:focus-visible { outline:1px solid #79613e; outline-offset:4px; border-radius:4px; }
  .navigation-shell { --collapse:0; --nav:1; position:fixed; top:0; left:0; width:640px; max-width:calc(100% - 32px); transform:translate3d(calc(50vw - 320px),50px,0); z-index:30; pointer-events:none; }
  .hero-nav a { pointer-events:auto; }
  .navigation-shell[data-collapsed="true"] .hero-nav { pointer-events:none; }
  .navigation-shell[data-collapsed="true"] .hero-nav a { pointer-events:none; }
  .pyramid-toggle { position:absolute; top:0; left:50%; transform:translateX(-50%) scale(calc(.7 + .3 * var(--collapse))); opacity:var(--collapse); border:0; background:transparent; color:#57472f; padding:6px 10px; min-height:54px; cursor:pointer; display:flex; align-items:center; flex-direction:column; gap:0; pointer-events:none; }
  .pyramid-toggle svg { width:86px; height:37px; transition:transform 450ms ease; }
  .pyramid-toggle span { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.15rem; }
  .pyramid-toggle:hover svg { transform:translateY(-4px); }
  .navigation-shell[data-collapsed="true"] .pyramid-toggle { pointer-events:auto; }
  .navigation-shell[data-open="true"] .hero-nav { top:78px; left:50%; right:auto; width:160px; padding:14px; gap:0; flex-direction:column; background:#fffaf0; box-shadow:2px 8px 22px #57402025; opacity:1; transform:translateX(-50%); pointer-events:auto; border-radius:2px; animation:menu-panel-in 450ms cubic-bezier(.16,1,.3,1); }
  .navigation-shell[data-open="true"] .hero-nav a { pointer-events:auto; font-size:1.45rem; padding:10px 16px; text-align:left; animation:menu-link-in 420ms both; }
  .navigation-shell[data-open="true"] .hero-nav a:nth-child(2) { animation-delay:50ms; }
  .navigation-shell[data-open="true"] .hero-nav a:nth-child(3) { animation-delay:100ms; }
  .navigation-shell[data-open="true"] .hero-nav a:nth-child(4) { animation-delay:150ms; }
  @keyframes menu-panel-in { from { opacity:0; clip-path:inset(0 0 100% 0); } to { opacity:1; clip-path:inset(0); } }
  @keyframes menu-link-in { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:none; } }
  @media(prefers-reduced-motion:reduce) { .pyramid-toggle svg { transition:none; } .navigation-shell[data-open="true"] .hero-nav, .navigation-shell[data-open="true"] .hero-nav a { animation:none; } }
  .skip-intro { position:absolute; top:12px; left:12px; z-index:5; padding:10px 16px; background:var(--bg); transform:translateY(-200%); }
  .skip-intro:focus { transform:none; }
  @media (max-width:600px) {
    .hero-illustrations { top:calc(50% - 150px); transform:translateY(calc(-135px * var(--identity))); }
    .identity-art { height:170px; }
    .hero-art { height:170px; }
    .mascot-portrait { transform:scale(.85); }
    .ink-sketch { width:110%; left:-5%; }
    .hero-details { top:calc(50% - 65px); left:24px; right:24px; }
    .hero-role { opacity:var(--role); transform:translateY(calc(14px * (1 - var(--role)))); font-size:.9375rem; }
    .hero-location { margin-bottom:12px; }
    .question-cue { transform:translateX(-6px); }
    .question-paper { transform:translate(-6px,calc(25px * (1 - var(--question-note)))) rotate(-2deg); padding:22px 20px 18px 32px; margin-bottom:16px; }
    .question-paper p { font-size:1.15rem; }
    .hero-nav { gap:clamp(14px,4vw,26px); top:0; left:8px; right:8px; }
    .hero-nav a { font-size:1.35rem; padding-inline:4px; }

  }
  @media (max-height:700px) and (prefers-reduced-motion:no-preference) {
    .hero-illustrations { top:calc(50% - 140px); transform:translateY(calc(-100px * var(--identity))); }
