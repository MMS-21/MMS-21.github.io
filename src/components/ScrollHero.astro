---
import HeroIntroduction from './HeroIntroduction.astro';
import WelcomeGarden from './WelcomeGarden.astro';
import { Mascot } from 'page-mascot';
const NAV=[{href:'/projects/',label:'Projects'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
---
<a class="skip-intro" href="#featured-work">Skip introduction</a>
<nav class="stack-navigation" aria-label="Main">{NAV.map(item=><a href={item.href}>{item.label}</a>)}</nav>
<section class="scroll-hero" id="pre-hero" tabindex="-1" aria-label="Introduction" data-animated="false">
 <div class="mobile-welcome opening-welcome"><WelcomeGarden arabic hideFollow /></div>
 <a class="opening-cue" href="#hero-story">Scroll down<svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><path d="M15 5c16 8 12 20 5 35m-7-9 7 10 10-6"/></svg></a>
 <div class="hero-identity"><div class="identity-art"><div class="mascot-portrait"><Mascot client:load directions="/mascots/moaaz-directions.webp" reactions="/mascots/moaaz-reactions.webp" size={136} label="Moaaz avatar" /></div></div></div>
</section>
<section class="intro-chapter" id="hero-story" tabindex="-1" aria-label="About Moaaz"><HeroIntroduction /></section>
<script>
 const opening=document.querySelector<HTMLElement>('.scroll-hero')!;
 const portrait=opening.querySelector<HTMLElement>('.hero-identity')!;
 const intro=document.querySelector<HTMLElement>('.intro-chapter')!;
 const controls=document.querySelector<HTMLElement>('.profile-controls');
 const nav=document.querySelector<HTMLElement>('.stack-navigation');
 const note=document.querySelector<HTMLElement>('.introduction-note');
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let frame=0;
 const clamp=(v:number)=>Math.max(0,Math.min(1,v));
 const smooth=(v:number)=>{v=clamp(v);return v*v*(3-2*v)};
 function draw(){
  frame=0;
  const h=innerHeight,w=document.documentElement.clientWidth,y=scrollY;
  const start=opening.getBoundingClientRect().top+y;
  const p=clamp((y-start)/Math.max(1,opening.offsetHeight));
  const dock=smooth((p-.18)/.48),mobile=w<=700;
  const centeredX=w/2-68;
  const startY=h/2-225;
  const middleY=h/2-68;
  const float=smooth(p/.18);
  const centerY=startY+(middleY-startY)*float;
  const targetX=mobile?18:32,targetY=mobile?84:76;
  const x=centeredX+(targetX-centeredX)*dock;
  const top=centerY+(targetY-centerY)*dock;
  const scale=1-.34*dock;
  portrait.style.transform=`translate3d(${x}px,${top}px,0) scale(${scale})`;
  document.body.dataset.opening=String(p<.28);
  if(controls)controls.inert=p<.28;
  if(nav)nav.inert=p<.28;
  const rect=intro.getBoundingClientRect();
  const enter=reduced.matches?1:smooth((h-rect.top)/(h*.65));
  if(note){note.style.setProperty('--stamp-enter',String(enter));note.style.visibility=enter>.01?'visible':'hidden'}
 }
 function schedule(){if(!frame)frame=requestAnimationFrame(draw)}
 note?.addEventListener('pointermove',e=>{if(reduced.matches||e.pointerType==='touch')return;const r=note.getBoundingClientRect();note.style.setProperty('--note-x',`${((e.clientX-r.left)/r.width-.5)*8}px`);note.style.setProperty('--note-y',`${((e.clientY-r.top)/r.height-.5)*6}px`)});
 note?.addEventListener('pointerleave',()=>{note.style.setProperty('--note-x','0px');note.style.setProperty('--note-y','0px')});
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule,{passive:true});reduced.addEventListener('change',schedule);document.fonts.ready.then(schedule);draw();
</script>
<style>
@font-face{font-family:Astoria;src:url('/fonts/astoria.otf') format('opentype');font-weight:400;font-display:swap}
.scroll-hero{position:relative;height:100svh;min-height:620px}
.opening-welcome{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,calc(100% - 48px));height:220px;pointer-events:none}
.opening-welcome :global(.welcome-garden){width:100%;max-width:none;height:220px}
.opening-welcome :global(.arabic-calligraphy){inset:25px 0 auto;font-size:clamp(30px,4.1vw,52px);text-align:center}
.opening-welcome :global(canvas){height:260px}
.hero-identity{position:fixed;top:0;left:0;z-index:40;width:136px;height:136px;transform-origin:top left;will-change:transform}
.identity-art,.mascot-portrait{width:136px;height:136px}
.stack-navigation{position:fixed;left:32px;top:20px;z-index:45;display:flex;gap:24px}
.stack-navigation a{display:flex;align-items:center;min-height:44px;font:400 12px/20px Astoria,system-ui,sans-serif;letter-spacing:.02em;text-decoration:none;color:#514c45}
.stack-navigation a:hover{text-decoration:underline;text-underline-offset:5px}
.stack-navigation a:focus-visible,.opening-cue:focus-visible{outline:2px solid #79613e;outline-offset:5px}
:global(body[data-opening="true"] .profile-controls),:global(body[data-opening="true"] .stack-navigation){opacity:0;visibility:hidden;pointer-events:none}
:global(.profile-controls),.stack-navigation{transition:opacity 220ms ease,visibility 220ms ease}
.opening-cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:4px;color:#57472f;font:500 19px/1.3 'Cormorant Garamond',Georgia,serif;text-decoration:none}
.opening-cue svg{width:30px;height:40px;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.intro-chapter{position:relative;min-height:100svh;display:grid;align-items:center;padding:145px 72px 90px 150px;scroll-margin-top:0}
.skip-intro{position:fixed;top:-100px;left:16px;z-index:100}.skip-intro:focus{top:12px;background:#fffaf0;padding:12px}
@media(max-width:900px){.stack-navigation{left:28px;top:12px;gap:16px}.stack-navigation a{font-size:11px}}
@media(max-width:700px){:global(.profile-controls){position:fixed}.scroll-hero{min-height:560px}.stack-navigation{display:none}.intro-chapter{padding:180px 24px 70px}.opening-welcome :global(.arabic-calligraphy){font-size:clamp(22px,6.3vw,40px)}.opening-welcome{height:190px}.opening-welcome :global(.welcome-garden){height:190px}}
@media(prefers-reduced-motion:reduce){.hero-identity{will-change:auto}:global(.profile-controls),.stack-navigation{transition:none}}
</style>