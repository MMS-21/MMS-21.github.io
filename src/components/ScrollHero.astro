---
import { Mascot } from 'page-mascot';
import { SITE, BIO_LEAD, BIO_DETAIL } from '../data/site';
const NAV = [{href:'/projects/',label:'Projects'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
const fragments = [
  {clip:'polygon(0 0, 34% 0, 32% 13%, 35% 24%, 31% 38%, 34% 50%, 0 52%)',x:-360,y:-190,r:-24},
  {clip:'polygon(34% 0, 68% 0, 66% 18%, 70% 31%, 66% 49%, 34% 50%, 31% 38%, 35% 24%, 32% 13%)',x:30,y:-400,r:18},
  {clip:'polygon(68% 0, 100% 0, 100% 51%, 66% 49%, 70% 31%, 66% 18%)',x:380,y:-220,r:28},
  {clip:'polygon(0 52%, 34% 50%, 32% 66%, 36% 81%, 33% 100%, 0 100%)',x:-380,y:240,r:20},
  {clip:'polygon(34% 50%, 66% 49%, 69% 65%, 65% 83%, 68% 100%, 33% 100%, 36% 81%, 32% 66%)',x:-30,y:420,r:-16},
  {clip:'polygon(66% 49%, 100% 51%, 100% 100%, 68% 100%, 65% 83%, 69% 65%)',x:390,y:260,r:-25},
];
---
<a class="skip-intro" href="#featured-work">Skip introduction</a>
<section class="scroll-hero" aria-label="Introduction">
  <div class="hero-stage">
    <div class="paper-background" aria-hidden="true">
      {fragments.map((piece,i)=><div class="paper-fragment" style={`clip-path:${piece.clip};--scatter-x:${piece.x}px;--scatter-y:${piece.y}px;--scatter-r:${piece.r}deg;--piece:${i}`}><div class="paper-surface"></div></div>)}
    </div>
    <div class="hero-identity">
      <div class="hero-art">
        <svg class="ink-sketch" viewBox="0 0 640 180" fill="none" aria-hidden="true" focusable="false">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- A loose notebook: observations become a direction. -->
            <path fill="var(--accent-soft)" d="M39 40 164 29 179 141 54 152Z" />
            <path d="m51 47 101-9 12 91-101 10Z M57 30l11 121 M80 51l54-5 M82 60l32-3" />
            <path d="m83 115-3-32 m3 32 62-6 M96 111l-1-15 m17 13-2-29 m20 27-3-41" />
            <path class="draw-line" pathLength="1" d="m85 96 19-16 14 5 23-23" />
            <path d="m135 62 7-1-1 8 M30 126l-7 10 m10-6-9-3 M176 45l8-8 m-4 15 12-2" />
            <path class="draw-line connection" pathLength="1" d="M188 100c27 23 46 22 68 4 m-10-2 11 1-4 10" />
            <!-- A hand-held lens: inspect the output before trusting it. -->
            <path fill="var(--accent-soft)" d="m471 32 103 8-7 104-103-9Z" />
            <path d="m487 49 66 5 m-67 8 40 3 m-43 48 23 2 m-24 10 31 2" />
            <circle cx="544" cy="91" r="27" fill="var(--bg)" />
            <circle cx="544" cy="91" r="21" />
            <path class="draw-line check-mark" pathLength="1" d="m533 91 8 8 15-17" />
            <path d="m563 112 24 28c5 6 14-2 9-8l-26-28 M587 150c-10 12-23 16-39 12 m-83-12-11 5 m8-14-10-2 M583 54l7-10 m1 19 12-2" />
            <path class="draw-line connection" pathLength="1" d="M384 107c22-17 40-15 65 1 m-6-9 7 10-12 2" />
          </g>
        </svg>

        <div class="mascot-portrait"><Mascot client:load directions="/mascots/moaaz-directions.webp" reactions="/mascots/moaaz-reactions.webp" size={220} label="Moaaz avatar" /></div>
      </div>
      <h1>{SITE.name}</h1>
    </div>
    <div class="hero-details">
      <p class="hero-role">{SITE.role} <span aria-hidden="true">·</span> {SITE.location}</p>
      <div class="bio-intro">
        <p class="margin-note">Start with the question.</p>
        <p class="bio-lead">{BIO_LEAD}</p>
        <svg class="pencil-mark" viewBox="0 0 300 12" aria-hidden="true"><path d="M3 8c65-7 165-7 293-3M35 11c57-4 117-4 194-3" /></svg>
        <p class="hero-lede">{BIO_DETAIL}</p>
      </div>
      <div class="hero-actions"><a href="/projects/">Explore my work <span aria-hidden="true">→</span></a><a href="/about/">About me</a></div>
    </div>
    <nav class="hero-nav" aria-label="Main">{NAV.map(item=><a href={item.href}>{item.label}</a>)}</nav>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.scroll-hero');
  if (hero) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const details = hero.querySelector<HTMLElement>('.hero-details')!;
    const nav = hero.querySelector<HTMLElement>('.hero-nav')!;
    const pieces = hero.querySelectorAll<HTMLElement>('.paper-fragment');
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => 1 - Math.pow(1 - clamp(n), 3);
    let frame = 0;
    const render = () => {
      frame = 0;
      const animated = !reduced.matches;
      hero.dataset.animated = String(animated);
      const distance = hero.offsetHeight - window.innerHeight;
      const progress = animated ? clamp(-hero.getBoundingClientRect().top / Math.max(1, distance)) : 1;
      hero.style.setProperty('--assembly', String(ease((progress - .025) / .48)));
      pieces.forEach((piece, index) => {
        piece.style.setProperty('--assembly', String(ease((progress - .025 - index * .018) / .4)));
      });
      hero.style.setProperty('--identity', String(ease((progress - .38) / .24)));
      hero.style.setProperty('--details', String(ease((progress - .54) / .24)));
      hero.style.setProperty('--doodles', String(ease((progress - .45) / .22)));
      hero.style.setProperty('--nav', String(ease((progress - .72) / .2)));
      details.inert = animated && progress < .58;
      nav.inert = animated && progress < .76;
      details.style.visibility = progress < .54 ? 'hidden' : 'visible';
      nav.style.visibility = progress < .72 ? 'hidden' : 'visible';
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', schedule, {passive:true});
    reduced.addEventListener('change', render);
    render();
  }
</script>
<style>
  .scroll-hero { --assembly:1; --identity:1; --details:1; --doodles:1; --nav:1; position:relative; margin:0; }
  .hero-stage { position:relative; min-height:780px; height:100svh; isolation:isolate; overflow:hidden; text-align:center; }
  .scroll-hero[data-animated="true"] { height:215svh; }
  [data-animated="true"] .hero-stage { position:sticky; top:0; min-height:0; }
  .paper-background { position:absolute; inset:4% max(2%, calc((100% - 1050px)/2)); z-index:-1; pointer-events:none; }
  .paper-fragment { position:absolute; inset:0; opacity:var(--assembly); transform:translate(calc(var(--scatter-x) * (1 - var(--assembly))),calc(var(--scatter-y) * (1 - var(--assembly)))) rotate(calc(var(--scatter-r) * (1 - var(--assembly)))); }
  .paper-surface { position:absolute; inset:0; background-color:#f0f6f8; background-image:linear-gradient(#6198b01c 1px,transparent 1px),linear-gradient(90deg,#6198b01c 1px,transparent 1px),radial-gradient(ellipse at 24% 28%,#b6d9ef8c,transparent 62%),radial-gradient(ellipse at 80% 72%,#c3deed99,transparent 60%); background-size:28px 28px,28px 28px,100% 100%,100% 100%; mask-image:radial-gradient(ellipse at center,#000 40%,#000b 70%,transparent 99%); }
  .hero-identity { position:absolute; top:calc(50% - 160px); left:0; right:0; transform:translateY(calc(-125px * var(--identity))); }
  .hero-art { position:relative; width:min(640px,95vw); height:200px; display:grid; place-items:center; margin:auto; }
  .mascot-portrait { position:relative; width:220px; height:220px; }
  .mascot-portrait :global(button:focus-visible) { outline:2px solid var(--accent); outline-offset:2px; border-radius:50%; }
  h1 { margin:12px 0 0; font-size:clamp(2rem,5vw,2.8rem); letter-spacing:-.035em; }
  .ink-sketch { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; opacity:var(--doodles); transform:scale(calc(.8 + .2 * var(--doodles))); }
  .hero-details { position:absolute; top:calc(50% - 24px); left:24px; right:24px; opacity:var(--details); transform:translateY(calc(40px * (1 - var(--details)))) scale(calc(.96 + .04 * var(--details))); clip-path:inset(0 0 calc(100% * (1 - var(--details))) 0); }
  .hero-role { color:#4c636c; font-size:.9375rem; margin:0 auto 20px; }
  .bio-intro { max-width:29rem; margin:auto; }
  .margin-note { font-family:"Segoe Print","Bradley Hand",cursive; color:var(--accent); font-size:.9375rem; margin:0 0 8px; transform:rotate(-3deg); }
  .bio-lead { font-size:clamp(1.35rem,3.5vw,1.65rem); line-height:1.4; font-weight:600; letter-spacing:-.02em; text-wrap:balance; margin:0; }
  .pencil-mark { display:block; width:65%; height:12px; margin:4px auto 14px; fill:none; stroke:var(--accent); stroke-width:1.7; stroke-linecap:round; }
  .hero-lede { color:#4c636c; font-size:1rem; margin:0; line-height:1.65; }
  .hero-actions { display:flex; justify-content:center; gap:24px; margin-top:20px; font-size:.9375rem; }
  .hero-actions a:first-child { font-weight:650; }
  .hero-nav { position:absolute; bottom:25px; left:16px; right:16px; display:flex; justify-content:center; flex-wrap:wrap; gap:28px; opacity:var(--nav); }
  .hero-nav a { color:var(--fg); text-decoration:none; font-size:.9375rem; padding:8px 2px; }
  .hero-nav a:hover { color:var(--accent); text-decoration:underline; text-underline-offset:5px; }
  .skip-intro { position:absolute; top:12px; left:12px; z-index:5; padding:10px 16px; background:var(--bg); transform:translateY(-200%); }
  .skip-intro:focus { transform:none; }
  @media (max-width:600px) {
    .hero-identity { top:calc(50% - 150px); transform:translateY(calc(-135px * var(--identity))); }
    .hero-art { height:170px; }
    .mascot-portrait { transform:scale(.85); }
    .ink-sketch { width:110%; left:-5%; }
    .hero-details { top:calc(50% - 30px); left:22px; right:22px; }
    .hero-role { font-size:.8rem; margin-bottom:14px; }
    .hero-lede { font-size:.9rem; }
    .bio-lead { font-size:1.3rem; }
    .hero-nav { gap:20px; bottom:12px; }
    .hero-actions { margin-top:16px; }
  }
  @media (max-height:670px) and (prefers-reduced-motion:no-preference) {
    .hero-identity { top:calc(50% - 140px); transform:translateY(calc(-140px * var(--identity))); }
    .hero-art { height:135px; }
    .mascot-portrait { transform:scale(.65); }
    h1 { margin:0; font-size:1.8rem; }
    .hero-details { top:calc(50% - 70px); }
    .margin-note { display:none; }
    .hero-role { margin-bottom:10px; }
    .hero-lede { font-size:.85rem; }
    .hero-nav { bottom:8px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .hero-stage { height:auto; min-height:780px; }
  }
</style>
