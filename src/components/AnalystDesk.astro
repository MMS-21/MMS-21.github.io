---
import FloralAccent from './FloralAccent.astro';
import PaperLandmark from './PaperLandmark.astro';
const papers=[
 {title:'Check the records',type:'Financial reconciliation',text:'Reconcile records. Investigate discrepancies.',note:'Start with numbers you can trust.',index:0},
 {title:'Understand the gaps',type:'Inventory & logistics',text:'Connect inventory and logistics. Find what is missing.',note:'Follow the work behind the numbers.',index:4},
 {title:'Make the next step clear',type:'Reporting & automation',text:'Build clear reports. Automate repeat work.',note:'Less repetition. More useful answers.',index:6},
];
---
<div class="analyst-desk" id="work-routine" tabindex="-1" aria-labelledby="desk-introduction-title">
 <header class="desk-message"><h2 id="desk-introduction-title">Making everyday business data<br class="wide-break" /> easier to trust and act on.</h2><div class="headline-branch" aria-hidden="true"><svg viewBox="0 0 600 40" preserveAspectRatio="none" fill="none"><path pathLength="1" d="M2 23C130 5 230 38 330 21S490 8 598 23"/></svg><FloralAccent mode="desk-branch" /></div><p>Reliable records. Clear reports. Less manual work.</p></header>
 <div class="working-papers">{papers.map((paper,i)=><article class="working-paper" style={`--paper-progress:var(--paper-${i},1);--paper-index:${i};--angle:${[-3,2,-1][i]}deg`}>
  <PaperLandmark index={paper.index}/><div class="paper-content"><span class="workflow-step" aria-label={`Step ${i+1}`}>{i+1}</span><p class="document-type">{paper.type}</p>
  <svg class="working-mark" viewBox="0 0 160 48" fill="none" aria-hidden="true">{i===0?<><path d="M4 9h107M4 24h107M4 39h68M37 4v39M78 4v39"/><path d="m119 25 10 10 23-28"/></>:i===1?<><path d="M6 12h38v27H6zM62 4h37v35H62zM117 18h36v21h-36zM44 26h18M99 26h18"/><path d="m53 21 5 5-5 5m55-10 5 5-5 5"/></>:<><path d="M5 39V9h31v30M51 39V19h31v20M98 39V3h31v36M3 44h135"/><path d="m143 7 10 8-10 8"/></>}</svg>
  <h3>{paper.title}</h3><p class="paper-description">{paper.text}</p></div>
  {i<2&&<svg class="workflow-arrow" viewBox="0 0 48 28" fill="none" aria-hidden="true"><path pathLength="1" d="M2 18C12 5 25 6 42 12m-9-8 10 8-12 7"/></svg>}
 </article>)}</div>
 <div class="workflow-tools"><p>Tools I’m building</p><div><a href="https://github.com/MMS-21/sina-agent">Sina Agent <span>Analysis, research, and study workflows</span></a><a href="/projects/analytics-agent/">Analytics Agent <span>Customer analysis, charts, and reports</span></a></div></div>
 <div class="journey-bridge"><svg class="ink-trail" viewBox="0 0 760 55" preserveAspectRatio="none" fill="none" aria-hidden="true"><path pathLength="1" d="M4 20C130 45 190 2 300 22S510 43 610 20 710 15 756 35m-13-12 13 12-17 4"/></svg><FloralAccent mode="edge"/><a class="desk-work-link" href="#featured-work">See the work <span aria-hidden="true">↓</span></a></div>
</div>
<style>
.analyst-desk{position:absolute;inset:115px 80px 35px 245px;color:#30291f;text-align:left;opacity:var(--work-reveal,1);visibility:var(--work-visibility,visible);pointer-events:auto;max-width:1080px;margin:auto}
.desk-message{max-width:760px;margin:0 auto 30px}.desk-message h2{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2.4rem,3.5vw,3.5rem);font-weight:500;line-height:1.05;letter-spacing:-.025em;margin:0 0 16px;text-wrap:balance}.desk-message>p{max-width:65ch;line-height:1.7;font-size:.92rem;color:#605441;margin:0}
.working-papers{display:flex;gap:18px;align-items:stretch;padding:16px 3px}.working-paper{position:relative;flex:1;min-width:0;background:#fffaf0 url('/img/paper-fibers.svg');box-shadow:4px 10px 20px #66503720;transform:translateY(calc((1 - var(--paper-reveal,1))*35px*(var(--paper-index) + 1))) rotate(var(--angle));transition:transform 180ms linear;border-bottom:2px solid #d8cbb7}.working-paper:nth-child(2){margin-top:18px;margin-bottom:-18px}.paper-content{position:relative;padding:23px 20px;z-index:1}.working-paper :global(.paper-landmark){opacity:.12;inset:25% 8% 8%;}.document-type{text-transform:uppercase;letter-spacing:.09em;font-size:.62rem;color:#65533a;margin:0 0 16px}.working-mark{width:120px;height:38px;stroke:#426b7d;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;margin-bottom:16px}.working-paper h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:1.8rem;line-height:1.05;margin:0 0 12px}.paper-description{font-size:.8rem;line-height:1.7;margin:0;color:#5c503f}.handwritten{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:1.05rem;line-height:1.2;color:#735f40;border-top:1px solid #d7c9af;padding-top:14px;margin:18px 0 0}.journey-bridge{position:relative;max-width:760px;margin:34px auto 0;text-align:center}.ink-trail{width:100%;height:35px;stroke:#60869a;stroke-width:1.4;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--paper-reveal,1))}.desk-work-link{position:relative;z-index:2;display:inline-flex;gap:14px;align-items:center;color:#31596d;text-decoration:none;border-bottom:1px solid #8299a2;font-size:.9rem;padding:10px 0;margin-top:15px}.desk-work-link:hover{color:#30291f}.desk-work-link:focus-visible{outline:2px solid #60869a;outline-offset:5px}.journey-bridge :global(.floral-accent){inset:-60px 0 auto;opacity:.8}
@media(max-width:1000px) and (min-width:701px){.analyst-desk{left:185px;right:45px;top:110px}.paper-content{padding:18px 14px}.working-papers{gap:10px}.working-paper h3{font-size:1.6rem}.desk-message h2{font-size:2.7rem}.wide-break{display:none}.handwritten{font-size:.95rem}}
@media(max-width:700px){.analyst-desk{inset:210px 28px 20px}.desk-message{margin-bottom:17px}.desk-message h2{font-size:1.85rem;margin-bottom:10px}.desk-message>p{font-size:.78rem;line-height:1.55}.wide-break{display:none}.working-papers{display:block;padding:0}.working-paper{margin:0 0 12px!important;transform:translateX(calc((1 - var(--paper-reveal,1))*20px)) rotate(calc(var(--angle)*.3))}.paper-content{padding:13px 15px}.document-type{font-size:.56rem;margin-bottom:5px}.working-mark,.handwritten{display:none}.working-paper h3{font-size:1.4rem;margin-bottom:5px}.paper-description{font-size:.73rem;line-height:1.5}.journey-bridge{margin-top:10px}.ink-trail{height:20px}.desk-work-link{margin-top:2px;padding:6px 0}.journey-bridge :global(.floral-accent){inset:-75px 0 auto}}
@media(max-height:730px) and (min-width:701px){.analyst-desk{top:100px}.desk-message{margin-bottom:12px}.desk-message h2{font-size:2.7rem}.paper-content{padding:16px}.working-mark{height:25px;margin-bottom:10px}.handwritten{margin-top:12px;padding-top:10px}.journey-bridge{margin-top:22px}}
@media(prefers-reduced-motion:reduce){.analyst-desk{opacity:1;visibility:visible}.working-paper{transition:none}.ink-trail{stroke-dashoffset:0}}
</style>

<style>
.analyst-desk{left:180px;right:80px;text-align:center}.desk-message{max-width:760px}.desk-message h2{font-size:clamp(2rem,2.7vw,2.75rem);margin-bottom:0}.desk-message>p{margin-inline:auto}.working-papers{justify-content:center;text-align:left;max-width:990px;margin-inline:auto}.headline-branch{position:relative;height:48px;max-width:600px;margin:5px auto 12px;pointer-events:none}.headline-branch>svg{position:absolute;inset:0;width:100%;height:40px;stroke:#60869a;stroke-width:1.3;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--branch-growth,1))}.headline-branch :global(.floral-accent){inset:-77px 0 auto;height:200px}
@media(max-width:1000px) and (min-width:701px){.analyst-desk{left:165px;right:55px}.desk-message h2{font-size:2.25rem}.headline-branch{height:38px;margin-bottom:8px}}
@media(max-width:700px){.analyst-desk{inset:135px 28px 20px}.desk-message h2{font-size:1.8rem}.headline-branch{height:36px;margin:3px auto 8px}.working-papers{text-align:left}.desk-message{margin-bottom:14px}}
</style>

<style>
.working-paper{opacity:var(--paper-progress,1);transform:translateY(calc((1 - var(--paper-progress,1))*45px)) rotate(var(--angle));transition:transform 100ms linear,opacity 100ms linear}.paper-description{max-width:26ch}.paper-content{padding-bottom:28px}
@media(max-width:700px){.working-paper{transform:translateY(calc((1 - var(--paper-progress,1))*24px)) rotate(calc(var(--angle)*.3))}.paper-content{padding-bottom:15px}}
@media(prefers-reduced-motion:reduce){.working-paper{opacity:1;transform:none;transition:none}}
</style>

<style>
.analyst-desk{max-width:1000px;top:110px;bottom:auto}.working-papers{gap:36px;padding-top:12px;max-width:900px}.working-paper{flex:1}.paper-content{padding:18px 18px 22px}.working-paper h3{font-size:1.65rem}.document-type{padding-right:16px;min-height:2.6em;margin-bottom:10px}.working-mark{height:30px;width:105px;margin-bottom:12px}.workflow-step{position:absolute;right:12px;top:12px;color:#426b7d;font:500 1rem 'Cormorant Garamond',Georgia,serif}.workflow-arrow{position:absolute;left:calc(100% + 1px);top:45%;width:36px;height:28px;stroke:#426b7d;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--paper-progress,1));pointer-events:none}.workflow-tools{position:relative;z-index:2;margin:44px auto 0;max-width:700px}.workflow-tools>p{font:500 1.3rem 'Cormorant Garamond',Georgia,serif;margin:0 0 12px}.workflow-tools>div{display:flex;justify-content:center;gap:20px 40px}.workflow-tools a{color:#31596d;text-decoration:underline;text-underline-offset:4px;min-height:44px;font-size:.92rem;line-height:1.5}.workflow-tools a span{display:block;color:#605441;font-size:.78rem;margin-top:5px}.workflow-tools a:hover{color:#705832}.workflow-tools a:focus-visible{outline:2px solid #426b7d;outline-offset:5px}.journey-bridge{margin-top:16px}.ink-trail{height:24px}.desk-work-link{margin-top:8px}
@media(max-width:1000px) and (min-width:701px){.working-papers{gap:26px}.workflow-arrow{width:26px}.paper-content{padding:16px 12px 20px}.working-paper h3{font-size:1.5rem}.document-type{font-size:.58rem}.workflow-tools{margin-top:38px}}
@media(max-height:760px) and (min-width:701px){.analyst-desk{top:95px}.desk-message{margin-bottom:14px}.desk-message h2{font-size:2rem}.headline-branch{height:28px}.paper-content{padding-top:12px;padding-bottom:16px}.working-mark{height:24px;margin-bottom:6px}.working-paper h3{margin-bottom:6px}.workflow-tools{margin-top:30px}.journey-bridge{margin-top:8px}.journey-bridge :global(.floral-accent){display:none}}
@media(max-width:700px),(max-height:760px),(prefers-reduced-motion:reduce){.analyst-desk{position:relative;inset:auto;max-width:1000px;padding:30px 40px 64px;opacity:1;visibility:visible;scroll-margin-top:110px}.working-paper{opacity:1;transform:rotate(var(--angle));transition:none}.workflow-arrow{stroke-dashoffset:0}.ink-trail{stroke-dashoffset:0}}
@media(max-width:700px){.desk-message h2{font-size:2rem}.desk-message>p{font-size:.9rem}.headline-branch{height:40px;margin-bottom:16px}.working-papers{display:flex;flex-direction:column;gap:38px;max-width:370px;margin:28px auto 0}.working-paper{margin:0!important;transform:rotate(calc(var(--angle)*.4))}.paper-content{padding:18px 20px 22px}.document-type{min-height:0;font-size:.65rem;margin-bottom:10px}.working-mark{display:block;width:110px;height:28px;margin-bottom:12px}.working-paper h3{font-size:1.7rem}.paper-description{font-size:.9rem;line-height:1.6;max-width:32ch}.workflow-arrow{left:calc(50% - 18px);top:calc(100% + 6px);width:36px;height:28px;transform:rotate(90deg)}.workflow-tools{margin-top:40px}.workflow-tools>div{flex-direction:column;gap:20px}.workflow-tools a{font-size:1rem}.workflow-tools a span{font-size:.84rem}.journey-bridge{margin-top:32px}.journey-bridge :global(.floral-accent){opacity:.5}.desk-work-link{font-size:1rem}}
@media(prefers-reduced-motion:reduce){.workflow-arrow{stroke-dashoffset:0}}
</style>
