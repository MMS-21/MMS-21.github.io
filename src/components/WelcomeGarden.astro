---
const { word = 'Welcome', follow = 'to my little corner.' } = Astro.props;
---
<div class="welcome-garden"><p aria-label={`${word} ${follow}`}>{word.split('').map((letter,i)=><span style={`--letter:${i}`}>{letter}</span>)}</p><span class="welcome-follow" aria-hidden="true">{follow}</span><canvas aria-hidden="true"></canvas></div>
<script>
 import { startWelcomeGardens } from '../scripts/welcome-garden.js';
 startWelcomeGardens();
</script>
<style>
.welcome-garden{position:relative;height:190px;width:100%;max-width:450px;margin:auto;isolation:isolate}.welcome-garden p{position:absolute;inset:48px 0 auto;margin:0;text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(3.6rem,7vw,5rem);font-weight:500;line-height:1.1;color:#30291f}.welcome-garden span{display:inline-block;opacity:0;transform:translateY(9px);transition:opacity 900ms ease,transform 1200ms cubic-bezier(.16,1,.3,1);transition-delay:calc(var(--letter)*140ms)}.welcome-garden[data-blooming="true"] span{opacity:1;transform:none} .welcome-garden .welcome-follow{position:absolute;top:150px;left:0;right:0;text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.45rem;font-style:italic;color:#57472f;transition-delay:1100ms}canvas{position:absolute;inset:0;width:100%;height:190px;pointer-events:none}@media(prefers-reduced-motion:reduce){.welcome-garden span{opacity:1;transform:none;transition:none}}
</style>
