---
import ProjectPaperDeck from './ProjectPaperDeck.astro';
---

<section class="desk-scene" id="featured-work" tabindex="-1" aria-labelledby="featured-heading">
  <div class="desk-stage">
    <div class="work-section-opening">
      <h2 id="featured-heading" class="work-section-label">Selected work</h2>
      <a class="work-index-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
    </div>
    <ProjectPaperDeck />
    <a class="scroll-cue" href="#about" aria-label="Scroll down to the path so far">
      <span>Scroll down</span>
      <svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><path d="M15 5c16 8 12 20 5 35m-7-9 7 10 10-6"/></svg>
    </a>
  </div>
</section>

<style>
  .desk-scene {
    position: relative;
    color: #302d28;
    pointer-events: none;
  }

  .desk-stage {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    max-width: 1280px;
    margin-inline: auto;
    padding: 100px 100px 48px 160px;
  }

  .work-section-opening {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 48px;
    max-width: 660px;
    margin: 0 auto 40px;
    pointer-events: auto;
  }

  .work-section-label {
    margin: 0;
    font: 400 36px/40px 'Zodiak', Georgia, serif;
    letter-spacing: -.025em;
  }

  .work-index-link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    color: #31596d;
    font: 400 14px/20px Manrope, sans-serif;
    text-underline-offset: 5px;
    white-space: nowrap;
    transition: translate .45s var(--portfolio-ease);
  }

  .work-index-link:hover { translate: 4px -2px; }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: fit-content;
    margin: 16px auto 0;
    color: #79613e;
    font: 1.1rem 'Cormorant Garamond', Georgia, serif;
    text-decoration: none;
    pointer-events: auto;
  }

  .scroll-cue svg {
    width: 22px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .work-index-link:focus-visible,
  .scroll-cue:focus-visible {
    outline: 2px solid #31596d;
    outline-offset: 5px;
  }

  @media (max-width: 950px) {
    .desk-stage { padding-inline: clamp(96px, 17vw, 160px) clamp(48px, 10vw, 100px); }
  }

  @media (max-width: 700px) {
    .desk-stage { padding: 96px 24px 48px; }
    .work-section-opening { gap: 12px; margin-bottom: 24px; }
    .work-section-label { font-size: clamp(26px, 7.5vw, 30px); line-height: 36px; }
    .work-index-link { gap: 8px; }
    .scroll-cue { margin-top: 12px; }
  }
</style>
