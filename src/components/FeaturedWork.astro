---
import FloralAccent from './FloralAccent.astro';
---
<section class="desk-scene" id="featured-work" tabindex="-1" aria-labelledby="featured-heading">
 <div class="desk-stage">
  <header class="desk-heading"><h2 id="featured-heading">Featured work</h2><p>A useful question. A closer look. Something you can use.</p></header>
  <div class="case-papers">
   <article class="work-paper customer-paper">
    <a class="preview" href="/projects/ecommerce-clv-churn/" aria-label="Explore the customer retention case study"><img src="/img/ecommerce/segment-revenue.svg" width="900" height="734" loading="lazy" alt="Customer segments compared by customer share and historical revenue share." /></a>
    <div class="project-copy"><h3><a href="/projects/ecommerce-clv-churn/">Which customers should we focus on?</a></h3><p>Connecting customer value, buying patterns, and churn risk to a clearer retention priority.</p><div class="paper-foot"><span>Python · Customer analytics</span><a href="/projects/ecommerce-clv-churn/">Read the case study →</a></div></div>
    <FloralAccent mode="edge" />
   </article>
   <article class="work-paper hr-paper">
    <a class="preview" href="/projects/hr-attrition-analysis/" aria-label="Explore the employee attrition case study"><img src="/img/hr/attrition-overview.svg" width="960" height="580" loading="lazy" alt="Attrition proportions: overall 16.1%, overtime 30.5%, no overtime 10.4%, Sales Representatives 39.8%, Laboratory Technicians 23.9%." /></a>
    <div class="project-copy"><h3><a href="/projects/hr-attrition-analysis/">Where should HR focus its retention efforts?</a></h3><p>Exploring employee attrition across roles, overtime, and experience, and turning the findings into a practical retention briefing.</p><div class="paper-foot"><span>Power BI · SQL · Python</span><a href="/projects/hr-attrition-analysis/">Read the case study →</a></div></div>
    <FloralAccent mode="edge" />
   </article>
  </div>
  <div class="tool-papers">
   <article class="work-paper tool-paper"><div><h3><a href="/projects/analytics-agent/">From data to an inspectable report</a></h3><p>analytics-agent · Python tools and a report quality gate</p></div><a class="tool-link" href="/projects/analytics-agent/" aria-label="Explore analytics-agent">Explore →</a></article>
   <article class="work-paper tool-paper"><div><h3><a href="/projects/ai-tell/">A closer look at document authorship</a></h3><p>ai-tell · A desktop application for authorship signals</p></div><a class="tool-link" href="/projects/ai-tell/" aria-label="Explore ai-tell">Explore →</a></article>
  </div>
  <a class="all-projects" href="/projects/">Explore all projects →</a>
  <a class="scroll-cue" href="#about" aria-label="Continue to the path so far"><svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><path d="M15 5c16 8 12 20 5 35m-7-9 7 10 10-6"/></svg></a>
 </div>
</section>
<style>
 .desk-scene{position:relative;margin:0;scroll-margin-top:25px;color:#302d28}
 .desk-stage{position:relative;max-width:1200px;margin:auto;padding:80px 60px 95px 150px}
 .desk-heading{text-align:center;margin-bottom:42px}
 h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;letter-spacing:-.025em;text-wrap:balance}
 h2{font-size:clamp(2.8rem,5vw,4rem);margin:0 0 12px;line-height:1.1}
 .desk-heading p{font-size:.93rem;color:#665b4c;margin:0;line-height:1.7}
 .case-papers{display:grid;grid-template-columns:1.12fr 1fr;gap:38px;align-items:start}
 .work-paper{position:relative;background:#fffaf0;box-shadow:3px 12px 25px #59472920;transition:transform 350ms cubic-bezier(.16,1,.3,1),box-shadow 350ms;}
 .customer-paper{transform:rotate(-2deg);padding:16px 16px 25px}
 .hr-paper{transform:rotate(2deg);margin-top:25px;padding:16px 16px 25px}
 .case-papers .work-paper:hover,.case-papers .work-paper:focus-within{transform:translateY(-5px) rotate(0);box-shadow:3px 18px 30px #59472928}
 .preview{display:block;background:#fffaf0}
 .preview img{display:block;width:100%;height:240px;object-fit:contain}
 .project-copy{padding:18px 12px 0}
 h3{font-size:clamp(1.8rem,2.6vw,2.25rem);line-height:1.08;margin:0 0 14px}
 h3 a{text-decoration:none;color:inherit}
 .project-copy>p{font-size:.85rem;line-height:1.75;color:#665b4c;margin:0 0 24px}
 .paper-foot{display:flex;flex-direction:column;gap:12px;font-size:.78rem}
 .paper-foot span{font-size:.69rem;color:#665b4c}
 a{color:inherit;text-underline-offset:5px}a:hover{color:#70552c}a:focus-visible{outline:2px solid #60869a;outline-offset:5px}
 .tool-papers{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin:65px 0 35px}
 .tool-paper{padding:23px 24px;display:flex;gap:18px;align-items:center;background:#f8f1e2;transform:rotate(-1deg)}
 .tool-paper:nth-child(2){transform:rotate(1deg)}
 .tool-paper:hover,.tool-paper:focus-within{transform:translateY(-3px)}
 .tool-paper h3{font-size:1.5rem;margin:0 0 8px}.tool-paper p{font-size:.7rem;line-height:1.65;color:#665b4c;margin:0}.tool-link{font-size:.75rem;white-space:nowrap}
 .all-projects{display:block;width:fit-content;margin:auto;font-size:.9rem;padding:10px 0}
 .scroll-cue{position:absolute;bottom:22px;left:50%;color:#79613e}.scroll-cue svg{width:22px;height:32px;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
 @media(prefers-reduced-motion:no-preference){.arriving{animation:settle 750ms cubic-bezier(.16,1,.3,1) both}.hr-paper.arriving{animation-delay:100ms}@keyframes settle{from{translate:0 24px;filter:blur(2px)}to{translate:0 0;filter:blur(0)}}}
 @media(max-width:950px){.desk-stage{padding-left:175px;padding-right:40px}.case-papers{gap:24px}.preview img{height:185px}.project-copy{padding-left:4px;padding-right:4px}.tool-papers{gap:20px}.tool-paper{padding:20px;display:block}.tool-link{display:inline-block;margin-top:12px}}
 @media(max-width:700px){.desk-stage{padding:190px 27px 85px}.case-papers,.tool-papers{grid-template-columns:1fr;gap:45px;max-width:440px;margin-left:auto;margin-right:auto}.hr-paper{margin-top:0}.preview img{height:auto;max-height:280px}.project-copy{padding:18px 10px 0}.tool-papers{margin-top:65px;gap:22px}.tool-paper{display:flex}.tool-link{margin:0}.desk-heading{margin-bottom:34px}}
</style>
<script>
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('arriving');observer.unobserve(entry.target)}}},{threshold:.15});
 document.querySelectorAll('#featured-work .work-paper').forEach(paper=>observer.observe(paper));
</script>
