---
import ProjectPaperDeck from './ProjectPaperDeck.astro';
---
<section class="desk-scene" id="featured-work" tabindex="-1" aria-labelledby="featured-heading">
 <div class="desk-stage">
  <div class="work-section-opening">
  <h2 id="featured-heading" class="work-section-label">Selected work</h2>
 </div>
  <ProjectPaperDeck />
  <h3 class="workbench-heading">Tools &amp; gadgets</h3>
  <div class="tool-papers" aria-label="Tools and gadgets">
   <article class="work-paper tool-paper stamp-agent">
    <div class="stamp-inner">
     <div class="stamp-top"><span>ANALYTICS / 01</span><span>10 PT</span></div>
     <img class="stamp-illustration" src="/img/analytics-agent-paper.svg" alt="" width="320" height="200" loading="lazy" decoding="async"/>
     <h3><a href="/projects/analytics-agent/">From data to a checked report</a></h3>
     <p>analytics-agent</p>
     <a class="tool-link" href="/projects/analytics-agent/" aria-label="Explore analytics-agent">Open project ↗</a>
    </div>
   </article>
   <article class="work-paper tool-paper stamp-aitell">
    <div class="stamp-inner">
     <div class="stamp-top"><span>DOCUMENT STUDIES / 02</span><span>20 PT</span></div>
     <img class="stamp-illustration" src="/img/ai-tell-paper.svg" alt="" width="320" height="200" loading="lazy" decoding="async"/>
     <h3><a href="/projects/ai-tell/">What can a document reveal?</a></h3>
     <p>ai-tell</p>
     <a class="tool-link" href="/projects/ai-tell/" aria-label="Explore ai-tell">Open project ↗</a>
    </div>
   </article>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Continue to the path so far"><span>Scroll down</span><svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><path d="M15 5c16 8 12 20 5 35m-7-9 7 10 10-6"/></svg></a>
 </div>
</section>
<style>
 .desk-scene{position:relative;margin:0;scroll-margin-top:25px;color:#302d28}
 .desk-stage{position:relative;max-width:1280px;min-height:150svh;box-sizing:border-box;margin:auto;padding:35px 80px 100px 180px}
 .desk-heading{text-align:center;margin-bottom:28px}
 h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;letter-spacing:-.025em;text-wrap:balance}
 h2{font-size:clamp(2.8rem,5vw,4rem);margin:0 0 12px;line-height:1.1}
 .desk-heading p{font-size:.93rem;color:#665b4c;margin:0;line-height:1.7}
 .case-papers{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
 .work-paper{position:relative;background:#fffaf0;box-shadow:3px 12px 25px #59472920;transition:transform 350ms cubic-bezier(.16,1,.3,1),box-shadow 350ms;}
 .customer-paper{transform:rotate(-2deg);padding:20px 20px 32px}
 .hr-paper{transform:rotate(2deg);margin-top:25px;padding:20px 20px 32px}
 .case-papers .work-paper:hover,.case-papers .work-paper:focus-within{transform:translateY(-5px) rotate(0);box-shadow:3px 18px 30px #59472928}
 .preview{display:block;background:#fffaf0}
 .preview img{display:block;width:100%;height:200px;object-fit:contain}
 .project-copy{padding:18px 12px 0}
 h3{font-size:clamp(1.8rem,2.6vw,2.25rem);line-height:1.08;margin:0 0 14px}
 h3 a{text-decoration:none;color:inherit}
 .project-copy>p{font-size:.85rem;line-height:1.75;color:#665b4c;margin:0 0 24px}
 .paper-foot{display:flex;flex-direction:column;gap:12px;font-size:.78rem}
 .paper-foot span{font-size:.69rem;color:#665b4c}
 a{color:inherit;text-underline-offset:5px}a:hover{color:#70552c}a:focus-visible{outline:2px solid #60869a;outline-offset:5px}
 .workbench-heading{font-size:2rem;text-align:center;margin:45px 0 22px}.tool-papers{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin:0 0 50px}
 .tool-paper{padding:23px 24px;display:flex;gap:18px;align-items:center;background:#f8f1e2;transform:rotate(-1deg)}
 .tool-paper:nth-child(2){transform:rotate(1deg)}
 .tool-paper:hover,.tool-paper:focus-within{transform:translateY(-3px)}
 .tool-paper h3{font-size:1.5rem;margin:0 0 8px}.tool-paper p{font-size:.7rem;line-height:1.65;color:#665b4c;margin:0}.tool-link{font-size:.75rem;white-space:nowrap}
 .all-projects{display:block;width:fit-content;margin:auto;font-size:.9rem;padding:15px 0}
 .scroll-cue{display:flex;flex-direction:column;align-items:center;gap:5px;width:fit-content;margin:28px auto 0;color:#79613e;text-decoration:none;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.1rem}.scroll-cue svg{width:22px;height:32px;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
 @media(prefers-reduced-motion:no-preference){.arriving{animation:settle 750ms cubic-bezier(.16,1,.3,1) both}.hr-paper.arriving{animation-delay:100ms}@keyframes settle{from{translate:0 24px;filter:blur(2px)}to{translate:0 0;filter:blur(0)}}}
 @media(max-width:950px){.desk-stage{padding-left:175px;padding-right:40px}.case-papers{gap:24px}.preview img{height:185px}.project-copy{padding-left:4px;padding-right:4px}.tool-papers{gap:20px}.tool-paper{padding:20px;display:block}.tool-link{display:inline-block;margin-top:12px}}
 @media(max-width:700px){.desk-stage{padding:190px 35px 110px;min-height:0}.case-papers,.tool-papers{grid-template-columns:1fr;gap:45px;max-width:440px;margin-left:auto;margin-right:auto}.hr-paper{margin-top:0}.preview img{height:auto;max-height:280px}.project-copy{padding:18px 10px 0}.workbench-heading{margin-top:95px}.tool-papers{margin-top:0;gap:28px}.tool-paper{display:flex}.tool-link{margin:0}.desk-heading{margin-bottom:34px}}
</style>
<script>
 const section=document.querySelector<HTMLElement>('#featured-work')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const items=Array.from(section.querySelectorAll<HTMLElement>('.desk-heading,.workbench,.workbench-heading,.tool-papers,.all-projects'));
 // A timed entrance stays legible even when a visitor scrolls quickly.
 const observer=new IntersectionObserver(entries=>{
  for(const entry of entries){
   if(!entry.isIntersecting)continue;
   entry.target.classList.add('revealed');
   observer.unobserve(entry.target);
  }
 },{threshold:.12,rootMargin:'0px 0px -40px 0px'});
 items.forEach((element,i)=>{
  element.style.setProperty('--reveal-delay',`${i===2?180:0}ms`);
  element.classList.add('reveal-ready');
  observer.observe(element);
 });
 const finish=()=>{if(reduced.matches)items.forEach(element=>element.classList.add('revealed'))};
 reduced.addEventListener('change',finish);finish();
</script>

<style>
@media(max-height:780px) and (min-width:951px){.desk-stage{padding-top:18px}.desk-heading{margin-bottom:18px}.customer-paper,.hr-paper{padding-bottom:22px}.hr-paper{margin-top:12px}.preview img{height:125px}.project-copy{padding-top:12px}.project-copy>p{margin-bottom:16px}.workbench-heading{margin-top:35px}.tool-paper{padding:17px 20px}}
</style>

<style>
@media(prefers-reduced-motion:no-preference){
.reveal-ready{opacity:0;translate:0 24px;transition:opacity 1100ms cubic-bezier(.22,.61,.36,1),translate 1400ms cubic-bezier(.22,.61,.36,1);transition-delay:var(--reveal-delay,0ms)}
.reveal-ready.revealed,.reveal-ready:focus-within{opacity:1;translate:0}
}
</style>

<style>
@media(min-width:701px){
.desk-stage{padding-top:25px}.desk-heading{margin-bottom:22px}.desk-heading h2{font-size:3.2rem}
.case-papers{gap:32px}.customer-paper,.hr-paper{padding:17px 18px 22px}.hr-paper{margin-top:12px}
.preview img{height:150px}.project-copy{padding:12px 8px 0}.project-copy h3{font-size:1.8rem;margin-bottom:12px}.project-copy>p{font-size:.8rem;line-height:1.6;margin-bottom:16px}.paper-foot{gap:8px}
.workbench-heading{margin:35px 0 18px;font-size:1.8rem}.tool-papers{gap:24px;margin-bottom:18px}.tool-paper{padding:16px 18px;display:flex}.tool-paper h3{font-size:1.25rem}.tool-link{margin-top:0}.all-projects{padding:10px 0}
}
@media(min-width:701px) and (max-height:780px){.desk-stage{padding-top:18px}.desk-heading h2{font-size:2.8rem}.desk-heading{margin-bottom:16px}.preview img{height:110px}.project-copy h3{font-size:1.65rem}.project-copy>p{font-size:.77rem}.workbench-heading{margin-top:28px}.tool-paper{padding:13px 16px}.tool-paper h3{font-size:1.2rem}}
</style>

<style>
/* Let the evidence lead, with the caption held to a compact footprint. */
.case-papers .preview img{height:250px}
.case-papers .project-copy{padding:14px 6px 0}
.case-papers .project-copy h3{font-size:1.65rem;line-height:1.12;margin-bottom:9px}
.case-papers .project-copy>p{font-size:.78rem;line-height:1.5;margin-bottom:12px}
.case-papers .paper-foot{gap:7px}
@media(min-width:701px) and (max-height:780px){.case-papers .preview img{height:220px}}
@media(max-width:700px){.case-papers .preview img{height:auto;max-height:340px}.case-papers .project-copy h3{font-size:1.65rem}}
</style>

<style>
.desk-stage{min-height:0;padding-top:75px;padding-bottom:70px}.all-projects{border:0;background:none;color:inherit;cursor:pointer;font:400 13px/1.5 "Söhne",system-ui,sans-serif;text-decoration:underline;text-underline-offset:5px}.workbench-heading{margin-top:42px}.tool-paper{background:#fcf9f1}.tool-papers{margin-bottom:18px}@media(max-width:700px){.desk-stage{padding:110px 30px 65px}.workbench-heading{margin-top:36px}}
</style>

<style>.desk-scene,.desk-stage{pointer-events:none}.desk-stage :global(.workbench),.tool-papers,.all-projects,.scroll-cue{pointer-events:auto}</style>

<style>
.work-section-opening{display:flex;align-items:center;justify-content:space-between;gap:44px;margin:12px 0 66px}
.work-section-opening .desk-heading{flex:1;min-width:0;margin:0;text-align:left}
.work-section-opening .works-letter{flex:0 0 300px;display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-height:206px;margin:0;padding:28px 30px 32px;border:0;background:#eeeae1 url('/img/soft-paper.svg') repeat;background-size:512px;color:#302f2b;text-align:left;text-decoration:none;transform:rotate(8deg);box-shadow:8px 18px 30px #3d37251f,2px 5px 9px #3d37250d;cursor:pointer;transition:transform 250ms ease,box-shadow 250ms ease}
.works-letter-action{display:flex;align-items:center;gap:12px;font:400 10px/1.4 'Manrope',sans-serif;letter-spacing:.06em;text-transform:uppercase}
.works-letter-action svg{width:20px;height:14px;stroke:currentColor;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}
.works-letter-title{font:500 80px/.95 'Cormorant Garamond',Georgia,serif;letter-spacing:-.035em}
.works-letter-copy{font:400 12px/1.55 'Manrope',sans-serif;max-width:210px;color:#57534b}
.work-section-opening .works-letter:hover{transform:rotate(6deg) translateY(-4px);box-shadow:10px 24px 36px #3d372526,2px 5px 9px #3d37250d}
.work-section-opening .works-letter:focus-visible{outline:2px solid #79613e;outline-offset:7px}
@media(max-width:950px){.work-section-opening{gap:28px}.work-section-opening .works-letter{flex-basis:245px;padding:25px;min-height:190px}.works-letter-title{font-size:70px}}
@media(max-width:700px){.work-section-opening{flex-direction:column-reverse;gap:48px;margin:0 0 38px}.work-section-opening .desk-heading{text-align:center}.work-section-opening .works-letter{flex-basis:auto;width:min(280px,calc(100% - 24px))}}
@media(prefers-reduced-motion:reduce){.work-section-opening .works-letter{transition:none}}
</style>
<style>
.work-section-opening{justify-content:flex-end}
.work-section-label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:700px){.work-section-opening{gap:0}}
</style>
<style>
.work-section-opening{margin:0!important;height:0;gap:0}
.workbench-heading{margin:24px 0 12px!important;font-size:24px!important;line-height:32px}
.tool-papers{gap:16px;margin-bottom:0}
.tool-paper{padding:12px 16px}
.scroll-cue{margin-top:16px}
@media(max-width:700px){.tool-papers{gap:12px}.tool-paper{padding:12px 16px}.tool-paper h3{font-size:18px;line-height:24px}.tool-paper p{font-size:11px}.workbench-heading{margin-top:20px!important}.scroll-cue{margin-top:12px}}
</style>

<style is:global>
/* Physical postage shape instead of a clipped rectangle with a dashed outline. */
body:has(.scroll-artwork) #featured-work .tool-paper{
  width:166px;min-height:218px;max-width:calc(100vw - 28px);
  padding:10px;box-sizing:border-box;display:block;overflow:hidden;
  clip-path:none;
  -webkit-mask:url('/img/postage-edge-mask.svg') center/100% 100% no-repeat;
  mask:url('/img/postage-edge-mask.svg') center/100% 100% no-repeat;
  box-shadow:none;filter:drop-shadow(4px 8px 8px #51433329);
  outline:none;background:#e6ebdf;
}
body:has(.scroll-artwork) #featured-work .tool-paper:nth-child(2){background:#e9dcd0}
body:has(.scroll-artwork) #featured-work .tool-paper .stamp-inner{
  height:198px;min-height:0;box-sizing:border-box;border:1px solid #85796689;
  padding:9px 9px 10px;display:flex;flex-direction:column;align-items:center;
  text-align:center;justify-content:flex-start;gap:3px;
}
body:has(.scroll-artwork) #featured-work .stamp-top{width:100%;display:flex;justify-content:space-between;gap:3px;text-align:left;font:600 7px/1.35 system-ui,sans-serif;letter-spacing:.08em;color:#5c655b}
body:has(.scroll-artwork) #featured-work .stamp-aitell .stamp-top{color:#75594b}
body:has(.scroll-artwork) #featured-work .stamp-illustration{display:block;width:94px;height:61px;max-width:100%;object-fit:contain;mix-blend-mode:multiply;margin:5px auto 2px}
body:has(.scroll-artwork) #featured-work .tool-paper h3{font:500 16px/1.1 'Zodiak',Georgia,serif;margin:0;max-width:136px}
body:has(.scroll-artwork) #featured-work .tool-paper h3 a{display:block}
body:has(.scroll-artwork) #featured-work .tool-paper p{display:block;font:400 9px/1.4 system-ui,sans-serif;color:#62584c;margin:2px 0 0}
body:has(.scroll-artwork) #featured-work .tool-paper .tool-link{display:block;font:500 10px/1.2 'Zodiak',Georgia,serif;margin:auto 0 0;text-decoration:underline;text-underline-offset:3px}
body:has(.scroll-artwork) #featured-work .tool-paper:focus-within{filter:drop-shadow(0 0 3px #426b7d)}
@media(max-width:950px){body:has(.scroll-artwork) #featured-work .tool-paper{width:144px;min-height:196px;padding:9px}body:has(.scroll-artwork) #featured-work .tool-paper .stamp-inner{height:178px;padding:7px}body:has(.scroll-artwork) #featured-work .stamp-illustration{height:44px;width:76px}body:has(.scroll-artwork) #featured-work .tool-paper h3{font-size:13px;line-height:1.14}}
@media(max-width:700px){body:has(.scroll-artwork) #featured-work .tool-paper{width:132px;min-height:165px;padding:8px}body:has(.scroll-artwork) #featured-work .tool-paper .stamp-inner{height:149px;padding:6px}body:has(.scroll-artwork) #featured-work .stamp-illustration{height:34px;width:64px;margin:1px auto}body:has(.scroll-artwork) #featured-work .stamp-top{font-size:6px}body:has(.scroll-artwork) #featured-work .tool-paper h3{font-size:12px}body:has(.scroll-artwork) #featured-work .tool-paper p{font-size:8px}body:has(.scroll-artwork) #featured-work .tool-paper .tool-link{font-size:9px}}
@media(prefers-reduced-motion:reduce){body:has(.scroll-artwork) #featured-work .tool-paper{animation:none;transition:none}}
</style>
