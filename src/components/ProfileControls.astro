---
import { SITE } from '../data/site';
---
<aside class="profile-controls" aria-label="Profile links and preferences">
 
 <div class="profile-links"><a href={SITE.links.linkedin}>LinkedIn</a><a href={SITE.links.github}>GitHub</a><button id="resume-open" aria-haspopup="dialog" aria-controls="resume-sheet" aria-expanded="false">Résumé</button><a href={`mailto:${SITE.email}`}>Email</a></div>
 <div class="profile-preferences"><button class="pet-paper" data-lulu-toggle aria-pressed="true">Hide Lulu</button><button id="paper-sound-toggle" aria-pressed="true">Sound on</button></div>
</aside>
 <dialog id="resume-sheet" aria-labelledby="resume-title" aria-describedby="resume-help">
  <button class="close-sheet" aria-label="Close résumé">Close <small>Esc</small></button>
  <h2 id="resume-title" class="sr-only">Moaaz Magdy résumé</h2>
  <div class="resume-paper" role="img" aria-label="Moaaz Magdy résumé: education, experience, selected projects, skills and languages.">
   <div class="resume-panel resume-middle" aria-hidden="true"></div>
   <div class="resume-panel resume-bottom" aria-hidden="true"></div>
   <div class="resume-panel resume-top" aria-hidden="true"></div>
  </div>
  <a class="resume-download" href="/moaaz-magdy-resume.pdf?v=b0ba518" download="Moaaz-Magdy-Resume.pdf">Download PDF <span aria-hidden="true">↗</span></a>
  <p id="resume-help" class="sr-only">Preview of Moaaz Magdy’s résumé. Download the PDF for selectable text and links. Press Escape or click outside the paper to close.</p>
 </dialog>
<script>
 import { paperSound } from '../scripts/paper-sound';
 const sound=document.querySelector<HTMLButtonElement>('#paper-sound-toggle')!;
 function label(){const on=localStorage.getItem('workbench-sound')!=='off';sound.textContent=on?'Sound on':'Sound off';sound.setAttribute('aria-pressed',String(on))}label();
 sound.addEventListener('click',()=>{localStorage.setItem('workbench-sound',sound.getAttribute('aria-pressed')==='true'?'off':'on');label();paperSound()});
 const sheet=document.querySelector<HTMLDialogElement>('#resume-sheet')!,trigger=document.querySelector<HTMLButtonElement>('#resume-open')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');let closing=false,previousOverflow='';
 trigger.addEventListener('click',()=>{if(sheet.open)return;sheet.showModal();previousOverflow=document.body.style.overflow;document.body.style.overflow='hidden';trigger.setAttribute('aria-expanded','true');paperSound('open')});
 function close(){if(closing||!sheet.open)return;closing=true;sheet.classList.add('closing');paperSound('close');setTimeout(()=>{sheet.close();sheet.classList.remove('closing');closing=false;document.body.style.overflow=previousOverflow;trigger.setAttribute('aria-expanded','false');trigger.focus()},reduced.matches?0:480)}
 sheet.querySelector('.close-sheet')!.addEventListener('click',close);sheet.addEventListener('cancel',e=>{e.preventDefault();close()});sheet.addEventListener('click',e=>{if(e.target===sheet)close()});
 document.querySelectorAll<HTMLElement>('.paper-link').forEach(link=>{link.addEventListener('pointerenter',()=>paperSound());link.addEventListener('focus',()=>paperSound());link.addEventListener('click',()=>paperSound('open'))});
 document.querySelectorAll<HTMLElement>('.section-stop,.working-paper,.work-paper,.pyramid-toggle').forEach(el=>el.addEventListener('click',()=>paperSound()));
 document.querySelectorAll<HTMLElement>('.working-paper,.work-paper').forEach(el=>{el.addEventListener('pointerenter',()=>paperSound());el.addEventListener('focusin',()=>paperSound())});
</script>
<style is:global>
@font-face{font-family:"Departure Mono";src:url('/fonts/departure-mono.woff2') format('woff2');font-display:swap}
.profile-controls{pointer-events:none;position:fixed;z-index:21;top:185px;left:48px;display:grid;justify-items:start;gap:24px;color:#665b4d}.profile-controls button,.profile-controls a{pointer-events:auto;font:10px/15px "Departure Mono",ui-monospace,monospace;color:inherit;cursor:pointer}.profile-links{display:grid;gap:10px}.profile-links a,.profile-links button,#paper-sound-toggle{background:none;border:0;padding:0;text-decoration:none;text-transform:uppercase}.profile-links a:hover,.profile-links button:hover,#paper-sound-toggle:hover{text-decoration:underline;text-underline-offset:4px}.profile-controls .pet-paper{padding:5px 9px;border:1px solid #b8ad9866;background:#f8f3e9 url('/img/paper-fibers.svg');box-shadow:1px 3px 5px #51433312;transform:rotate(-3deg);transition:transform .2s}.pet-paper:hover{transform:rotate(2deg) translateY(-2px)}.profile-controls :focus-visible{outline:2px solid #426b7d;outline-offset:5px}
#resume-sheet{color:#302c29}#resume-sheet button,#resume-sheet a{font:12px Manrope,sans-serif;cursor:pointer}.close-sheet{border:0;background:none}.close-sheet small{margin-left:14px}.resume-download{text-decoration:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
#resume-sheet{position:fixed;inset:0;width:100vw;height:100svh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:transparent;box-shadow:none;overflow:hidden;min-height:0;perspective:1800px;animation:none}
#resume-sheet::backdrop{background:rgba(40,37,31,.57);backdrop-filter:blur(5px);animation:resume-scrim-in 500ms ease both}
#resume-sheet.closing::backdrop{animation:resume-scrim-out 480ms ease both}
.resume-paper{position:absolute;left:50%;top:50%;width:min(580px,calc((100svh - 60px)*.707),calc(100vw - 48px));aspect-ratio:595.28/841.89;transform:translate(-50%,-50%);transform-style:preserve-3d;filter:drop-shadow(0 18px 28px #17140e33);animation:resume-paper-in 750ms cubic-bezier(.16,1,.3,1) both}
.resume-panel{position:absolute;left:0;width:100%;height:33.334%;background-image:url('/img/resume-preview.png?v=b0ba518');background-size:100% 300%;background-repeat:no-repeat;backface-visibility:hidden;transform-style:preserve-3d;background-color:#fffcf5}
.resume-middle{top:33.333%;background-position:center center}.resume-top{top:0;background-position:center top;transform-origin:50% 100%;animation:resume-top-unfold 950ms cubic-bezier(.16,1,.3,1) both}.resume-bottom{top:66.666%;background-position:center bottom;transform-origin:50% 0;animation:resume-bottom-unfold 1000ms cubic-bezier(.16,1,.3,1) both}
.resume-top::after,.resume-bottom::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,#64583e20,transparent 18%);animation:resume-crease 1100ms ease both}.resume-bottom::after{background:linear-gradient(180deg,#64583e20,transparent 18%)}
#resume-sheet .close-sheet{position:absolute;top:24px;right:28px;margin:0;padding:8px 12px;color:#fffcf5;z-index:3;font-size:11px}#resume-sheet .close-sheet small{color:#eee5d5}
#resume-sheet .resume-download{position:absolute;right:32px;bottom:32px;margin:0;padding:15px 25px;border-radius:999px;background:#302c29;color:#fffcf5;font-size:11px;display:flex;gap:16px;align-items:center;box-shadow:0 5px 12px #1d180d20;animation:resume-download-in 650ms 350ms cubic-bezier(.16,1,.3,1) both;transition:background .2s,translate .2s}
#resume-sheet .resume-download:hover{background:#494236;translate:0 -3px}#resume-sheet .resume-download:focus-visible,#resume-sheet .close-sheet:focus-visible{outline-color:#fffcf5}
#resume-sheet.closing .resume-top{animation:resume-top-fold 480ms cubic-bezier(.7,0,.84,0) both}#resume-sheet.closing .resume-bottom{animation:resume-bottom-fold 480ms cubic-bezier(.7,0,.84,0) both}#resume-sheet.closing .resume-paper{animation:resume-paper-out 480ms ease both}#resume-sheet.closing .resume-download{animation:resume-download-out 250ms ease both}
@keyframes resume-top-unfold{0%{transform:rotateX(-175deg);filter:brightness(.8)}100%{transform:rotateX(0);filter:brightness(1)}}@keyframes resume-bottom-unfold{0%{transform:rotateX(175deg);filter:brightness(.8)}100%{transform:rotateX(0);filter:brightness(1)}}@keyframes resume-paper-in{from{opacity:0;transform:translate(-50%,calc(-50% + 35px)) scale(.9) rotate(-2deg)}to{opacity:1;transform:translate(-50%,-50%) scale(1) rotate(0)}}@keyframes resume-crease{from{opacity:1}to{opacity:.1}}@keyframes resume-scrim-in{from{background:rgba(40,37,31,0);backdrop-filter:blur(0)}to{background:rgba(40,37,31,.57);backdrop-filter:blur(5px)}}@keyframes resume-scrim-out{to{background:rgba(40,37,31,0);backdrop-filter:blur(0)}}@keyframes resume-download-in{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@keyframes resume-download-out{to{opacity:0;transform:translateY(12px)}}@keyframes resume-top-fold{to{transform:rotateX(-170deg)}}@keyframes resume-bottom-fold{to{transform:rotateX(170deg)}}@keyframes resume-paper-out{to{opacity:0;transform:translate(-50%,calc(-50% + 20px)) scale(.88)}}
@media(max-width:650px){.resume-paper{width:min(calc((100svh - 140px)*.707),calc(100vw - 32px));top:46%}#resume-sheet .resume-download{right:50%;translate:50% 0;bottom:20px;white-space:nowrap}#resume-sheet .resume-download:hover{translate:50% -2px}#resume-sheet .close-sheet{top:10px;right:10px}}
@media(prefers-reduced-motion:reduce){#resume-sheet::backdrop,#resume-sheet.closing::backdrop,#resume-sheet .resume-paper,#resume-sheet .resume-panel,#resume-sheet .resume-panel::after,#resume-sheet .resume-download{animation:none!important;transition:none!important}}

@media(max-width:700px){.profile-controls{top:160px;left:18px;gap:16px}.profile-controls button,.profile-controls a{font-size:9px}.profile-links{gap:6px}}
@media(prefers-reduced-motion:reduce){.profile-controls .pet-paper{transition:none}}
</style>

<style is:global>
body:has(.profile-controls){--profile-sans:"Söhne",system-ui,-apple-system,sans-serif;font-family:var(--profile-sans);font-weight:400}
.profile-controls{top:32px;right:48px;left:auto;display:flex;flex-direction:column;align-items:flex-end;gap:16px;color:#514c45}.profile-links{display:flex;align-items:center;gap:24px}.profile-controls button,.profile-controls a{font:400 12px/20px var(--profile-sans);letter-spacing:.065em;text-transform:none;white-space:nowrap}.profile-preferences{display:flex;align-items:center;gap:24px}.profile-controls .pet-paper{font:400 11px/18px var(--profile-sans);letter-spacing:.04em;transform:none;border:0;background:none;box-shadow:none;padding:0}.profile-controls .pet-paper:hover{transform:none;text-decoration:underline;text-underline-offset:4px}#paper-sound-toggle{font-size:11px}
body:has(.profile-controls) .introduction-copy,body:has(.profile-controls) .introduction-role,body:has(.profile-controls) .introduction-actions,body:has(.profile-controls) .tools-explainer,body:has(.profile-controls) .section-label{font-family:var(--profile-sans);font-weight:400}
@media(max-width:900px){.profile-controls{right:28px;top:24px}.profile-links{gap:16px}.profile-controls button,.profile-controls a{font-size:11px}}
@media(max-width:700px){.profile-controls{right:20px;left:130px;top:22px;gap:10px}.profile-links{justify-content:flex-end;flex-wrap:wrap;gap:8px 14px}.profile-preferences{gap:18px}.profile-controls button,.profile-controls a{font-size:10px;letter-spacing:.035em}}
</style>
