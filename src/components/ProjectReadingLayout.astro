---
interface Props {
  sections: ReadonlyArray<{ id: string; label: string }>;
}
const { sections } = Astro.props;
---
<div class="project-reading-layout">
  <aside class="project-contents">
    <details open>
      <summary>In this project</summary>
      <nav aria-label="Project contents">
        {sections.map(({id, label}) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </details>
  </aside>
  <div class="project-reading-body"><slot /></div>
</div>

<style>
  .project-reading-layout { min-width: 0; }
  .project-reading-body { min-width: 0; container-type: inline-size; }
  .project-reading-body :global(h2[id]) { scroll-margin-block-start: 1.5rem; }
  .project-contents {
    margin-block: 1.5rem 2rem;
    padding-block: .25rem 1.25rem;
    border-bottom: 1px solid #d8cbb6;
    color: #6b5e4a;
    font: 400 .84rem/1.6 'Zodiak', Georgia, serif;
  }
  .project-contents summary { color: #302d28; cursor: pointer; font-size: .95rem; }
  .project-contents nav { display: grid; gap: .125rem 1.25rem; padding-top: .875rem; }
  .project-contents a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    padding-block: .375rem;
    display: block;
  }
  .project-contents a:hover { color: #1d5b7a; text-decoration: underline; }
  .project-contents :is(a, summary):focus-visible { outline: 2px solid #447d90; outline-offset: 3px; }
  @media (min-width: 650px) and (max-width: 1179px) {
    .project-contents nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1180px) {
    :global(body.has-portfolio-header #main > .case-study-paper) {
      width: min(1100px, calc(100% - 56px));
      max-width: 1100px;
    }
    .project-reading-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(155px, 183px);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }
    .project-contents {
      grid-area: 1 / 2;
      position: sticky;
      top: 1.5rem;
      margin: 1.75rem 0 0;
      padding: 0 .25rem .5rem 0;
      border: 0;
      max-height: calc(100dvh - 3rem);
      overflow-y: auto;
    }
    .project-reading-body { grid-area: 1 / 1; }
  }
</style>
