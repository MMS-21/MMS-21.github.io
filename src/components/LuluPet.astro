<aside class="lulu" data-lulu aria-label="Lulu, the site cat">
 <div class="lulu-stage">
  <button class="lulu-close" type="button" aria-label="Hide Lulu">×</button>
  <button class="lulu-character" type="button" aria-label="Say hello to Lulu" title="Click to say hello. Drag to move.">
   <canvas width="192" height="208" aria-hidden="true"></canvas>
  </button>
 </div>
 <button class="lulu-show" type="button" hidden>Bring back Lulu</button>
</aside>
<script>
 import { startLulu } from '../scripts/lulu-pet';
 startLulu();
</script>
<style>
.lulu{position:fixed;left:16px;bottom:10px;z-index:45;color:#57472f}
.lulu-stage{position:relative;width:108px;height:117px;transform:translateX(var(--lulu-x,0px))}
.lulu-character{display:block;width:100%;height:100%;padding:0;border:0;background:none;cursor:grab;touch-action:none;-webkit-tap-highlight-color:transparent}
.lulu-character:active{cursor:grabbing}
canvas{display:block;width:100%;height:100%;background:url('/pets/lulu-idle.webp') center/contain no-repeat}
canvas[data-loaded]{background:none}
.lulu-close{position:absolute;right:-3px;top:-9px;z-index:1;border:1px solid #b8ac96;border-radius:50%;width:24px;height:24px;background:#fffaf0;color:inherit;font-size:17px;line-height:1;cursor:pointer;opacity:0;transition:opacity 160ms}
.lulu-stage:hover .lulu-close,.lulu-stage:focus-within .lulu-close{opacity:1}
.lulu-show{border:1px solid #b8ac96;border-radius:18px;padding:7px 11px;background:#fffaf0;color:inherit;font-family:'Cormorant Garamond',Georgia,serif;font-size:.95rem;cursor:pointer}
[hidden]{display:none!important}button:focus-visible{outline:2px solid #60869a;outline-offset:3px;border-radius:8px}
@media(max-width:700px){.lulu-stage{width:88px;height:95px}.lulu-close{opacity:1}.lulu{left:8px;bottom:8px}}
@media(prefers-reduced-motion:reduce){.lulu-close{transition:none}}
</style>
