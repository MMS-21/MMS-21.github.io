---
const {mode='heading'}=Astro.props;
---
<div class:list={['floral-accent',mode]} data-mode={mode} aria-hidden="true"><canvas></canvas></div>
<script>
 import { startFloralAccents } from '../scripts/floral-accents.js';
 startFloralAccents();
</script>
<style>
.floral-accent{position:absolute;inset:-60px -18px auto;height:200px;pointer-events:none}canvas{width:100%;height:200px}.timeline{inset:calc(50% - 100px) 0 auto;height:200px}@media(max-width:700px){.timeline{inset:-25px auto auto -55px;width:95px;height:180px}.timeline canvas{height:180px}}
</style>
