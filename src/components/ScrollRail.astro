---
const stops=[{id:'pre-hero',label:'Opening'},{id:'hero-story',label:'Introduction'},{id:'work-routine',label:'How I work'},{id:'featured-work',label:'Featured work'},{id:'about',label:'About me'},{id:'connect',label:'Get in touch'}];
---
<nav class="section-nav" aria-label="Page sections">
 {stops.map(stop=><a href={`#${stop.id}`} data-section={stop.id} class="section-stop" aria-label={`Go to ${stop.label}`}><span class="section-mark" aria-hidden="true"></span><span class="section-label">{stop.label}</span></a>)}
</nav>
<script>
 const rail=document.querySelector<HTMLElement>('.section-nav');
 if(rail){
  const links=[...rail.querySelectorAll<HTMLAnchorElement>('a')];
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  let targets:number[]=[],frame=0,timer:ReturnType<typeof setTimeout>,previous=-1;
  const clamp=(n:number)=>Math.max(0,Math.min(1,n));
  const render=()=>{
   frame=0;
   let index=0;
   while(index<targets.length-2&&scrollY>targets[index+1])index++;
   const part=clamp((scrollY-targets[index])/Math.max(1,targets[index+1]-targets[index]));
   const progress=(index+part)/(targets.length-1);
   rail.style.setProperty('--progress',String(progress));
   const nearest=targets.reduce((best,t,i)=>Math.abs(t-scrollY)<Math.abs(targets[best]-scrollY)?i:best,0);
   const arrived=Math.abs(targets[nearest]-scrollY)<24;
   rail.dataset.arrived=String(arrived);
   const current=arrived?nearest:index;
   if(current!==previous){links.forEach((link,i)=>{if(i===current)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});previous=current;}
  };
  const schedule=()=>{if(!frame)frame=requestAnimationFrame(render);};
  const measure=()=>{
   const max=Math.max(1,document.documentElement.scrollHeight-innerHeight);
   targets=links.map((link,i)=>{
    const el=document.getElementById(link.dataset.section!)!;
    if(el.id==='hero-story'||el.id==='work-routine'){
     const hero=el.closest<HTMLElement>('.scroll-hero')!;
     if(hero.dataset.animated!=='true')return el.getBoundingClientRect().top+scrollY;
     return hero.offsetTop+(hero.offsetHeight-innerHeight)*(el.id==='hero-story'?.30:.82);
    }
    // Land after the desk's paper reveals, so a section shortcut shows its content.
    const reveal=el.id==='featured-work'&&el.dataset.animated==='true'&&innerWidth>700?(el.offsetHeight-innerHeight)*.66:0;
    return i===0?0:Math.min(max,el.getBoundingClientRect().top+scrollY+reveal);
   });
   schedule();
  };
  links.forEach((link,i)=>link.addEventListener('click',event=>{
   if(!link.hash)return;
   event.preventDefault();measure();history.replaceState(null,'',link.hash);
   scrollTo({top:targets[i],behavior:reduced.matches?'instant':'smooth'});
   document.querySelector<HTMLElement>(link.hash)?.focus({preventScroll:true});
  }));
  addEventListener('scroll',()=>{
   rail.dataset.moving='true';clearTimeout(timer);
   timer=setTimeout(()=>{rail.dataset.moving='false';schedule();},850);schedule();
  },{passive:true});
  addEventListener('resize',measure,{passive:true});
  new ResizeObserver(measure).observe(document.body);
  document.fonts.ready.then(measure);measure();
  rail.dataset.ready='true';
 }
</script>
<style>
 :global(html:has(.section-nav)){scrollbar-width:none}
 :global(html:has(.section-nav)::-webkit-scrollbar){display:none}
 .section-nav{position:fixed;z-index:40;top:50%;right:24px;transform:translateY(-50%);display:flex;flex-direction:column;align-items:center;width:44px;color:#39332b}
 .section-stop{position:relative;display:flex;align-items:flex-start;justify-content:center;min-width:44px;height:20px;padding:8px 0;box-sizing:content-box;text-decoration:none;color:inherit}
 .section-mark{display:block;width:16px;height:1px;background:currentColor;transition:width 150ms cubic-bezier(.4,0,.2,1),height 150ms cubic-bezier(.4,0,.2,1),opacity 150ms ease}
 .section-stop[aria-current] .section-mark{width:24px;height:4px}
 .section-stop:hover .section-mark,.section-stop:focus-visible .section-mark{width:24px;opacity:.8}
 .section-stop:focus-visible{outline:2px solid currentColor;outline-offset:1px;border-radius:2px}
 .section-label{position:absolute;right:43px;top:1px;padding:4px 8px;white-space:nowrap;background:#fcfaf7;color:#39332b;font:11px/18px ui-monospace,SFMono-Regular,Menlo,monospace;opacity:0;transform:translateX(-4px);pointer-events:none;transition:opacity 150ms ease,transform 150ms ease}
 .section-stop:hover .section-label,.section-stop:focus-visible .section-label{opacity:1;transform:none}
 @media(min-width:768px){.section-stop{height:1px;padding:8px 0}}
 @media(max-width:767px){.section-nav{right:2px;top:50%}.section-stop{height:12px;padding:8px 0}.section-label{right:40px}}
 @media(prefers-reduced-motion:reduce){.section-mark,.section-label{transition:none}}
 @media(forced-colors:active){.section-nav{color:CanvasText}.section-mark{background:CanvasText}.section-label{background:Canvas;color:CanvasText}}
 @media print{.section-nav{display:none}}
</style>
