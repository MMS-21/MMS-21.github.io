---
import { Mascot } from 'page-mascot';
import { SITE } from '../data/site';
import PyramidIcon from './PyramidIcon.astro';
const links=[{href:'/projects/',label:'Projects'},{href:'/writing/',label:'Writing'},{href:'/about/',label:'About'},{href:'/contact/',label:'Contact'}];
---
<header class="portfolio-header">
 <div class="header-mascot"><Mascot client:idle directions="/mascots/moaaz-directions.webp" reactions="/mascots/moaaz-reactions.webp" size={72} label="Moaaz avatar" /></div>
 <a class="portfolio-name" href="/" aria-label="Moaaz Magdy — Home">{SITE.name}</a>
 <details class="portfolio-menu">
  <summary aria-label="Navigation menu"><PyramidIcon /><svg class="menu-underline" viewBox="0 0 100 9" fill="none" aria-hidden="true"><path d="M2 6Q43 0 98 4M14 8Q53 3 86 6"/></svg></summary>
  <nav aria-label="Main">{links.map(link=><a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href)?'page':undefined}>{link.label}<svg viewBox="0 0 100 9" fill="none" aria-hidden="true"><path d="M2 6Q43 0 98 4M14 8Q53 3 86 6"/></svg></a>)}</nav>
 </details>
</header>
<script>
 const menu=document.querySelector<HTMLDetailsElement>('.portfolio-menu');
 if(menu){document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});document.addEventListener('click',e=>{if(e.target instanceof Node&&!menu.contains(e.target))menu.open=false;});}
</script>
<style>
 @font-face{font-family:'Cormorant Garamond';src:url('/fonts/cormorant-garamond-medium.ttf') format('truetype');font-weight:500;font-display:swap}
 .portfolio-header{position:fixed;top:20px;left:18px;width:130px;z-index:40;display:flex;align-items:center;flex-direction:column;color:#292522}
 .header-mascot{height:64px;display:flex;align-items:center;justify-content:center}
 .portfolio-name{font-size:.9rem;font-weight:650;color:inherit;text-decoration:none;margin:8px 0 6px;text-align:center}
 .portfolio-menu{position:relative}
 summary{list-style:none;cursor:pointer;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;padding:2px 6px;border-radius:3px}
 summary::-webkit-details-marker{display:none}
 summary :global(.stepped-pyramid){width:38px;height:29px;overflow:visible;transition:transform 350ms ease,color 350ms ease}
 .menu-underline{width:40px;height:6px;stroke:#79613e;stroke-width:1.5;stroke-linecap:round;transition:transform 350ms ease}
 summary:hover :global(.stepped-pyramid),summary:focus-visible :global(.stepped-pyramid){transform:translateY(-2px) scale(1.06);color:#79613e}
 summary:hover .menu-underline{transform:scaleX(1.12)}
 nav{position:absolute;top:52px;left:0;width:175px;background:#fffaf0;padding:12px;box-shadow:2px 8px 22px #57402025;border:1px solid #e0d6c4;animation:menu-appear 300ms ease}
 nav a{position:relative;display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.45rem;font-weight:500;text-decoration:none;color:#342b20;padding:9px 15px 14px}
 nav a svg{position:absolute;left:15px;bottom:5px;width:80px;height:7px;stroke:#79613e;stroke-width:1.5;opacity:0;transition:opacity 200ms}
 nav a:hover svg,nav a[aria-current] svg,nav a:focus-visible svg{opacity:1}
 nav a:hover{color:#705832}
 a:focus-visible,summary:focus-visible{outline:2px solid #79613e;outline-offset:4px}
 :global(body.has-portfolio-header main),:global(body.has-portfolio-header .site-footer){margin-left:160px}
 @keyframes menu-appear{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
 @media(max-width:700px){.portfolio-header{position:relative;top:auto;left:auto;width:130px;margin:18px auto 10px}.portfolio-menu nav{left:50%;transform:translateX(-50%);animation:none}:global(body.has-portfolio-header main),:global(body.has-portfolio-header .site-footer){margin-left:0}:global(body.has-portfolio-header main){padding-top:1.5rem}}
 @media(prefers-reduced-motion:reduce){nav{animation:none}summary :global(.stepped-pyramid),.menu-underline{transition:none}}
</style>
