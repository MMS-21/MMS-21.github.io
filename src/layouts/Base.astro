---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  hideHeader = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — writing`}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="author" content={SITE.name} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    {
      !hideHeader && (
        <header class="site-header">
          <div class="wrap header-inner">
            <a class="brand" href="/">
              <span class="brand-name">{SITE.name}</span>
              <span class="brand-role">{SITE.role}</span>
            </a>
            <nav aria-label="Main">
              <ul>
                <li><a href="/projects/">Projects</a></li>
                <li><a href="/writing/">Writing</a></li>
                <li><a href="/about/">About</a></li>
                <li><a href="/contact/">Contact</a></li>
              </ul>
            </nav>
          </div>
        </header>
      )
    }

    <main id="main" class={hideHeader ? 'flush-top' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-name">{SITE.name} — {SITE.role}, {SITE.location}</p>
        <ul class="footer-links">
          <li><a href={SITE.links.github} rel="me noopener">GitHub</a></li>
          <li><a href={SITE.links.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href={SITE.links.kaggle} rel="me noopener">Kaggle</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
        <p class="footer-note">
          Built with Astro. No tracking, no cookies.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Self-hosted Manrope variable font. Preloaded in <head> so it starts
     downloading before the stylesheet is parsed. swap avoids invisible text
     if the file is slow; the system stack in font-family covers the gap. */
  @font-face {
    font-family: "Manrope";
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url("/fonts/manrope-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
      U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
      U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    /* Warm "sugary white" palette — light mode only, on purpose. No
       prefers-color-scheme override: an OS in dark mode still renders light. */
    --bg: #fcfaf7;
    --fg: #1c1917;
    --muted: #6e655c;
    --border: #e9e2d8;
    --btn-border: #8f7f6e;
    --accent: #1d5b7a;
    --accent-soft: #f2ede4;
    --code-bg: #f5f1ea;
    --max: 46rem;
    --measure: 38rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    /* Self-hosted Manrope (variable, weights 400-800 in one 24 KB file).
       Loaded locally rather than from Google's CDN so no visitor data leaves
       the site, which keeps the "no tracking" note in the footer honest. */
    font-family: "Manrope", ui-sans-serif, system-ui, -apple-system,
      "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  a {
    color: var(--accent);
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 5;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fg);
    line-height: 1.25;
  }

  .brand-name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .brand-role {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .site-header nav ul {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-header nav a {
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .site-header nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Typography */
  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.6em;
  }

  h1 {
    font-size: clamp(1.85rem, 5vw, 2.5rem);
  }

  h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
  }

  h3 {
    font-size: 1.1rem;
    margin-top: 1.75rem;
  }

  p {
    max-width: var(--measure);
  }

  main {
    padding: 3rem 0 4rem;
  }

  /* Headerless pages (the home hero) opt out of the top padding so the
     centred block starts closer to the top edge. */
  main.flush-top {
    padding-top: 1.5rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  /* Buttons */
  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    /* Stronger than --border: for an outlined button the border is the only
       visual cue that the element is interactive, so it needs 3:1 against the
       background to satisfy WCAG 1.4.11 (non-text contrast). */
    border: 1px solid var(--btn-border);
    color: var(--fg);
    background: var(--bg);
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    color: #fff;
  }

  /* Cards */
  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    margin-bottom: 1rem;
    background: var(--bg);
  }

  .card h3 {
    margin: 0 0 0.35rem;
  }

  .card h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--accent);
  }

  .card p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.9688rem;
  }

  .tag-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--btn-border);
    border-radius: 999px;
    color: var(--muted);
    background: var(--code-bg);
    white-space: nowrap;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  /* Prose (blog posts) */
  .prose {
    max-width: var(--measure);
  }

  .prose h2 {
    margin-top: 2.75rem;
    padding-top: 0.25rem;
  }

  .prose ul,
  .prose ol {
    max-width: var(--measure);
    padding-left: 1.35rem;
  }

  .prose li {
    margin-bottom: 0.4rem;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }

  .prose pre {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .prose :not(pre) > code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.875em;
  }

  .post-meta {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-bottom: 2rem;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 3rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .footer-name {
    margin: 0 0 0.6rem;
    color: var(--fg);
    font-weight: 550;
  }

  .footer-links {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    flex-wrap: wrap;
  }

  .footer-note {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.8;
  }

  .skip-link-list {
    list-style: none;
    padding: 0;
  }
</style>
